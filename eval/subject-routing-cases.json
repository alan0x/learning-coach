{
  "suite": "subject-routing-and-baseline",
  "version": 1,
  "purpose": "Labelled requests for the subject plugin plan (octos-learn docs/SUBJECT_EXPANSION_PLAN.md, P0). Used for the Jev subject-accuracy measurement and the live lesson baseline. expected_plugins, acceptable_plugins and review_targets are for scoring and review only and must never be sent to a model.",
  "plugins": {
    "math": "Mathematics",
    "physics": "Physics",
    "chemistry": "Chemistry",
    "biology": "Biology"
  },
  "fields": {
    "expected_plugins": "Plugins a correct route selects. An empty list means the shared tools (graphs, notes, diagrams, tables) are enough.",
    "acceptable_plugins": "Extra plugins that are not an error if also selected.",
    "expected_disposition": "generate_lesson, or clarify when the request cannot be taught without asking.",
    "request_source": "self_contained, current_image (camera) or ink_selection.",
    "image": "For camera and selection cases: what the image shows. scripts that build the live baseline render it to a PNG; the text itself is never sent as text.",
    "current_lesson": "For follow-up cases: the board's previous lesson, as Octos Learn sends it."
  },
  "math_cases_by_reference": {
    "source": "testsuite/math-natural-course-cases.json",
    "expected_plugins": ["math"],
    "ids": [
      "M01-linear-system-question", "M01-linear-system-topic",
      "M02-quadratic-translation-question", "M02-quadratic-translation-topic",
      "M03-exp-log-inverse-question", "M03-exp-log-inverse-topic",
      "M04-unit-circle-sine-question", "M04-unit-circle-sine-topic",
      "M05-pythagorean-rearrangement-question", "M05-pythagorean-rearrangement-topic",
      "M06-arc-length-question", "M06-arc-length-topic",
      "M07-euclidean-algorithm-question", "M07-euclidean-algorithm-topic",
      "M08-arithmetic-series-question", "M08-arithmetic-series-topic",
      "M09-derivative-tangent-question", "M09-derivative-tangent-topic",
      "M10-binomial-probability-question", "M10-binomial-probability-topic",
      "M11-paraboloid-section-question", "M11-paraboloid-section-topic",
      "M12-sphere-section-question", "M12-sphere-section-topic"
    ]
  },
  "cases": [
    { "id": "MA-en-01", "category": "math", "language": "en-US", "prompt": "Why do you flip the inequality sign when you multiply by a negative number?", "expected_plugins": ["math"], "review_targets": ["number line or worked example showing order reversal", "general rule stated"] },
    { "id": "MA-en-02", "category": "math", "language": "en-US", "prompt": "How do I find the slope of a line from two points?", "expected_plugins": ["math"], "review_targets": ["rise over run on a graph", "worked example with two points"] },
    { "id": "MA-en-03", "category": "math", "language": "en-US", "prompt": "Equivalent fractions", "expected_plugins": ["math"], "review_targets": ["visual model of equal parts", "multiplying top and bottom by the same number"] },
    { "id": "MA-en-04", "category": "math", "language": "en-US", "prompt": "What does the area of a rectangle have to do with multiplication?", "expected_plugins": ["math"], "review_targets": ["unit squares in rows and columns", "length times width"] },
    { "id": "MA-en-05", "category": "math", "language": "en-US", "prompt": "Explain why a negative times a negative is positive.", "expected_plugins": ["math"], "review_targets": ["pattern or number-line argument", "no circular reasoning"] },
    { "id": "MA-en-06", "category": "math", "language": "en-US", "prompt": "Mean, median and mode — when should I use each one?", "expected_plugins": ["math"], "review_targets": ["small data set", "effect of an outlier"] },

    { "id": "PH-en-01", "category": "physics", "language": "en-US", "prompt": "How does distance change over time when a car moves at a constant speed?", "expected_plugins": ["physics"], "acceptable_plugins": ["math"], "review_targets": ["distance-time graph is a straight line", "slope equals speed", "units"] },
    { "id": "PH-en-02", "category": "physics", "language": "en-US", "prompt": "Why does a heavier box need a bigger push to speed up the same amount?", "expected_plugins": ["physics"], "review_targets": ["F = m a", "same acceleration needs more force for more mass", "net force"] },
    { "id": "PH-en-03", "category": "physics", "language": "en-US", "prompt": "What forces act on a book resting on a table?", "expected_plugins": ["physics"], "review_targets": ["gravity and normal force", "balanced forces", "free-body diagram"] },
    { "id": "PH-en-04", "category": "physics", "language": "en-US", "prompt": "Why does a spring bounce back and forth?", "expected_plugins": ["physics"], "acceptable_plugins": ["math"], "review_targets": ["restoring force toward equilibrium", "inertia carries past equilibrium", "displacement over one cycle"] },
    { "id": "PH-en-05", "category": "physics", "language": "en-US", "prompt": "How does a simple circuit with a battery and a bulb work?", "expected_plugins": ["physics"], "review_targets": ["closed loop", "current flows through the bulb", "open switch stops current"] },
    { "id": "PH-en-06", "category": "physics", "language": "en-US", "prompt": "Potential and kinetic energy on a roller coaster", "expected_plugins": ["physics"], "review_targets": ["energy changes form", "total stays the same without friction"] },
    { "id": "PH-en-07", "category": "physics", "language": "en-US", "prompt": "Why do objects fall at the same rate if there's no air?", "expected_plugins": ["physics"], "review_targets": ["acceleration independent of mass", "air resistance as the difference"] },
    { "id": "PH-zh-01", "category": "physics", "language": "zh-CN", "prompt": "为什么用力推静止的箱子，箱子有时候推不动？", "expected_plugins": ["physics"], "review_targets": ["静摩擦力", "推力未超过最大静摩擦力", "受力平衡"] },
    { "id": "PH-zh-02", "category": "physics", "language": "zh-CN", "prompt": "速度和加速度有什么区别？", "expected_plugins": ["physics"], "acceptable_plugins": ["math"], "review_targets": ["速度描述位置变化快慢", "加速度描述速度变化快慢", "速度-时间图像"] },
    { "id": "PH-zh-03", "category": "physics", "language": "zh-CN", "prompt": "光的折射", "expected_plugins": ["physics"], "review_targets": ["光进入另一种介质方向改变", "法线", "生活例子"] },
    { "id": "PH-zh-04", "category": "physics", "language": "zh-CN", "prompt": "单摆的周期跟什么有关？", "expected_plugins": ["physics"], "review_targets": ["与摆长有关", "小角度时与质量和振幅无关"] },
    { "id": "PH-zh-05", "category": "physics", "language": "zh-CN", "prompt": "为什么船能浮在水面上？", "expected_plugins": ["physics"], "review_targets": ["浮力", "排开液体的重量", "浮力等于重力时漂浮"] },

    { "id": "CH-en-01", "category": "chemistry", "language": "en-US", "prompt": "What is the difference between a physical change and a chemical change?", "expected_plugins": ["chemistry"], "review_targets": ["new substance forms in a chemical change", "examples of each"] },
    { "id": "CH-en-02", "category": "chemistry", "language": "en-US", "prompt": "How do I balance the equation H2 + O2 → H2O?", "expected_plugins": ["chemistry"], "review_targets": ["count atoms on each side", "2H2 + O2 → 2H2O", "conservation of mass"] },
    { "id": "CH-en-03", "category": "chemistry", "language": "en-US", "prompt": "Why does ice melt? What happens to the water molecules?", "expected_plugins": ["chemistry"], "acceptable_plugins": ["physics"], "review_targets": ["particles gain energy", "arrangement changes from solid to liquid", "same substance"] },
    { "id": "CH-en-04", "category": "chemistry", "language": "en-US", "prompt": "Atoms, protons, neutrons and electrons", "expected_plugins": ["chemistry"], "acceptable_plugins": ["physics"], "review_targets": ["nucleus and electrons", "charges of each particle", "atomic number"] },
    { "id": "CH-en-05", "category": "chemistry", "language": "en-US", "prompt": "What makes something an acid or a base?", "expected_plugins": ["chemistry"], "review_targets": ["pH scale", "everyday examples", "neutralization"] },
    { "id": "CH-zh-01", "category": "chemistry", "language": "zh-CN", "prompt": "铁为什么会生锈？", "expected_plugins": ["chemistry"], "review_targets": ["铁与氧气和水反应", "生成新物质", "防锈方法"] },
    { "id": "CH-zh-02", "category": "chemistry", "language": "zh-CN", "prompt": "溶液的浓度怎么计算？", "expected_plugins": ["chemistry"], "acceptable_plugins": ["math"], "review_targets": ["溶质质量分数", "计算例题"] },
    { "id": "CH-zh-03", "category": "chemistry", "language": "zh-CN", "prompt": "元素周期表是怎么排列的？", "expected_plugins": ["chemistry"], "review_targets": ["按原子序数排列", "周期和族", "同族性质相似"] },
    { "id": "CH-zh-04", "category": "chemistry", "language": "zh-CN", "prompt": "分子和原子有什么区别？", "expected_plugins": ["chemistry"], "review_targets": ["分子由原子构成", "例子：水分子"] },
    { "id": "CH-zh-05", "category": "chemistry", "language": "zh-CN", "prompt": "燃烧需要什么条件", "expected_plugins": ["chemistry"], "review_targets": ["可燃物、氧气、达到着火点", "灭火原理"] },

    { "id": "BI-en-01", "category": "biology", "language": "en-US", "prompt": "How do plants make their own food?", "expected_plugins": ["biology"], "acceptable_plugins": ["chemistry"], "review_targets": ["photosynthesis inputs and outputs", "role of sunlight and chlorophyll"] },
    { "id": "BI-en-02", "category": "biology", "language": "en-US", "prompt": "What are the parts of an animal cell and what do they do?", "expected_plugins": ["biology"], "review_targets": ["nucleus, membrane, cytoplasm, mitochondria", "function of each"] },
    { "id": "BI-en-03", "category": "biology", "language": "en-US", "prompt": "Food chains and food webs", "expected_plugins": ["biology"], "review_targets": ["producers, consumers, decomposers", "energy flow direction"] },
    { "id": "BI-en-04", "category": "biology", "language": "en-US", "prompt": "How does blood travel through the heart?", "expected_plugins": ["biology"], "review_targets": ["four chambers", "lungs and body loops", "order of flow"] },
    { "id": "BI-en-05", "category": "biology", "language": "en-US", "prompt": "Why do offspring look like their parents but not exactly the same?", "expected_plugins": ["biology"], "review_targets": ["genes from both parents", "variation", "dominant and recessive at the right level"] },
    { "id": "BI-zh-01", "category": "biology", "language": "zh-CN", "prompt": "青蛙是怎么长大的？", "expected_plugins": ["biology"], "review_targets": ["卵、蝌蚪、幼蛙、成蛙", "变态发育"] },
    { "id": "BI-zh-02", "category": "biology", "language": "zh-CN", "prompt": "人体的消化过程", "expected_plugins": ["biology"], "review_targets": ["口腔、胃、小肠、大肠的顺序", "小肠是主要吸收场所"] },
    { "id": "BI-zh-03", "category": "biology", "language": "zh-CN", "prompt": "植物的根、茎、叶分别有什么作用？", "expected_plugins": ["biology"], "review_targets": ["根吸收水分和固定", "茎运输", "叶进行光合作用"] },
    { "id": "BI-zh-04", "category": "biology", "language": "zh-CN", "prompt": "为什么生病了要打疫苗？", "expected_plugins": ["biology"], "review_targets": ["免疫系统记住病原体", "疫苗不是治疗而是预防"] },

    { "id": "AM-en-01", "category": "ambiguous", "language": "en-US", "prompt": "The book.", "expected_plugins": [], "expected_disposition": "clarify", "review_targets": ["asks what the learner wants to know"] },
    { "id": "AM-en-02", "category": "ambiguous", "language": "en-US", "prompt": "Can you explain this one?", "expected_plugins": [], "expected_disposition": "clarify", "review_targets": ["asks which problem, since nothing is attached"] },
    { "id": "AM-en-03", "category": "ambiguous", "language": "en-US", "prompt": "How do I read a graph?", "expected_plugins": [], "acceptable_plugins": ["math"], "review_targets": ["axes, labels and scale", "reading a point"] },
    { "id": "AM-en-04", "category": "ambiguous", "language": "en-US", "prompt": "What is energy?", "expected_plugins": ["physics"], "acceptable_plugins": ["chemistry", "biology"], "review_targets": ["usable definition at school level", "forms of energy"] },
    { "id": "AM-en-05", "category": "ambiguous", "language": "en-US", "prompt": "Explain the water cycle.", "expected_plugins": [], "acceptable_plugins": ["chemistry", "physics"], "review_targets": ["evaporation, condensation, precipitation, collection", "drawn as a cycle"] },
    { "id": "AM-zh-01", "category": "ambiguous", "language": "zh-CN", "prompt": "比例", "expected_plugins": ["math"], "acceptable_plugins": ["chemistry"], "review_targets": ["比例的含义", "例子"] },
    { "id": "AM-zh-02", "category": "ambiguous", "language": "zh-CN", "prompt": "这个我不懂", "expected_plugins": [], "expected_disposition": "clarify", "review_targets": ["追问不懂的内容"] },
    { "id": "AM-zh-03", "category": "ambiguous", "language": "zh-CN", "prompt": "怎么做实验记录？", "expected_plugins": [], "acceptable_plugins": ["physics", "chemistry", "biology"], "review_targets": ["记录变量和数据", "表格"] },

    { "id": "MX-en-01", "category": "mixed", "language": "en-US", "prompt": "Show me how to graph the speed of a falling ball and find the slope.", "expected_plugins": ["physics", "math"], "review_targets": ["velocity-time graph", "slope is acceleration"] },
    { "id": "MX-en-02", "category": "mixed", "language": "en-US", "prompt": "How do you calculate the percentage of oxygen by mass in water?", "expected_plugins": ["chemistry", "math"], "review_targets": ["molar masses", "16/18 ≈ 89%"] },
    { "id": "MX-en-03", "category": "mixed", "language": "en-US", "prompt": "Population growth of bacteria — why is it exponential?", "expected_plugins": ["biology", "math"], "review_targets": ["doubling each generation", "exponential graph", "limits in real life"] },
    { "id": "MX-en-04", "category": "mixed", "language": "en-US", "prompt": "How does a spring's motion relate to the cosine graph?", "expected_plugins": ["physics", "math"], "review_targets": ["displacement follows cosine", "phase and period"] },
    { "id": "MX-en-05", "category": "mixed", "language": "en-US", "prompt": "Plot the temperature of water as it is heated until it boils and explain the flat part.", "expected_plugins": ["physics", "chemistry"], "acceptable_plugins": ["math"], "review_targets": ["heating curve", "plateau at boiling point", "energy goes into changing state"] },
    { "id": "MX-zh-01", "category": "mixed", "language": "zh-CN", "prompt": "用一次函数表示弹簧伸长量和拉力的关系", "expected_plugins": ["physics", "math"], "review_targets": ["胡克定律", "正比例图像", "斜率含义"] },
    { "id": "MX-zh-02", "category": "mixed", "language": "zh-CN", "prompt": "化学方程式配平和解方程有什么共同点？", "expected_plugins": ["chemistry", "math"], "review_targets": ["原子守恒列等式", "系数求解"] },
    { "id": "MX-zh-03", "category": "mixed", "language": "zh-CN", "prompt": "光合作用产生氧气的速度和光照强度的关系图怎么画？", "expected_plugins": ["biology", "math"], "acceptable_plugins": ["chemistry"], "review_targets": ["坐标轴含义", "先增后趋于稳定"] },

    { "id": "IM-01", "category": "image", "language": "en-US", "request_source": "current_image", "prompt": "Can you help me with this problem?", "image": { "kind": "printed", "content": "A 2 kg cart is pushed with a net force of 6 N. What is its acceleration?" }, "expected_plugins": ["physics"], "review_targets": ["reads the problem from the image", "a = F/m = 3 m/s²"] },
    { "id": "IM-02", "category": "image", "language": "en-US", "request_source": "current_image", "prompt": "What does this mean?", "image": { "kind": "printed", "content": "2H2 + O2 → 2H2O" }, "expected_plugins": ["chemistry"], "review_targets": ["reads the equation", "explains coefficients and conservation"] },
    { "id": "IM-03", "category": "image", "language": "zh-CN", "request_source": "current_image", "prompt": "这道题怎么做？", "image": { "kind": "printed", "content": "解方程组：2x + y = 7，x − y = 2" }, "expected_plugins": ["math"], "review_targets": ["读出方程组", "x=3, y=1"] },
    { "id": "IM-04", "category": "image", "language": "en-US", "request_source": "current_image", "prompt": "Explain this diagram.", "image": { "kind": "printed", "content": "Diagram labels: Sun → Grass → Rabbit → Fox" }, "expected_plugins": ["biology"], "review_targets": ["food chain", "energy flow"] },
    { "id": "IM-05", "category": "image", "language": "en-US", "request_source": "current_image", "prompt": "Help", "image": { "kind": "printed", "content": "(blurred, unreadable page)" }, "expected_plugins": [], "expected_disposition": "clarify", "review_targets": ["says the image could not be read", "asks to retake"] },
    { "id": "IM-06", "category": "image", "language": "en-US", "request_source": "ink_selection", "prompt": "Why is this true?", "image": { "kind": "handwriting", "content": "a² + b² = c²" }, "expected_plugins": ["math"], "review_targets": ["reads the selected formula", "Pythagorean theorem explanation"] },
    { "id": "IM-07", "category": "image", "language": "en-US", "request_source": "ink_selection", "prompt": "Explain this", "image": { "kind": "handwriting", "content": "F = ma" }, "expected_plugins": ["physics"], "review_targets": ["reads the selected formula", "force, mass, acceleration"] },
    { "id": "IM-08", "category": "image", "language": "zh-CN", "request_source": "ink_selection", "prompt": "这个是什么意思", "image": { "kind": "handwriting", "content": "6CO2 + 6H2O → C6H12O6 + 6O2" }, "expected_plugins": ["biology"], "acceptable_plugins": ["chemistry"], "review_targets": ["识别光合作用方程式", "反应物与产物"] },
    { "id": "IM-09", "category": "image", "language": "en-US", "request_source": "ink_selection", "prompt": "How do I simplify this?", "image": { "kind": "handwriting", "content": "12/18" }, "expected_plugins": ["math"], "review_targets": ["2/3", "greatest common factor"] },
    { "id": "IM-10", "category": "image", "language": "zh-CN", "request_source": "current_image", "prompt": "讲讲这个", "image": { "kind": "printed", "content": "细胞结构示意图：细胞膜、细胞核、细胞质、线粒体" }, "expected_plugins": ["biology"], "review_targets": ["识别细胞结构", "各部分功能"] },

    { "id": "FU-01", "category": "follow_up", "language": "en-US", "current_lesson": "Lesson: Distance and time at constant speed. A distance-time graph d = 20t (meters, seconds) with a slider for speed. Reflection question: What would the graph look like if the car stopped for 5 seconds?", "prompt": "I don't get the reflection question.", "expected_plugins": ["physics"], "acceptable_plugins": ["math"], "review_targets": ["refers to the board's question", "flat segment while stopped"] },
    { "id": "FU-02", "category": "follow_up", "language": "en-US", "current_lesson": "Lesson: Slope of a line. y = 2x + 1 on a graph; two points A and B; slope = rise/run.", "prompt": "What if the line goes down instead?", "expected_plugins": ["math"], "review_targets": ["negative slope", "same rise-over-run idea"] },
    { "id": "FU-03", "category": "follow_up", "language": "zh-CN", "current_lesson": "课程：二元一次方程组。图像法：两条直线 2x+y=7 与 x−y=2 的交点 (3,1)。", "prompt": "刚才那个交点为什么就是答案？", "expected_plugins": ["math"], "review_targets": ["引用白板上的交点", "交点同时满足两个方程"] },
    { "id": "FU-04", "category": "follow_up", "language": "en-US", "current_lesson": "Lesson: States of matter. Particle diagrams of solid, liquid and gas water.", "prompt": "Now can you show how it relates to a graph of temperature?", "expected_plugins": ["chemistry"], "acceptable_plugins": ["physics", "math"], "review_targets": ["heating curve", "links to particle diagrams"] },
    { "id": "FU-05", "category": "follow_up", "language": "zh-CN", "current_lesson": "课程：光合作用。叶片示意图；二氧化碳 + 水 →（光）→ 葡萄糖 + 氧气。", "prompt": "那晚上植物还会这样吗？", "expected_plugins": ["biology"], "review_targets": ["夜间没有光合作用", "呼吸作用持续"] },
    { "id": "FU-06", "category": "follow_up", "language": "en-US", "current_lesson": "Lesson: Forces on a book. Free-body diagram with gravity (down) and normal force (up), balanced.", "prompt": "Teach me something about the French Revolution.", "expected_plugins": [], "review_targets": ["follows the new request, not the board", "no forced link to forces"] }
  ]
}
