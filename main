var wordsOf2 = (language) => PLACE_VALUE_COMPARE_WORDS[language] ?? PLACE_VALUE_COMPARE_WORDS["en-US"];
var nameOf = (place, language) => placeValueColumnName(place, language);
function placeValueCompareNumerals(pair, language = "en-US") {
  return [placeValueCompareNumeral(pair.a, pair.aDec, language), placeValueCompareNumeral(pair.b, pair.bDec, language)];
}
var hasAfter = (pair) => pair.stop < pair.columns.length - 1;
function placeValueCompareDoneText(pair, language = "en-US") {
  const [x, y] = placeValueCompareNumerals(pair, language);
  return wordsOf2(language).result(x, pair.relation, y, nameOf(pair.place, language), hasAfter(pair), pair.equal);
}
function placeValueCompareHowTo(raw) {
  return wordsOf2(placeValueCompareLanguage(raw)).fixedHowTo;
}
function placeValueCompareRefusalText(state, tap, language = "en-US") {
  const words2 = wordsOf2(language);
  const result = applyPlaceValueCompareTap(state, tap);
  if (result.ok)
    return "";
  const { pair } = state, reason = result.reason;
  if (reason === "demonstrating")
    return words2.refusal.demonstrating;
  if (reason === "not_decided")
    return words2.lock;
  if (reason === "not_true" || reason === "already_signed") {
    const sign = placeValueCompareSignAt(tap.place);
    const [x, y] = placeValueCompareNumerals(pair, language);
    return reason === "not_true" ? words2.refusal.not_true(x, sign, y) : placeValueCompareDoneText(pair, language);
  }
  const k = placeValueCompareTapColumn(state, tap);
  if (k < 0)
    return words2.other;
  const name = nameOf(pair.columns[k], language), a = pair.da[k], b = pair.db[k];
  switch (reason) {
    case "left_unjudged":
      return words2.refusal.left_unjudged(name, a, b, nameOf(pair.columns[state.marked], language));
    case "not_same":
    case "not_different":
    case "no_judgement":
      return words2.refusal.not_judged(name, a, b);
    case "after_decided":
      return words2.refusal.after_decided(nameOf(pair.place, language), name);
    case "already_decides":
      return words2.refusal.already_decides(name, a, b);
    case "already_same":
      return words2.refusal.already_same(name, a, b);
    default:
      return words2.other;
  }
}

// node_modules/octos-lesson-language/dist/packages/core/src/cards.js
function wholeForwardDemonstration(spec) {
  return Object.freeze({
    range: spec.range,
    next: spec.next,
    stepValues: spec.stepValues ?? ((_content, from, to) => {
      const values = [];
      for (let value = Math.floor(from + 1e-9) + 1; value <= to + 1e-9; value += 1)
        values.push(value);
      return values;
    }),
    field: spec.field,
    tapState: spec.tapState,
    shows: spec.shows,
    fresh: spec.fresh,
    ...spec.opensAtStart ? { opensAtStart: true } : {},
    start: spec.start,
    refuseStep(content, from, to) {
      if (!Number.isInteger(to))
        return `${spec.counts}: a whole number, not ${to}; from ${from}, ${spec.next(content, from)}`;
      if (to < from)
        return `${spec.counts}: it goes forward, not from ${from} back to ${to}; ${spec.next(content, from)}`;
      return void 0;
    },
    refuseReplay: (_content, value) => Number.isInteger(value) ? void 0 : `${spec.counts}: a whole number, not ${value}`,
    outside(content, value) {
      const { min, max } = spec.range(content);
      return `${spec.counts}: ${min} to ${max}, not ${value}`;
    }
  });
}
var placeName = (content, place) => {
  const places = content?.places;
  const item = Array.isArray(places) ? places[place] : void 0;
  return item?.id ?? item?.as;
};
var boundTargets = (content) => new Map((content.bindings ?? []).map((binding) => [binding.target, binding.expression.trim()]));
var BASE_TEN_TRADE_CARD = Object.freeze({
  kind: BASE_TEN_TRADE_KIND,
  taps: ["gather", "ungather", "make", "break"],
  places: BASE_TEN_TRADE_PLACES,
  validateContent: (raw, path, fail) => validateBaseTenTradeContent(raw, path, fail),
  state: baseTenMat,
  apply: (mat, tap) => {
    const result = applyBaseTenTap(mat, tap);
    return result.ok ? { ok: true, state: result.mat } : result;
  },
  refusalText: (reason, place, language) => baseTenRefusalText(reason, place, language),
  language: baseTenLanguage,
  changes: baseTenChanges,
  tapFields(content) {
    const columns = content?.columns === 3 ? 3 : 2;
    const fields = [];
    for (let p = 0; p < columns; p += 1) {
      fields.push({ place: p, field: "count", min: 0, max: columns === 2 && p === 1 ? 9 : BASE_TEN_TRADE_LIMITS.drawn[p] });
      if (hasTray(columns, p))
        fields.push({ place: p, field: "tray", min: 0, max: BASE_TEN_TRADE_LIMITS.tray });
    }
    return fields;
  },
  fieldTarget: (content, place, field) => `${placeName(content, place)}.${field}`,
  contentAt(content, value) {
    const at = structuredClone(content);
    delete at.bindings;
    for (const [p, place] of (Array.isArray(at.places) ? at.places : []).entries()) {
      for (const field of ["count", "tray"]) {
        const v = value(`${placeName(content, p)}.${field}`);
        if (v !== void 0)
          place[field] = v;
      }
    }
    return at;
  },
  facts: Object.freeze({
    /** Every place below the highest is under ten. */
    no_trade_left: {
      keys: [],
      read: (_completion, mat) => {
        const actual = baseTenFacts(mat).no_trade_left ? 1 : 0;
        return { actual, target: 1, succeeded: actual === 1 };
      },
      /** Trading never changes the value: the practice pile's digits, each tray empty. */
      donePile({ content, startValue }) {
        const places = Array.isArray(content.places) ? content.places : [];
        const bound = boundTargets(content);
        const columns = places.length;
        const value = places.reduce((sum, place, p) => sum + startValue(bound.get(`${place.id}.count`)) * 10 ** p, 0);
        const result = {};
        places.forEach((place, p) => {
          const count = bound.get(`${place.id}.count`);
          if (count)
            result[count] = p === columns - 1 ? Math.floor(value / 10 ** p) : Math.floor(value / 10 ** p) % 10;
          const tray = bound.get(`${place.id}.tray`);
          if (tray)
            result[tray] = 0;
        });
        return result;
      }
    },
    /** The place `at` holds exactly `value`, its tray included (amendment 5). */
    count: {
      keys: ["at", "value"],
      /**
       * A count the learner makes by tapping: a place the card has, a whole number, not met by the practice
       * pile, and reached by an exact search over the card's tap rules from that pile.
       */
      validate(completion, pile, fail) {
        const place = BASE_TEN_TRADE_PLACES.indexOf(completion.at);
        if (place < 0 || place >= pile.columns) {
          fail("at", `A count is of a place the card has: ${BASE_TEN_TRADE_PLACES.slice(0, pile.columns).join(", ")}`);
        }
        const value = completion.value;
        if (typeof value !== "number" || !Number.isInteger(value) || value < 0) {
          fail("value", "A count is a whole number");
        }
        if (pile.counts[place] === value) {
          fail("value", `The practice pile already has ${value} ${completion.at}`);
        }
        const reached = [...new Set(baseTenTapReachable(pile).map((mat) => mat.counts[place]))].sort((a, b) => a - b);
        if (!reached.includes(value)) {
          fail("value", `Tapping this pile makes ${reached.join(" or ")} ${completion.at}, never ${value}`);
        }
      },
      read: (completion, mat) => {
        const actual = mat.counts[BASE_TEN_TRADE_PLACES.indexOf(completion.at)] ?? 0;
        const target = completion.value;
        return { actual, target, succeeded: actual === target };
      },
      /**
       * The learner's own pile, as logged when they said done, laid tidy (each tray's units loose in their
       * place, so no count changes). Without a usable logged pile: the pile with that count and every tray
       * empty nearest the practice pile.
       */
      donePile({ content, completion, startValue, submitted }) {
        const places = Array.isArray(content.places) ? content.places : [];
        const bound = boundTargets(content);
        const countAlias = bound.get(`${places[BASE_TEN_TRADE_PLACES.indexOf(completion.at)]?.id}.count`);
        const usable = submitted && countAlias && submitted[countAlias] === completion.value && [...bound.values()].every((alias) => submitted[alias] !== void 0);
        if (usable && submitted) {
          const own = {};
          for (const place of places) {
            const count = bound.get(`${place.id}.count`);
            if (count)
              own[count] = submitted[count];
            const tray = bound.get(`${place.id}.tray`);
            if (tray)
              own[tray] = 0;
          }
          return own;
        }
        const start = baseTenMat({ ...content, places: places.map((place) => ({ ...place, count: startValue(bound.get(`${place.id}.count`)), tray: startValue(bound.get(`${place.id}.tray`)) })) });
        const p = BASE_TEN_TRADE_PLACES.indexOf(completion.at);
        const distance = (mat) => mat.counts.reduce((sum, count, q) => sum + Math.abs(count - start.counts[q]), 0);
        const made = baseTenTapReachable(start).filter((mat) => mat.counts[p] === completion.value && mat.trays.every((tray) => tray === 0)).sort((a, b) => distance(a) - distance(b))[0];
        if (!made)
          return void 0;
        const result = {};
        places.forEach((place, q) => {
          const count = bound.get(`${place.id}.count`);
          if (count)
            result[count] = made.counts[q];
          const tray = bound.get(`${place.id}.tray`);
          if (tray)
            result[tray] = 0;
        });
        return result;
      }
    }
  })
});
var chartPlace = (content, place) => {
  const places = content?.places;
  return (Array.isArray(places) ? places : []).find((item) => item?.place === place);
};
var chartFieldTarget = (content, index, field) => {
  const place = placeValueTapPlace(index);
  const item = chartPlace(content, place);
  return `${item?.id ?? item?.as ?? PLACE_VALUE_PLACE_ALIASES[place]}.${field}`;
};
var chartContentAtPile = (content, bound, pile) => PLACE_VALUE_CHART_CARD.contentAt(content, (target) => {
  const alias = bound.get(target);
  return alias === void 0 ? void 0 : pile[alias];
});
function chartDonePile(fact) {
  return ({ content, startValue, submitted }) => {
    const bound = boundTargets(content);
    const aliases = [...bound.values()];
    const targetAlias = bound.get("target");
    const target = targetAlias ? startValue(targetAlias) : Number(content.target);
    const places = Array.isArray(content.places) ? content.places : [];
    const fits = (pile) => {
      if (targetAlias && pile[targetAlias] !== target)
        return false;
      return places.every((item) => {
        const name = item.id ?? item.as;
        const count = bound.get(`${name}.count`);
        const pulled = bound.get(`${name}.pulled`);
        const values = [count, pulled].filter((alias) => alias !== void 0).map((alias) => pile[alias]);
        if (!values.every((value) => Number.isInteger(value) && value >= 0 && value <= 9))
          return false;
        return pulled === void 0 || count !== void 0 && pile[count] + pile[pulled] === placeValueDigitAt(target, item.place);
      });
    };
    if (submitted && aliases.every((alias) => submitted[alias] !== void 0) && fits(submitted) && placeValueFacts(placeValueChartState(chartContentAtPile(content, bound, submitted)))[fact]) {
      return Object.fromEntries(aliases.map((alias) => [alias, submitted[alias]]));
    }
    const result = {};
    if (targetAlias)
      result[targetAlias] = target;
    for (const item of places) {
      const name = item.id ?? item.as;
      const digit = placeValueDigitAt(target, item.place);
      const count = bound.get(`${name}.count`);
      if (count)
        result[count] = fact === "built" ? digit : 0;
      const pulled = bound.get(`${name}.pulled`);
      if (pulled)
        result[pulled] = fact === "built" ? 0 : digit;
    }
    return result;
  };
}
var chartFact = (fact, mode) => ({
  keys: [],
  validate(_completion, state, fail) {
    if (state.mode !== mode)
      fail("fact", `'${fact}' is read on a chart whose mode is '${mode}'; this chart's is '${state.mode}'`);
  },
  read: (_completion, state) => {
    const actual = placeValueFacts(state)[fact] ? 1 : 0;
    return { actual, target: 1, succeeded: actual === 1 };
  },
  donePile: chartDonePile(fact)
});
var PLACE_VALUE_CHART_CARD = Object.freeze({
  kind: PLACE_VALUE_CHART_KIND,
  taps: ["add", "remove", "take_out"],
  places: PLACE_VALUE_TAP_PLACES,
  cardFields: ["target"],
  validateContent: (raw, path, fail) => validatePlaceValueChartContent(raw, path, fail),
  state: placeValueChartState,
  apply: (state, tap) => applyPlaceValueTap(state, { tap: tap.kind, place: placeValueTapPlace(tap.place) }),
  refusalText: (reason, _place, language) => placeValueRefusalText(reason, language === "zh-CN" ? "zh-CN" : "en-US"),
  language: placeValueLanguage,
  changes: (before, after) => placeValueChanges(before, after).map(({ place, field, before: from, after: to }) => ({ place: placeValueTapIndex(place), field, before: from, after: to })),
  tapFields(content) {
    const state = placeValueChartState(content);
    return state.columns.flatMap((place) => [
      { place: placeValueTapIndex(place), field: "count", min: 0, max: 9 },
      ...state.mode === "apart" ? [{ place: placeValueTapIndex(place), field: "pulled", min: 0, max: 9 }] : []
    ]);
  },
  fieldTarget: chartFieldTarget,
  contentAt(content, value) {
    const at = structuredClone(content);
    delete at.bindings;
    for (const item of Array.isArray(at.places) ? at.places : []) {
      for (const field of at.mode === "apart" ? ["count", "pulled"] : ["count"]) {
        const v = value(`${item.id ?? item.as}.${field}`);
        if (v !== void 0)
          item[field] = v;
      }
    }
    const target = value("target");
    if (target !== void 0)
      at.target = target;
    return at;
  },
  /** A chart to build starts empty; one to pull apart starts whole, nothing pulled out. */
  validateStart(state, fail) {
    state.columns.forEach((place, i) => {
      const digit = placeValueDigitAt(state.target, place);
      if (state.mode === "build" && state.counts[i] !== 0)
        fail(`A chart to build starts empty; it has ${state.counts[i]} in place ${place}`);
      if (state.mode === "apart" && (state.counts[i] !== digit || state.pulled[i] !== 0)) {
        fail(`A chart to pull apart starts whole, nothing pulled out; place ${place} has ${state.counts[i]} on the chart and ${state.pulled[i]} pulled out, of ${digit}`);
      }
    });
  },
  facts: Object.freeze({
    /** Build: the chart holds exactly the number (each place under ten, so its digits). */
    built: chartFact("built", "build"),
    /** Pull apart: every place has been taken out. */
    pulled_all: chartFact("pulled_all", "apart")
  })
});
var TRADE_TAP_OF_REASON = Object.freeze({
