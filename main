  constructor(message, raw, violations = []) {
    super(message);
    this.raw = raw;
    this.violations = violations;
    this.name = "GeneratedLessonError";
  }
  raw;
  violations;
};
var ToolExecutionError = class extends Error {
  constructor(code, message) {
    super(message);
    this.code = code;
    this.name = "ToolExecutionError";
  }
  code;
};
