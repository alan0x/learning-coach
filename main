  }
};
function makeTenRich(sentence, problem, language = "en-US") {
  const words2 = MAKE_TEN_WORDS[language] ?? MAKE_TEN_WORDS["en-US"];
  const give = makeTenGiver(problem), keep = problem.big;
  const cap = (word) => word.charAt(0).toUpperCase() + word.slice(1);
  return sentence.split(/(\{[cK]\})/u).filter(Boolean).map((part) => {
    if (part === "{c}")
      return { word: words2.colour[give], frame: give };
    if (part === "{K}")
      return { word: cap(words2.colour[keep]), frame: keep };
    return part;
  });
}
var makeTenPlain = (rich) => rich.map((part) => typeof part === "string" ? part : part.word).join("");
function makeTenHowTo(raw) {
  const language = makeTenLanguage(raw);
  return makeTenPlain(makeTenRich(MAKE_TEN_WORDS[language].fixedHowTo, makeTenState(raw).problem, language));
}
function makeTenRefusalRich(state, reason, language = "en-US") {
  const words2 = MAKE_TEN_WORDS[language] ?? MAKE_TEN_WORDS["en-US"];
  const sentence = words2.refusal[reason] ?? words2.refusal.none;
  return makeTenRich(sentence, state.problem, language);
}
var makeTenRefusalText = (state, reason, language = "en-US") => makeTenPlain(makeTenRefusalRich(state, reason, language));

// node_modules/octos-lesson-language/dist/packages/plugin-math/src/place-value-times-ten.js
var PLACE_VALUE_TIMES_TEN_KIND = "place_value_times_ten";
var PLACE_VALUE_TIMES_TEN_FEATURE = "plugin:math/place-value-times-ten@1";
var PLACE_VALUE_TIMES_TEN_PLUGIN_VERSION = "0.11.0";
var PLACE_VALUE_TIMES_TEN_LANGUAGES = PLACE_VALUE_CHART_LANGUAGES;
var PLACE_VALUE_TIMES_TEN_MIN_PLACE = PLACE_VALUE_MIN_PLACE;
var PLACE_VALUE_TIMES_TEN_MAX_PLACE = PLACE_VALUE_MAX_PLACE;
var PLACE_VALUE_TIMES_TEN_MAX_LINEAGES = 9;
var PLACE_VALUE_TIMES_TEN_COPIES = 10;
var PLACE_VALUE_TIMES_TEN_MAX_ROWS = 2 ** PLACE_VALUE_TIMES_TEN_MAX_LINEAGES - 1;
var PLACE_VALUE_TIMES_TEN_QUESTIONS = ["count", "times"];
var PLACE_VALUE_TIMES_TEN_TOWARD = ["right", "left"];
var PLACE_VALUE_TIMES_TEN_ROW_FIELDS = ["moved_once", "moved_twice"];
var PLACE_VALUE_TIMES_TEN_CARD_BINDINGS = ["amount", "target", "counted_in"];
var PLACE_VALUE_TIMES_TEN_PROBLEM_FIELDS = ["amount", "target"];
var PLACE_VALUE_TIMES_TEN_DEMONSTRATION_FIELD = "counted_in";
var PLACE_VALUE_TIMES_TEN_TAP_PLACES = Object.freeze(Array.from({ length: PLACE_VALUE_TIMES_TEN_COPIES }, (_, i) => `row-${i + 1}`));
var PLACE_VALUE_TIMES_TEN_TAPS = ["move", "copy", "smaller"];
var SHORT2 = { "en-US": "en", "zh-CN": "zh" };
var short2 = (language) => SHORT2[language ?? "en-US"] ?? "en";
var placeValueTimesTenUnit = (place) => 10 ** (place + 3);
var unit = placeValueTimesTenUnit;
function placeValueTimesTenOneDigit(value) {
  if (!Number.isSafeInteger(value) || value <= 0)
    return void 0;
  for (let place = PLACE_VALUE_TIMES_TEN_MAX_PLACE + 3; place >= PLACE_VALUE_TIMES_TEN_MIN_PLACE; place -= 1) {
    const u = unit(place);
    if (value % u === 0) {
      const digit = value / u;
      return digit <= 9 ? { digit, place } : void 0;
    }
  }
  return void 0;
}
function placeValueTimesTenPlaceOfUnit(value) {
  const d = placeValueTimesTenOneDigit(value);
  return d && d.digit === 1 ? d.place : void 0;
}
function placeValueTimesTenProblem(amount, target, start) {
  let A = amount, T = target;
  const ok = (value) => typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
  if (!ok(A) || !ok(T) || start !== void 0 && !ok(start))
    return { fault: "unreadable" };
  let S = start;
  if (T === 10 * A) {
    [A, T] = [T, A];
    const small = placeValueTimesTenOneDigit(T), large = placeValueTimesTenOneDigit(A);
    if (S !== void 0 && small && large && S === unit(small.place))
      S = unit(large.place);
  }
  const a = placeValueTimesTenOneDigit(A);
  if (!a)
    return { fault: "not_one_digit" };
  if (a.place > PLACE_VALUE_TIMES_TEN_MAX_PLACE)
    return { fault: "out_of_range" };
  const t = placeValueTimesTenOneDigit(T);
  if (!t || t.place > PLACE_VALUE_TIMES_TEN_MAX_PLACE)
    return { fault: t ? "out_of_range" : "not_a_pair" };
  if (t.digit !== 1) {
    if (t.digit !== a.digit)
      return { fault: "not_a_pair" };
    if (t.place !== a.place - 1)
      return { fault: a.place - t.place > 1 ? "too_far" : "not_a_pair" };
    if (S !== void 0 && S !== unit(a.place))
      return { fault: "times_start" };
    return finish({ question: "times", amount: A, target: T, s: a.place, t: t.place, dir: -1, g: 1, n: a.digit, start: unit(a.place), digit: a.digit, renamed: A / unit(t.place), result: 10 });
  }
  const s = S === void 0 ? a.place : placeValueTimesTenPlaceOfUnit(S);
  if (s === void 0 || s > PLACE_VALUE_TIMES_TEN_MAX_PLACE || s < PLACE_VALUE_TIMES_TEN_MIN_PLACE)
    return { fault: "start_not_unit" };
  if (A % unit(s) !== 0)
    return { fault: "not_whole" };
  if (s === t.place)
    return { fault: "same_unit" };
  const g = Math.abs(s - t.place);
  if (g > 2)
    return { fault: "too_far" };
  const dir = t.place < s ? -1 : 1;
  if (A % T !== 0)
    return { fault: "not_whole" };
  const larger = dir < 0 ? A / unit(s) : A / T;
  if (larger > PLACE_VALUE_TIMES_TEN_MAX_LINEAGES)
    return { fault: "too_many" };
  return finish({ question: "count", amount: A, target: T, s, t: t.place, dir, g, n: larger, start: unit(s), result: A / T });
}
function finish(p) {
  const lo = Math.min(p.s, p.t), hi = Math.max(p.s, p.t);
  const columns = [];
  for (let place = hi; place >= lo; place -= 1)
    columns.push(place);
  return { ...p, columns };
}
var isFault = (p) => "fault" in p;
var placeValueTimesTenShapeOf = (p) => ({ question: p.question, toward: p.dir < 0 ? "right" : "left", apart: p.g });
function placeValueTimesTenStartUnit(shape, amount, target) {
  if (shape.question === "times") {
    const large = placeValueTimesTenOneDigit(Math.max(amount, target));
    return large ? unit(large.place) : void 0;
  }
  const t = placeValueTimesTenPlaceOfUnit(target);
  if (t === void 0)
    return void 0;
  const s = shape.toward === "right" ? t + shape.apart : t - shape.apart;
  return s >= PLACE_VALUE_TIMES_TEN_MIN_PLACE && s <= PLACE_VALUE_TIMES_TEN_MAX_PLACE ? unit(s) : void 0;
}
function placeValueTimesTenProblemOfShape(shape, amount, target) {
  const start = placeValueTimesTenStartUnit(shape, amount, target);
  if (start === void 0) {
    const other = placeValueTimesTenProblem(amount, target);
    if (!isFault(other))
      return { fault: "not_same_shape" };
    return { fault: shape.question === "times" ? other.fault : "start_not_unit" };
  }
  const p = placeValueTimesTenProblem(amount, target, shape.question === "times" ? void 0 : start);
  if (isFault(p))
    return p;
  const own = placeValueTimesTenShapeOf(p);
  if (own.question !== shape.question || own.toward !== shape.toward || own.apart !== shape.apart)
    return { fault: "not_same_shape" };
  return p;
}
var withStage = (s, i, k) => ({ problem: s.problem, stages: s.stages.map((v, j) => j === i ? k : v), ...s.rows ? { rows: s.rows } : {} });
var placeValueTimesTenPlaceAt = (p, k) => p.s + p.dir * k;
var placeValueTimesTenSizeAt = (p, k) => p.dir < 0 ? 10 ** k : 10 ** (p.g - k);
var placeAt = placeValueTimesTenPlaceAt;
var sizeAt = placeValueTimesTenSizeAt;
var placeValueTimesTenBrokenCount = (state) => state.stages.filter((k) => k >= 1).length;
var refuse2 = (reason, extra = {}) => ({ ok: false, reason, ...extra });
function placeValueTimesTenMove(state, i) {
  const p = state.problem;
  if (!Number.isInteger(i) || i < 0 || i >= p.n)
    return refuse2("no_thing");
  const k = state.stages[i];
  if (k >= p.g)
    return refuse2("at_target", { place: placeAt(p, k) });
  return { ok: true, state: withStage(state, i, k + 1), anim: { kind: p.dir < 0 ? "break" : "bundle", i, from: placeAt(p, k), to: placeAt(p, k + 1), size: sizeAt(p, k), becomes: sizeAt(p, k + 1) } };
}
function applyPlaceValueTimesTenTap(state, tap) {
  if ((state.demo ?? 0) > 0)
    return refuse2("demonstrating");
  const p = state.problem;
  if (tap.tap === "move")
    return placeValueTimesTenMove(state, tap.row);
  if (tap.tap === "copy" || tap.tap === "smaller") {
    if (p.question !== "times")
      return refuse2("not_times");
    if (tap.tap === "smaller")
      return refuse2("smaller", { need: p.digit });
    if (!Number.isInteger(tap.row) || tap.row < 0 || tap.row >= PLACE_VALUE_TIMES_TEN_COPIES)
      return refuse2("no_thing");
    const have = placeValueTimesTenBrokenCount(state);
    return refuse2(have < p.n ? "copy_short" : "copy_full", { have, need: p.digit });
  }
  return refuse2("no_tap");
}
var placeValueTimesTenComplete = (state) => state.problem.n > 0 && state.stages.every((k) => k === state.problem.g);
function placeValueTimesTenPath(problem) {
  const path = [problem.start];
  if (problem.question === "times")
    path.push(problem.target);
  else
    for (let k = 1; k <= problem.g; k += 1)
      path.push(unit(placeAt(problem, k)));
  return path;
}
function placeValueTimesTenPosition(problem, countedIn) {
  const path = placeValueTimesTenPath(problem);
  if (!Number.isFinite(countedIn))
    return 0;
  for (let k = 0; k < path.length - 1; k += 1) {
    const a = path[k], b = path[k + 1];
    const lo = Math.min(a, b), hi = Math.max(a, b);
    if (countedIn >= lo && countedIn <= hi)
      return k + (countedIn - a) / (b - a);
  }
  const down = path.at(-1) < path[0];
  return (down ? countedIn > path[0] : countedIn < path[0]) ? 0 : path.length - 1;
}
function placeValueTimesTenDemoState(problem, position) {
  const steps = placeValueTimesTenPath(problem).length - 1;
  const at = Math.min(steps, Math.max(0, Number.isFinite(position) ? position : 0));
  const whole = Math.floor(at + 1e-9), part = at - whole;
  const moved = Math.floor(part * problem.n + 1e-9);
  return { problem, stages: Array.from({ length: problem.n }, (_, i) => Math.min(problem.g, whole + (i < moved ? 1 : 0))), demo: at };
}
function placeValueTimesTenDemoValues(problem, from, to) {
  const path = placeValueTimesTenPath(problem);
  const n = Math.max(1, problem.n);
  const index = (value) => Math.floor(placeValueTimesTenPosition(problem, value) * n + 1e-6);
  const values = [];
  for (let t = index(from) + 1; t <= index(to); t += 1) {
    const k = Math.floor(t / n), r = t - k * n;
    values.push(r === 0 ? path[k] : path[k] + (path[k + 1] - path[k]) * r / n);
  }
  return values;
}
function countedInText(problem, value, language = "en-US") {
  const place = placeValueTimesTenPlaceOfUnit(value);
  if (place === void 0)
    return placeValueNumeral(value, language);
  return short2(language) === "en" ? `${placeValueNumeral(value)} (${placeValueEnUnitWord(place, true)})` : `${placeValueNumeral(value, language)}\uFF08${ZH_UNIT[place]}\uFF09`;
}
function placeValueTimesTenCountedInMeaning(problem) {
  return `is the unit the amount is counted in now, in thousandths: ${placeValueTimesTenPath(problem).map((value) => `${value} = ${countedInText(problem, value)}`).join(" -> ")}`;
}
function countedInNext(problem, from) {
  const path = placeValueTimesTenPath(problem);
  const at = placeValueTimesTenPosition(problem, from);
  const next = path.filter((value, k) => k >= Math.ceil(at - 1e-9) && value !== from);
  return next.length ? `from ${from} the next values are ${next.join(" or ")}` : `from ${from} it has reached the target, ${problem.target}`;
}
function placeValueTimesTenCountedInFault(problem, from, to) {
  const path = placeValueTimesTenPath(problem);
  const index = path.indexOf(to);
  if (index >= 0 && index + 1e-9 >= placeValueTimesTenPosition(problem, from))
    return void 0;
  const why = index < 0 ? `${to} is not one of its values` : `it goes forward, not back to ${to}`;
  return `${placeValueTimesTenCountedInMeaning(problem)}; ${why}; ${countedInNext(problem, from)}`;
}
function placeValueTimesTenCountedInReplayFault(problem, value) {
  return placeValueTimesTenPath(problem).includes(value) ? void 0 : `${placeValueTimesTenCountedInMeaning(problem)}; a replay sets one of these, not ${value}`;
}
function record5(value, path, fail) {
  if (!value || typeof value !== "object" || Array.isArray(value))
    fail(path, "Expected an object");
  return value;
}
function wholeNumber5(raw, path, low, high, fail, what) {
  if (typeof raw !== "number" || !Number.isInteger(raw) || raw < low || raw > high)
    fail(path, `${what} is a whole number from ${low} to ${high}`);
  return raw;
}
var MAX_VALUE = 9 * unit(PLACE_VALUE_TIMES_TEN_MAX_PLACE);
function placeValueTimesTenFaultText(fault, amount, target) {
  const ok = typeof amount === "number" && typeof target === "number" && Number.isSafeInteger(amount) && Number.isSafeInteger(target) && amount >= 0 && target >= 0;
  const pair = ok ? `${placeValueNumeral(amount)} and ${placeValueNumeral(target)}` : "These numbers";
  switch (fault) {
    case "not_one_digit":
      return `${pair}: the amount is one digit in one place (500 for the 5 in 5,550; 0.3 for 3 tenths), never a whole numeral (not_one_digit)`;
    case "out_of_range":
      return `${pair}: the card's places run from the millions to the thousandths (out_of_range)`;
    case "not_a_pair":
      return `${pair}: the target is a unit (0.001, 10, 100) or the same digit one place right (700 and 70) (not_a_pair)`;
    case "start_not_unit":
      return `${pair}: the unit the amount starts in is a place's unit (0.01, 10) (start_not_unit)`;
    case "same_unit":
      return `${pair}: the amount starts in the target's own unit; a put-together question starts in the smaller unit it names (40 hundredths: 0.01) (same_unit)`;
    case "too_far":
      return `${pair}: the two units are at most two places apart, and a times pair's are neighbours (too_far)`;
    case "too_many":
      return `${pair}: the larger unit holds 1 to 9 (300 tens are 30 hundreds) (too_many)`;
    case "not_whole":
      return `${pair}: the amount is a whole number of both units (4 hundredths is not a whole number of tenths) (not_whole)`;
    case "times_start":
      return `${pair}: a times pair starts in the larger number's own place (times_start)`;
    case "not_same_shape":
      return `${pair}: the card's question, direction and places apart are fixed; this pair is of another shape (not_same_shape)`;
    default:
      return "The numbers are whole numbers of thousandths from 0 to the millions (unreadable)";
  }
}
var shapeOfContent = (content) => ({
  question: content.question === "times" ? "times" : "count",
  toward: content.question === "times" ? "right" : content.toward === "left" ? "left" : "right",
  apart: content.question === "times" ? 1 : content.apart === 2 ? 2 : 1
});
function placeValueTimesTenContentProblem(raw) {
  const content = raw ?? {};
  const amount = content.amount, target = content.target;
  if (typeof amount !== "number" || typeof target !== "number")
    return { fault: "unreadable" };
  return placeValueTimesTenProblemOfShape(shapeOfContent(content), amount, target);
}
function validatePlaceValueTimesTenContent(raw, path, fail, options = {}) {
  const content = record5(raw, path, fail);
  for (const key of Object.keys(content)) {
    if (!["language", "question", "toward", "apart", "amount", "target", "counted_in", "moved_once", "moved_twice", "bindings"].includes(key))
      fail(`${path}/${key}`, `Unknown place-value times-ten field '${key}'`);
  }
  if (content.language !== void 0 && !PLACE_VALUE_TIMES_TEN_LANGUAGES.includes(content.language)) {
    fail(`${path}/language`, `The card speaks ${PLACE_VALUE_TIMES_TEN_LANGUAGES.join(" or ")}`);
  }
  if (!PLACE_VALUE_TIMES_TEN_QUESTIONS.includes(content.question))
    fail(`${path}/question`, "The question is 'count' or 'times'");
  if (!PLACE_VALUE_TIMES_TEN_TOWARD.includes(content.toward))
    fail(`${path}/toward`, "The card moves toward the 'right' (breaking) or the 'left' (putting together)");
  if (content.apart !== 1 && content.apart !== 2)
    fail(`${path}/apart`, "The two units are 1 or 2 places apart");
  if (content.question === "times" && (content.toward !== "right" || content.apart !== 1))
    fail(`${path}/apart`, "A times pair breaks toward the right, one place apart");
  const low = options.boundValues ? 0 : 1;
  const amount = wholeNumber5(content.amount, `${path}/amount`, low, MAX_VALUE, fail, "The amount (in thousandths)");
  const target = wholeNumber5(content.target, `${path}/target`, low, MAX_VALUE, fail, "The target (in thousandths)");
  const countedIn = wholeNumber5(content.counted_in, `${path}/counted_in`, low, MAX_VALUE, fail, "Counted in (in thousandths)");
  const once = wholeNumber5(content.moved_once, `${path}/moved_once`, 0, PLACE_VALUE_TIMES_TEN_MAX_ROWS, fail, "The rows moved once");
  if (content.apart === 2) {
    if (content.moved_twice === void 0)
      fail(`${path}/moved_twice`, "Two places apart, the card has the rows moved twice");
  } else if (content.moved_twice !== void 0)
    fail(`${path}/moved_twice`, "One place apart, nothing moves twice");
  const twice = content.moved_twice === void 0 ? 0 : wholeNumber5(content.moved_twice, `${path}/moved_twice`, 0, PLACE_VALUE_TIMES_TEN_MAX_ROWS, fail, "The rows moved twice");
  if (options.boundValues)
    return;
  const problem = placeValueTimesTenContentProblem(content);
  if (isFault(problem))
    fail(`${path}/${problem.fault === "not_same_shape" || problem.fault === "start_not_unit" ? "target" : "amount"}`, placeValueTimesTenFaultText(problem.fault, amount, target));
  const p = problem;
  if (p.amount !== amount)
    fail(`${path}/amount`, `A times pair is written larger first: amount ${p.amount}, target ${p.target}`);
  const rows = 2 ** p.n - 1;
  if ((once & ~rows) !== 0)
    fail(`${path}/moved_once`, `${placeValueNumeral(amount)} has ${p.n} rows: no bit past row ${p.n} (at most ${rows})`);
  if ((twice & ~once) !== 0)
    fail(`${path}/moved_twice`, "A row moves twice only after it has moved once");
  const pathValues = placeValueTimesTenPath(p);
  if (!pathValues.includes(countedIn)) {
    fail(`${path}/counted_in`, `'counted_in' ${placeValueTimesTenCountedInFault(p, p.start, countedIn) ?? `is one of ${pathValues.join(", ")}`}`);
  }
  if (countedIn !== p.start && (once !== 0 || twice !== 0)) {
    fail(`${path}/counted_in`, "A demonstration (counted in past its start) plays on a fresh chart: no row moved");
  }
}
var placeValueTimesTenLanguage = (raw) => placeValueLanguage(raw);
var FALLBACK = finish({ question: "count", amount: 0, target: 1, s: -2, t: -3, dir: -1, g: 1, n: 0, start: 10, result: 0 });
function placeValueTimesTenState(raw) {
  const content = raw ?? {};
  const found = placeValueTimesTenContentProblem(content);
  const problem = isFault(found) ? FALLBACK : found;
  const countedIn = Number(content.counted_in);
  const position = Number.isFinite(countedIn) ? placeValueTimesTenPosition(problem, countedIn) : 0;
  if (position > 0)
    return { ...placeValueTimesTenDemoState(problem, position), demo: position };
  const bits = (value, i) => typeof value === "number" && Number.isFinite(value) ? Math.floor(Math.max(0, value) / 2 ** i) % 2 : 0;
  const stages = Array.from({ length: problem.n }, (_, i) => {
    const once = bits(content.moved_once, i);
    return Math.min(problem.g, once + (once && problem.g === 2 ? bits(content.moved_twice, i) : 0));
  });
  const written = (value) => typeof value === "number" && Number.isFinite(value) ? value : 0;
  return { problem, stages, demo: 0, rows: { moved_once: written(content.moved_once), moved_twice: written(content.moved_twice) } };
}
var placeValueTimesTenRowFields = (apart) => apart === 2 ? ["moved_once", "moved_twice"] : ["moved_once"];
function placeValueTimesTenRowSets(state) {
  const mask = (bits) => bits.reduce((sum, on, i) => sum + (on ? 2 ** i : 0), 0);
  return { moved_once: mask(state.stages.map((k) => k >= 1)), moved_twice: mask(state.stages.map((k) => k >= 2)) };
}
function placeValueTimesTenChanges(before, after) {
  const a = before.rows ?? placeValueTimesTenRowSets(before), b = placeValueTimesTenRowSets(after);
  return placeValueTimesTenRowFields(after.problem.g).filter((field) => a[field] !== b[field]).map((field) => ({ field, before: a[field], after: b[field] }));
}
function placeValueTimesTenStateStartFault(state) {
  const p = state.problem;
  if ((state.demo ?? 0) > 0)
    return `A practice chart starts fresh: 'counted_in' is its own start unit, ${p.start} (${countedInText(p, p.start)}), not a value the demonstration reaches`;
  if (state.stages.some((k) => k > 0))
    return "A practice chart starts fresh: no row moved (moved_once and moved_twice are 0)";
  return void 0;
}
var ZH_UNIT = { 6: "\u767E\u4E07", 5: "\u5341\u4E07", 4: "\u4E07", 3: "\u5343", 2: "\u767E", 1: "\u5341", 0: "\u4E00", [-1]: "\u5341\u5206\u4E4B\u4E00", [-2]: "\u767E\u5206\u4E4B\u4E00", [-3]: "\u5343\u5206\u4E4B\u4E00" };
function placeValueTimesTenCountOf(n, place, language = "en-US") {
  return short2(language) === "zh" ? `${n}\u4E2A${ZH_UNIT[place]}` : `${n.toLocaleString("en-US")} ${placeValueEnUnitWord(place, n !== 1)}`;
}
var one = (place) => placeValueEnUnitWord(place, false);
var an = (place) => `${/^[aeiou]/u.test(one(place)) && place !== 0 ? "an" : "a"} ${one(place)}`;
var plural = (place) => placeValueEnUnitWord(place, true);
var aNumber = (written) => `${/^(8|11|18)(\D|$)|^8\d/u.test(written) ? "an" : "a"} ${written}`;
var PLACE_VALUE_TIMES_TEN_WORDS = {
  "en-US": {
    chartLabel: "Counting an amount in another unit on a place-value chart",
    point: "Decimal point",
    howto: {
      count: "Tap a disk to break it into ten of the column on its right, or a row of ten to put them together into one of the column on its left.",
      times: "Tap a disk of the larger number to break it into ten: one goes into each copy of the smaller number."
    },
    step: {
      breakDisk: (from, to) => `Tap ${an(from)} to break it into ten ${plural(to)}.`,
      breakRow: (from, to) => `Tap a row of ten ${plural(from)} to break it into a hundred ${plural(to)}.`,
      joinRow: (from, to) => `Tap a row of ten ${plural(from)} to put them together into one ${one(to)}.`,
      joinSquare: (from, to) => `Tap a square of a hundred ${plural(from)} to put it together into ten ${plural(to)}.`,
      deal: (from, to, B) => `Tap ${an(from)} to break it into ten ${plural(to)}, one into each ${B}.`,
      doneCount: "Type how many below.",
      doneTimes: "Type the answers below."
    },
    locked: { count: (t) => `Opens when everything is in ${plural(t)}.`, times: (B) => `Opens when every row is ${aNumber(B)}.` },
    refusal: {
      at_target: (t) => `These are ${plural(t)} already.`,
      copy_short: (have, d, t, B) => `This ${B} has ${placeValueTimesTenCountOf(have, t, "en-US")}; ${B} is ${placeValueTimesTenCountOf(d, t, "en-US")}.`,
      copy_full: (B) => `This row is one ${B}.`,
      smaller: (B, d, t) => `This is ${B}: ${placeValueTimesTenCountOf(d, t, "en-US")}.`,
      demonstrating: "This chart shows the demonstration."
    },
    other: "That can't be done here.",
    demo: {
      breakDisk: (from, to) => `Break each ${one(from)} into ten ${plural(to)}.`,
      breakRow: (from, to) => `Break every ${one(from)} into ten ${plural(to)}.`,
      joinRow: (from, to) => `Put each ten ${plural(from)} together into one ${one(to)}.`,
      joinSquare: (from, to) => `Put every ten ${plural(from)} together into one ${one(to)}.`,
      deal: (from, to, B) => `Break each ${one(from)} into ten ${plural(to)}, one into each ${B}.`
    }
  },
  "zh-CN": {
    chartLabel: "\u5728\u6570\u4F4D\u8868\u4E0A\u6362\u4E00\u4E2A\u5355\u4F4D\u6765\u6570",
    point: "\u5C0F\u6570\u70B9",
    howto: {
      count: "\u70B9\u4E00\u4E2A\u5706\u7247\uFF0C\u628A\u5B83\u62C6\u6210\u53F3\u8FB9\u4E00\u4F4D\u7684\u5341\u4E2A\uFF1B\u6216\u70B9\u4E00\u6392\u5341\u4E2A\uFF0C\u628A\u5B83\u4EEC\u5408\u6210\u5DE6\u8FB9\u4E00\u4F4D\u7684\u4E00\u4E2A\u3002",
      times: "\u70B9\u5927\u7684\u6570\u7684\u4E00\u4E2A\u5706\u7247\uFF0C\u628A\u5B83\u62C6\u6210\u5341\u4E2A\uFF1A\u6BCF\u4E00\u4E2A\u5C0F\u7684\u6570\u91CC\u653E\u4E00\u4E2A\u3002"
    },
    step: {
      breakDisk: (from, to) => `\u70B9\u4E00\u4E2A${ZH_UNIT[from]}\uFF0C\u628A\u5B83\u62C6\u6210\u5341\u4E2A${ZH_UNIT[to]}\u3002`,
      breakRow: (from, to) => `\u70B9\u4E00\u6392\u5341\u4E2A${ZH_UNIT[from]}\uFF0C\u628A\u5B83\u62C6\u6210\u4E00\u767E\u4E2A${ZH_UNIT[to]}\u3002`,
      joinRow: (from, to) => `\u70B9\u4E00\u6392\u5341\u4E2A${ZH_UNIT[from]}\uFF0C\u628A\u5B83\u4EEC\u5408\u6210\u4E00\u4E2A${ZH_UNIT[to]}\u3002`,
      joinSquare: (from, to) => `\u70B9\u4E00\u5757\u4E00\u767E\u4E2A${ZH_UNIT[from]}\uFF0C\u628A\u5B83\u5408\u6210\u5341\u4E2A${ZH_UNIT[to]}\u3002`,
      deal: (from, to, B) => `\u70B9\u4E00\u4E2A${ZH_UNIT[from]}\uFF0C\u628A\u5B83\u62C6\u6210\u5341\u4E2A${ZH_UNIT[to]}\uFF0C\u6BCF\u4E00\u4E2A ${B} \u91CC\u653E\u4E00\u4E2A\u3002`,
      doneCount: "\u5728\u4E0B\u9762\u5199\u51FA\u6709\u591A\u5C11\u4E2A\u3002",
      doneTimes: "\u5728\u4E0B\u9762\u5199\u51FA\u7B54\u6848\u3002"
    },
    locked: { count: (t) => `\u5168\u90E8\u53D8\u6210${ZH_UNIT[t]}\u540E\u624D\u80FD\u5199\u3002`, times: (B) => `\u6BCF\u4E00\u884C\u90FD\u662F ${B} \u540E\u624D\u80FD\u5199\u3002` },
    refusal: {
      at_target: (t) => `\u8FD9\u4E9B\u5DF2\u7ECF\u662F${ZH_UNIT[t]}\u4E86\u3002`,
      copy_short: (have, d, t, B) => `\u8FD9\u4E00\u4E2A ${B} \u53EA\u6709 ${have} \u4E2A${ZH_UNIT[t]}\uFF1B${B} \u662F ${d} \u4E2A${ZH_UNIT[t]}\u3002`,
      copy_full: (B) => `\u8FD9\u4E00\u884C\u662F\u4E00\u4E2A ${B}\u3002`,
      smaller: (B, d, t) => `\u8FD9\u662F ${B}\uFF1A${d} \u4E2A${ZH_UNIT[t]}\u3002`,
      demonstrating: "\u8FD9\u5F20\u8868\u662F\u6F14\u793A\u3002"
    },
    other: "\u8FD9\u91CC\u4E0D\u80FD\u8FD9\u6837\u505A\u3002",
    demo: {
      breakDisk: (from, to) => `\u628A\u6BCF\u4E2A${ZH_UNIT[from]}\u62C6\u6210\u5341\u4E2A${ZH_UNIT[to]}\u3002`,
      breakRow: (from, to) => `\u628A\u6BCF\u4E2A${ZH_UNIT[from]}\u90FD\u62C6\u6210\u5341\u4E2A${ZH_UNIT[to]}\u3002`,
      joinRow: (from, to) => `\u6BCF\u5341\u4E2A${ZH_UNIT[from]}\u5408\u6210\u4E00\u4E2A${ZH_UNIT[to]}\u3002`,
      joinSquare: (from, to) => `\u6BCF\u5341\u4E2A${ZH_UNIT[from]}\u5408\u6210\u4E00\u4E2A${ZH_UNIT[to]}\u3002`,
      deal: (from, to, B) => `\u628A\u6BCF\u4E2A${ZH_UNIT[from]}\u62C6\u6210\u5341\u4E2A${ZH_UNIT[to]}\uFF0C\u6BCF\u4E00\u4E2A ${B} \u91CC\u653E\u4E00\u4E2A\u3002`
    }
  }
};
var wordsOf = (language) => PLACE_VALUE_TIMES_TEN_WORDS[language] ?? PLACE_VALUE_TIMES_TEN_WORDS["en-US"];
function placeValueTimesTenHowTo(raw) {
  const words2 = wordsOf(placeValueTimesTenLanguage(raw));
  return raw?.question === "times" ? words2.howto.times : words2.howto.count;
}
function placeValueTimesTenAnswerParts(p, language = "en-US") {
  const en = short2(language) === "en";
  if (p.question === "count") {
    const c = p.amount / unit(p.s);
    return [{ text: `${placeValueTimesTenCountOf(c, p.s, language)} =` }, { blank: { as: "count", answer: p.result } }, { text: en ? plural(p.t) : `\u4E2A${ZH_UNIT[p.t]}` }];
  }
  const A = placeValueNumeral(p.amount, language), B = placeValueNumeral(p.target, language);
  return en ? [{ text: `${placeValueTimesTenCountOf(p.digit, p.s)} =` }, { blank: { as: "renamed", answer: p.renamed } }, { text: `${plural(p.t)};` }, { text: `${A} is` }, { blank: { as: "times", answer: 10 } }, { text: `times ${B}` }] : [{ text: `${placeValueTimesTenCountOf(p.digit, p.s, language)} =` }, { blank: { as: "renamed", answer: p.renamed } }, { text: `\u4E2A${ZH_UNIT[p.t]}\uFF1B` }, { text: `${A} \u662F ${B} \u7684` }, { blank: { as: "times", answer: 10 } }, { text: "\u500D" }];
}
function placeValueTimesTenDoneText(p, language = "en-US") {
  const en = short2(language) === "en";
  if (p.question === "count") {
    const c = p.amount / unit(p.s);
    return `\u2713 ${placeValueTimesTenCountOf(c, p.s, language)} = ${placeValueTimesTenCountOf(p.result, p.t, language)}`;
  }
  const A = placeValueNumeral(p.amount, language), B = placeValueNumeral(p.target, language), d = p.digit;
  return en ? `\u2713 ${A} = 10 \xD7 ${B}. The ${d} in ${A} is worth ten times the ${d} in ${B}; ${B} is 1/10 of ${A}.` : `\u2713 ${A} = 10 \xD7 ${B}\u3002${A} \u91CC\u7684 ${d} \u662F ${B} \u91CC\u7684 ${d} \u7684 10 \u500D\uFF1B${B} \u662F ${A} \u7684\u5341\u5206\u4E4B\u4E00\u3002`;
}
function placeValueTimesTenRefusalText(state, tap, language = "en-US") {
  const words2 = wordsOf(language), r = words2.refusal, p = state.problem;
  const result = applyPlaceValueTimesTenTap(state, tap);
  if (result.ok)
    return "";
  const B = placeValueNumeral(p.target, language);
  switch (result.reason) {
    case "at_target":
      return r.at_target(p.t);
    case "copy_short":
      return r.copy_short(result.have, result.need, p.t, B);
    case "copy_full":
      return r.copy_full(B);
    case "smaller":
      return r.smaller(B, p.digit, p.t);
    case "demonstrating":
      return r.demonstrating;
    default:
      return words2.other;
  }
}
var PLACE_VALUE_TIMES_TEN_GEOMETRY = { D: 30, G: 3, RP: 4, CP: 12, RH: 42, SQ: 106, SG: 8, NARROW: 150, POINT: 14, GAP: 8, EDGE: 12, HEAD: 34, LABEL: 22 };
var GEO = PLACE_VALUE_TIMES_TEN_GEOMETRY;
var placeValueTimesTenRowWidth = (k) => k * (GEO.D + GEO.G) - GEO.G + 2 * GEO.RP;
var ROW_W = placeValueTimesTenRowWidth(10);
var WIDE = ROW_W + 2 * GEO.CP;

// node_modules/octos-lesson-language/dist/packages/plugin-math/src/place-value-compare.js
var PLACE_VALUE_COMPARE_KIND = "place_value_compare";
var PLACE_VALUE_COMPARE_FEATURE = "plugin:math/place-value-compare@1";
var PLACE_VALUE_COMPARE_PLUGIN_VERSION = "0.12.0";
var PLACE_VALUE_COMPARE_LANGUAGES = PLACE_VALUE_CHART_LANGUAGES;
var PLACE_VALUE_COMPARE_MAX_COLUMNS = 7;
var PLACE_VALUE_COMPARE_MAX_DECIMALS = 3;
var PLACE_VALUE_COMPARE_MAX_VALUE = PLACE_VALUE_MAX_VALUE;
var PLACE_VALUE_COMPARE_CARD_BINDINGS = ["a", "b", "a_decimals", "b_decimals", "compared"];
var PLACE_VALUE_COMPARE_PROBLEM_FIELDS = ["a", "b"];
var PLACE_VALUE_COMPARE_DEMONSTRATION_FIELD = "compared";
var PLACE_VALUE_COMPARE_TAP_FIELDS = ["marked", "signed"];
var PLACE_VALUE_COMPARE_BINDINGS = [...PLACE_VALUE_COMPARE_CARD_BINDINGS, ...PLACE_VALUE_COMPARE_TAP_FIELDS];
var PLACE_VALUE_COMPARE_SIGNS = [">", "=", "<"];
var PLACE_VALUE_COMPARE_SIGN_PLACES = ["greater", "equal", "less"];
var PLACE_VALUE_COMPARE_TAP_PLACES = Object.freeze([...PLACE_VALUE_TAP_PLACES, ...PLACE_VALUE_COMPARE_SIGN_PLACES]);
var placeValueCompareSignAt = (index) => Number.isInteger(index) && index >= PLACE_VALUE_TAP_PLACES.length ? PLACE_VALUE_COMPARE_SIGNS[index - PLACE_VALUE_TAP_PLACES.length] : void 0;
var PLACE_VALUE_COMPARE_TAPS = ["same", "different", "sign", "column"];
var placeValueCompareOwnDecimals = (value) => placeValueTradeDecimals(value);
var placeValueCompareNumeral = (value, dec, language = "en-US") => placeValueTradeNumeralFixed(value, dec, language);
function placeValueCompareFault(a, b) {
  for (const n of [a, b]) {
    if (!Number.isSafeInteger(n.value) || n.value < 0 || n.value > PLACE_VALUE_COMPARE_MAX_VALUE)
      return "unreadable";
    if (!Number.isInteger(n.dec) || n.dec < placeValueCompareOwnDecimals(n.value) || n.dec > PLACE_VALUE_COMPARE_MAX_DECIMALS)
      return "decimals";
  }
  const low = -Math.max(a.dec, b.dec);
  const high = Math.max(placeValueTopPlace(a.value), placeValueTopPlace(b.value), 0);
  if (high - low + 1 > PLACE_VALUE_COMPARE_MAX_COLUMNS)
    return "too_wide";
  if (a.value === b.value && a.dec === b.dec)
    return "same_numeral";
  return void 0;
}
function placeValueComparePairOf(a, b) {
  const low = -Math.max(a.dec, b.dec);
  const high = Math.max(placeValueTopPlace(a.value), placeValueTopPlace(b.value), 0);
  const columns = [];
  for (let place = high; place >= low; place -= 1)
    columns.push(place);
  const da = columns.map((place) => placeValueDigitAt(a.value, place));
  const db = columns.map((place) => placeValueDigitAt(b.value, place));
  const first = columns.findIndex((_, k) => da[k] !== db[k]);
  const equal = first === -1;
  const stop = equal ? columns.length - 1 : first;
  const relation = equal ? "=" : da[stop] > db[stop] ? ">" : "<";
  return { a: a.value, b: b.value, aDec: a.dec, bDec: b.dec, columns, da, db, stop, place: columns[stop] ?? 0, equal, relation };
}
function placeValueCompareMakePair(a, b) {
  const fault = placeValueCompareFault(a, b);
  return fault ? { fault } : placeValueComparePairOf(a, b);
}
var placeValueCompareStart = (pair) => ({ pair, marked: 0, signed: false, compared: 0 });
var placeValueCompareDecided = (state) => !state.fault && state.pair.columns.length > 0 && state.marked === state.pair.stop + 1;
var placeValueCompareDemonstrating = (state) => state.compared > 0;
var placeValueCompareSigned = (state) => placeValueCompareDecided(state) && state.signed;
var placeValueCompareComplete = (state) => !placeValueCompareDemonstrating(state) && placeValueCompareSigned(state);
var placeValueCompareDemoEnd = (pair) => pair.stop + 2;
function placeValueCompareMove(state, move) {
  if (placeValueCompareDemonstrating(state))
    return { ok: false, reason: "demonstrating" };
  const { pair } = state;
  if (move.tap === "sign") {
    if (!PLACE_VALUE_COMPARE_SIGNS.includes(move.sign))
      return { ok: false, reason: "no_sign" };
    if (!placeValueCompareDecided(state))
      return { ok: false, reason: "not_decided" };
    if (state.signed)
      return { ok: false, reason: "already_signed" };
    if (move.sign !== pair.relation)
      return { ok: false, reason: "not_true" };
    return { ok: true, state: { ...state, signed: true }, anim: { kind: "sign", sign: move.sign } };
  }
  if (move.tap !== "same" && move.tap !== "different" && move.tap !== "column")
    return { ok: false, reason: "no_judgement" };
  const k = move.index;
  if (state.fault || !Number.isInteger(k) || k < 0 || k >= pair.columns.length)
    return { ok: false, reason: "no_place" };
  if (placeValueCompareDecided(state))
    return { ok: false, reason: k > pair.stop ? "after_decided" : k === pair.stop && !pair.equal ? "already_decides" : "already_same" };
  if (move.tap === "column")
    return { ok: false, reason: "no_judgement" };
  if (k < state.marked)
    return { ok: false, reason: "already_same" };
  if (k > state.marked)
    return { ok: false, reason: "left_unjudged" };
  const a = pair.da[k], b = pair.db[k];
  if (move.tap === "same" && a !== b)
    return { ok: false, reason: "not_same" };
  if (move.tap === "different" && a === b)
    return { ok: false, reason: "not_different" };
  const next = { ...state, marked: k + 1 };
  return { ok: true, state: next, anim: { kind: move.tap === "different" ? "decide" : "same", index: k, place: pair.columns[k], a, b, done: placeValueCompareDecided(next) } };
}
function applyPlaceValueCompareTap(state, tap) {
  if (placeValueCompareDemonstrating(state))
    return { ok: false, reason: "demonstrating" };
  if (tap.tap === "sign") {
    const sign = placeValueCompareSignAt(tap.place);
    return sign ? placeValueCompareMove(state, { tap: "sign", sign }) : { ok: false, reason: "no_sign" };
  }
  if (tap.tap !== "same" && tap.tap !== "different" && tap.tap !== "column")
    return { ok: false, reason: "no_place" };
  if (!Number.isInteger(tap.place) || tap.place < 0 || tap.place >= PLACE_VALUE_TAP_PLACES.length)
    return { ok: false, reason: "no_place" };
  const index = state.pair.columns.indexOf(placeValueTapPlace(tap.place));
  return index < 0 ? { ok: false, reason: "no_place" } : placeValueCompareMove(state, { tap: tap.tap, index });
}
var placeValueCompareTapColumn = (state, tap) => tap.tap === "sign" || !Number.isInteger(tap.place) || tap.place < 0 || tap.place >= PLACE_VALUE_TAP_PLACES.length ? -1 : state.pair.columns.indexOf(placeValueTapPlace(tap.place));
function placeValueCompareDemoSteps(pair) {
  let state = placeValueCompareStart(pair);
  const steps = [];
  for (let index = 0; index <= pair.stop; index += 1) {
    const tap = index === pair.stop && !pair.equal ? "different" : "same";
    const result = placeValueCompareMove(state, { tap, index });
    if (!result.ok)
      throw new Error(`demonstration step refused: ${result.reason}`);
    state = result.state;
    steps.push({ index, tap, anim: result.anim, after: state });
  }
  const signed = placeValueCompareMove(state, { tap: "sign", sign: pair.relation });
  if (!signed.ok)
    throw new Error(`demonstration sign refused: ${signed.reason}`);
  state = signed.state;
  steps.push({ index: pair.stop + 1, tap: "sign", anim: signed.anim, after: state });
  return { steps, final: state };
}
function placeValueCompareDemoState(pair, k) {
  const end = placeValueCompareDemoEnd(pair);
  if (!Number.isInteger(k) || k < 0 || k > end)
    throw new Error(`compared must be 0..${end}`);
  return { pair, marked: Math.min(k, pair.stop + 1), signed: k === end, compared: k };
}
function placeValueCompareComparedMeaning(pair) {
  return `counts the columns a ${PLACE_VALUE_COMPARE_KIND} card's demonstration has judged from the left, then one more for the sign: 0 to ${placeValueCompareDemoEnd(pair)} on this pair`;
}
function placeValueCompareComparedNext(pair, value) {
  const end = placeValueCompareDemoEnd(pair);
  const k = Math.max(0, Math.floor(value));
  if (k >= end)
    return `the sign is chosen at ${end}, the last value`;
  if (k === end - 1)
    return `the next value, ${end}, chooses the sign`;
  const place = pair.columns[k];
  return `the next value, ${k + 1}, judges the ${placeValueColumnName(place).toLowerCase()}`;
}
function record6(value, path, fail) {
  if (!value || typeof value !== "object" || Array.isArray(value))
    fail(path, "Expected an object");
  return value;
}
function wholeNumber6(raw, path, low, high, fail, what) {
  if (typeof raw !== "number" || !Number.isInteger(raw) || raw < low || raw > high)
    fail(path, `${what} is a whole number from ${low} to ${high}`);
  return raw;
}
function numberOf(content, field) {
  const value = Number(content[field]);
  const written = content[`${field}_decimals`];
  return { value, dec: written === void 0 ? Number.isSafeInteger(value) && value >= 0 ? placeValueCompareOwnDecimals(value) : 0 : Number(written) };
}
function placeValueCompareFaultText(fault, a, b) {
  const ok = (n) => !!n && Number.isSafeInteger(n.value) && n.value >= 0 && n.value <= PLACE_VALUE_COMPARE_MAX_VALUE && Number.isInteger(n.dec) && n.dec >= 0 && n.dec <= 3;
  const show = (n) => placeValueCompareNumeral(n.value, Math.max(n.dec, placeValueCompareOwnDecimals(n.value)));
  const pair = ok(a) && ok(b) ? `${show(a)} and ${show(b)}` : "This pair";
  switch (fault) {
    case "decimals":
      return `${pair}: a number has at most three decimals, and is written with at least the decimals it has (0.625 writes three) (decimals)`;
    case "too_wide":
      return `${pair}: the two numbers need more than seven columns (the highest place to the lowest written) (too_wide)`;
    case "same_numeral":
      return `${pair}: the same numeral twice; there is nothing to compare (0.7 and 0.70 are a pair) (same_numeral)`;
    case "same_pair":
      return `${pair}: a practice pair is not the shown pair, in either order (same_pair)`;
    default:
      return "The numbers are whole numbers of thousandths from 0 to 9,999,999.999 (unreadable)";
  }
}
function placeValueCompareContentPair(raw) {
  const content = raw ?? {};
  if (typeof content.a !== "number" || typeof content.b !== "number")
    return { fault: "unreadable" };
  return placeValueCompareMakePair(numberOf(content, "a"), numberOf(content, "b"));
}
function validatePlaceValueCompareContent(raw, path, fail, options = {}) {
  const content = record6(raw, path, fail);
  for (const key of Object.keys(content)) {
    if (!["language", ...PLACE_VALUE_COMPARE_BINDINGS, "bindings"].includes(key))
      fail(`${path}/${key}`, `Unknown place-value compare field '${key}'`);
  }
  if (content.language !== void 0 && !PLACE_VALUE_COMPARE_LANGUAGES.includes(content.language)) {
    fail(`${path}/language`, `The card speaks ${PLACE_VALUE_COMPARE_LANGUAGES.join(" or ")}`);
  }
  wholeNumber6(content.a, `${path}/a`, 0, PLACE_VALUE_COMPARE_MAX_VALUE, fail, "The first number (in thousandths)");
  wholeNumber6(content.b, `${path}/b`, 0, PLACE_VALUE_COMPARE_MAX_VALUE, fail, "The second number (in thousandths)");
  for (const field of ["a_decimals", "b_decimals"]) {
    if (content[field] !== void 0)
      wholeNumber6(content[field], `${path}/${field}`, 0, PLACE_VALUE_COMPARE_MAX_DECIMALS, fail, `The decimals the ${field === "a_decimals" ? "first" : "second"} number is written with`);
  }
  const compared = wholeNumber6(content.compared, `${path}/compared`, 0, PLACE_VALUE_COMPARE_MAX_COLUMNS + 1, fail, "Compared (the columns the demonstration judged, then the sign)");
  const marked = wholeNumber6(content.marked, `${path}/marked`, 0, PLACE_VALUE_COMPARE_MAX_COLUMNS, fail, "Marked (the columns the learner judged)");
  const signed = wholeNumber6(content.signed, `${path}/signed`, 0, 1, fail, "Signed (the true sign chosen)");
  if (options.boundValues)
    return;
  const a = numberOf(content, "a"), b = numberOf(content, "b");
  const fault = placeValueCompareFault(a, b);
  if (fault) {
    const at = fault === "decimals" ? a.dec < placeValueCompareOwnDecimals(a.value) ? "a_decimals" : "b_decimals" : "b";
    fail(`${path}/${at}`, placeValueCompareFaultText(fault, a, b));
  }
  const pair = placeValueComparePairOf(a, b);
  const end = placeValueCompareDemoEnd(pair);
  if (marked > pair.stop + 1) {
    fail(`${path}/marked`, `${placeValueCompareNumeral(a.value, a.dec)} and ${placeValueCompareNumeral(b.value, b.dec)} are decided at ${pair.stop + 1} column${pair.stop ? "s" : ""} judged; ${marked} cannot be`);
  }
  if (signed && marked !== pair.stop + 1)
    fail(`${path}/signed`, "The sign is chosen only once the comparing is done (marked is the deciding column plus one)");
  if (compared > end)
    fail(`${path}/compared`, `'compared' ${placeValueCompareComparedMeaning(pair)}, not ${compared}`);
  if (compared > 0 && (marked !== 0 || signed !== 0))
    fail(`${path}/compared`, "A demonstration (compared past 0) plays on an unjudged chart: marked and signed are 0");
  if (options.start && compared !== 0)
    fail(`${path}/compared`, `A card opens fresh: nothing compared, not ${compared}`);
  if (options.start && marked !== 0)
    fail(`${path}/marked`, `A card opens fresh: nothing judged, not ${marked}`);
  if (options.start && signed !== 0)
    fail(`${path}/signed`, "A card opens fresh: no sign chosen");
}
var placeValueCompareLanguage = (raw) => placeValueLanguage(raw);
var EMPTY_PAIR = { a: 0, b: 0, aDec: 0, bDec: 0, columns: [], da: [], db: [], stop: -1, place: 0, equal: false, relation: "=" };
function placeValueCompareState(raw) {
  const content = raw ?? {};
  const int = (value, low, high) => typeof value === "number" && Number.isFinite(value) ? Math.min(high, Math.max(low, Math.floor(value + 1e-9))) : low;
  const made = placeValueCompareContentPair(content);
  if ("fault" in made)
    return { pair: EMPTY_PAIR, fault: made.fault, marked: 0, signed: false, compared: 0 };
  const compared = int(content.compared, 0, placeValueCompareDemoEnd(made));
  if (compared > 0)
    return placeValueCompareDemoState(made, compared);
  const marked = int(content.marked, 0, made.stop + 1);
  return { pair: made, marked, signed: marked === made.stop + 1 && int(content.signed, 0, 1) === 1, compared: 0 };
}
var placeValueCompareTapValues = (state) => ({ marked: placeValueCompareDemonstrating(state) ? 0 : state.marked, signed: placeValueCompareDemonstrating(state) ? 0 : state.signed ? 1 : 0 });
function placeValueCompareChanges(before, after) {
  const from = placeValueCompareTapValues(before), to = placeValueCompareTapValues(after);
  return PLACE_VALUE_COMPARE_TAP_FIELDS.filter((field) => from[field] !== to[field]).map((field) => ({ field, before: from[field], after: to[field] }));
}
function placeValueCompareStartFault(state) {
  if (state.fault)
    return placeValueCompareFaultText(state.fault);
  if (state.compared !== 0)
    return `A practice card starts with nothing demonstrated: compared is ${state.compared}, not 0`;
  if (state.marked !== 0)
    return `A practice card starts fresh: marked is ${state.marked}, not 0`;
  if (state.signed)
    return "A practice card starts fresh: no sign chosen";
  return void 0;
}
