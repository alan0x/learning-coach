var DISK = 30;
var GAP = 4;
var PAD = 5;
var COLUMN = 2 * DISK + GAP + 2 * PAD;
var ROWS = Math.ceil(PLACE_VALUE_MAX_PER_PLACE / 2);
var BOX = 2 * PAD + ROWS * DISK + (ROWS - 1) * GAP;

// node_modules/octos-lesson-language/dist/packages/plugin-math/src/place-value-trade.js
var PLACE_VALUE_TRADE_KIND = "place_value_trade";
var PLACE_VALUE_TRADE_FEATURE = "plugin:math/place-value-trade@1";
var PLACE_VALUE_TRADE_PLUGIN_VERSION = "0.9.0";
var PLACE_VALUE_TRADE_LANGUAGES = PLACE_VALUE_CHART_LANGUAGES;
var PLACE_VALUE_TRADE_MIN_PLACE = -2;
var PLACE_VALUE_TRADE_MAX_PLACE = 5;
var PLACE_VALUE_TRADE_MAX_COLUMNS = 6;
var PLACE_VALUE_TRADE_MAX_DECIMALS = 2;
var PLACE_VALUE_TRADE_MAX_VALUE = 10 ** (PLACE_VALUE_TRADE_MAX_PLACE + 1) * 1e3 - 10;
var PLACE_VALUE_TRADE_OPERATIONS = ["add", "subtract"];
var PLACE_VALUE_TRADE_BINDINGS = { places: ["status"] };
var PLACE_VALUE_TRADE_CARD_BINDINGS = ["a", "b", "finished"];
var PLACE_VALUE_TRADE_PROBLEM_FIELDS = ["a", "b"];
var PLACE_VALUE_TRADE_TAPS = ["down", "trade", "break"];
function placeValueTradeDecimals(value) {
  const frac = value % 1e3;
  return !frac ? 0 : frac % 100 === 0 ? 1 : frac % 10 === 0 ? 2 : 3;
}
function placeValueTradeNumeralFixed(value, dec, language = "en-US") {
  const whole = Math.floor(value / 1e3), frac = value % 1e3;
  const wholeText = placeValueNumeral(whole * 1e3, language);
  return dec ? `${wholeText}.${String(frac).padStart(3, "0").slice(0, dec)}` : wholeText;
}
var placeValueTradeUnitWord = (place, language = "en-US") => placeValueUnitName(place, language);
var OP = { add: "+", subtract: "-" };
var readable = (value) => typeof value === "number" && Number.isInteger(value) && value >= 0 && value <= PLACE_VALUE_TRADE_MAX_VALUE;
function placeValueTradeColumnsFor(operation, a, b) {
  const result = operation === "add" ? a + b : Math.max(0, a - b);
  const low = 0 - Math.min(PLACE_VALUE_TRADE_MAX_DECIMALS, Math.max(placeValueTradeDecimals(a), placeValueTradeDecimals(b)));
  const top = Math.max(placeValueTopPlace(a), placeValueTopPlace(b), placeValueTopPlace(result), low);
  return { top_place: top, low_place: low };
}
function placeValueTradeColumns(topPlace, lowPlace) {
  const columns = [];
  for (let place = topPlace; place >= lowPlace; place -= 1)
    columns.push(place);
  return columns;
}
function placeValueTradeProblemOn(operation, a, b, columns) {
  const whole = (value) => Number.isFinite(value) ? Math.min(PLACE_VALUE_TRADE_MAX_VALUE, Math.max(0, Math.round(value / 10) * 10)) : 0;
  const A = whole(a), B = whole(b);
  const op = OP[operation] ?? "+";
  const da = Object.fromEntries(columns.map((place) => [place, placeValueDigitAt(A, place)]));
  const db = Object.fromEntries(columns.map((place) => [place, placeValueDigitAt(B, place)]));
  return {
    operation: op === "+" ? "add" : "subtract",
    op,
    a: A,
    b: B,
    result: op === "+" ? A + B : A - B,
    dec: Math.max(placeValueTradeDecimals(A), placeValueTradeDecimals(B)),
    columns: [...columns],
    da,
    db
  };
}
function placeValueTradeFault(operation, a, b) {
  if (!readable(a) || !readable(b) || !PLACE_VALUE_TRADE_OPERATIONS.includes(operation))
    return "unreadable";
  if (a % 10 || b % 10)
    return "decimals";
  if (operation === "subtract" && b > a)
    return "negative";
  const { top_place, low_place } = placeValueTradeColumnsFor(operation, a, b);
  if (top_place > PLACE_VALUE_TRADE_MAX_PLACE || top_place - low_place + 1 > PLACE_VALUE_TRADE_MAX_COLUMNS)
    return "too_wide";
  const problem = placeValueTradeProblemOn(operation, a, b, placeValueTradeColumns(top_place, low_place));
  const { da, db, columns } = problem;
  const trades = operation === "add" ? columns.some((p) => da[p] + db[p] >= 10) : columns.some((p) => da[p] < db[p]);
  return trades ? void 0 : "no_trade";
}
function placeValueTradeProblemText(problem, language = "en-US") {
  return `${placeValueNumeral(problem.a, language)} ${problem.op === "+" ? "+" : "\u2212"} ${placeValueNumeral(problem.b, language)}`;
}
var PLACE_VALUE_TRADE_ADD = { UP: 0, DOWN: 1, TRADED: 2 };
var PLACE_VALUE_TRADE_SUB = { TAKEN: 1, RECEIVED: 2 };
var placeValueTradeMaxStatus = (operation) => operation === "subtract" ? 3 : 2;
function placeValueTradeStart(problem) {
  return { problem, status: Object.fromEntries(problem.columns.map((p) => [p, 0])) };
}
var has = (state, place) => state.problem.columns.includes(place);
var withStatus = (state, place, value) => ({ problem: state.problem, status: { ...state.status, [place]: value } });
var isDown = (s, p) => s.status[p] >= PLACE_VALUE_TRADE_ADD.DOWN;
var isTraded = (s, p) => s.status[p] === PLACE_VALUE_TRADE_ADD.TRADED;
var carryInto = (s, p) => has(s, p - 1) && isTraded(s, p - 1) ? 1 : 0;
var placeValueTradeIsTaken = (s, p) => (s.status[p] & PLACE_VALUE_TRADE_SUB.TAKEN) !== 0;
var isTaken = placeValueTradeIsTaken;
var received = (s, p) => (s.status[p] & PLACE_VALUE_TRADE_SUB.RECEIVED) !== 0;
var gave = (s, p) => has(s, p - 1) && received(s, p - 1) ? 1 : 0;
function holds(s, p) {
  const { da, db } = s.problem;
  return da[p] + 10 * (received(s, p) ? 1 : 0) - gave(s, p) - (isTaken(s, p) ? db[p] : 0);
}
function placeValueTradeCell(state, place) {
  const { op, da, db } = state.problem;
  if (op === "+") {
    const down = isDown(state, place), c = carryInto(state, place);
    const answer = down ? da[place] + db[place] + c - (isTraded(state, place) ? 10 : 0) : 0;
    return { down, carry: down ? 0 : c, top: down ? 0 : da[place], second: down ? 0 : db[place], answer, topRing: false, answerRing: answer >= 10 };
  }
  const taken = isTaken(state, place), n = holds(state, place), ring = received(state, place) && n >= 10;
  return { down: taken, carry: 0, top: taken ? 0 : n, second: db[place], answer: taken ? n : 0, topRing: !taken && ring, answerRing: taken && ring };
}
var cell = placeValueTradeCell;
var refuse = (reason, extra = {}) => ({ ok: false, reason, ...extra });
var done = (state, anim) => ({ ok: true, state, anim });
function placeValueTradeBringDown(state, place) {
  if (state.problem.op !== "+")
    return refuse("wrong_op");
  if (!has(state, place))
    return refuse("no_place");
  if (isDown(state, place))
    return refuse("already_down");
  return done(withStatus(state, place, PLACE_VALUE_TRADE_ADD.DOWN), { kind: "down", place });
}
function placeValueTradeTradeTen(state, place) {
  if (state.problem.op !== "+")
    return refuse("wrong_op");
  if (!has(state, place))
    return refuse("no_place");
  if (!isDown(state, place))
    return refuse("not_down");
  if (cell(state, place).answer < 10)
    return refuse("not_ten");
  if (!has(state, place + 1))
    return refuse("no_left");
  return done(withStatus(state, place, PLACE_VALUE_TRADE_ADD.TRADED), { kind: "trade", from: place, to: place + 1, landed: isDown(state, place + 1) ? "answer" : "carry" });
}
function placeValueTradeWantsTen(state, place) {
  if (!has(state, place) || received(state, place))
    return false;
  if (!isTaken(state, place) && holds(state, place) < state.problem.db[place])
    return true;
  return holds(state, place) === 0 && has(state, place - 1) && placeValueTradeWantsTen(state, place - 1);
}
function placeValueTradeTakeAway(state, place) {
  if (state.problem.op !== "-")
    return refuse("wrong_op");
  if (!has(state, place))
    return refuse("no_place");
  if (isTaken(state, place))
    return refuse("already_taken");
  const n = holds(state, place), k = state.problem.db[place];
  if (n < k)
    return refuse("not_enough", { have: n, need: k });
  return done(withStatus(state, place, state.status[place] | PLACE_VALUE_TRADE_SUB.TAKEN), { kind: "take", place, n: k });
}
function placeValueTradeBreakOne(state, place) {
  if (state.problem.op !== "-")
    return refuse("wrong_op");
  if (!has(state, place))
    return refuse("no_place");
  if (holds(state, place) < 1)
    return refuse("none_to_break");
  if (!has(state, place - 1))
    return refuse("no_right");
  const right = place - 1;
  if (!placeValueTradeWantsTen(state, right)) {
    return refuse("not_needed", { right, taken: isTaken(state, right), have: holds(state, right), need: state.problem.db[right] });
  }
  return done(withStatus(state, right, state.status[right] | PLACE_VALUE_TRADE_SUB.RECEIVED), { kind: "break", from: place, to: right, landed: isTaken(state, right) ? "answer" : "top" });
}
function placeValueTradeDown(state, place) {
  return state.problem.op === "+" ? placeValueTradeBringDown(state, place) : placeValueTradeTakeAway(state, place);
}
function applyPlaceValueTradeTap(state, tap) {
  if ((state.finished ?? 0) > 0)
    return refuse("demonstrating");
  if (tap.tap === "trade" && state.problem.op === "-")
    return has(state, tap.place) && !isTaken(state, tap.place) ? refuse("not_down") : refuse("wrong_op");
  if (tap.tap === "down")
    return placeValueTradeDown(state, tap.place);
  if (tap.tap === "trade")
    return placeValueTradeTradeTen(state, tap.place);
  if (tap.tap === "break")
    return placeValueTradeBreakOne(state, tap.place);
  return refuse("wrong_op");
}
function placeValueTradeColumnFinished(state, place) {
  const c = cell(state, place);
  return c.down && c.answer <= 9;
}
function placeValueTradeComplete(state) {
  return state.problem.columns.every((p) => placeValueTradeColumnFinished(state, p));
}
function placeValueTradeMoves(state) {
  const out = [];
  for (const p of state.problem.columns) {
    const tries = state.problem.op === "+" ? [placeValueTradeBringDown(state, p), placeValueTradeTradeTen(state, p)] : [placeValueTradeTakeAway(state, p), placeValueTradeBreakOne(state, p)];
    for (const r of tries)
      if (r.ok)
        out.push(r);
  }
  return out;
}
var placeValueTradeStateKey = (state) => state.problem.columns.map((p) => state.status[p]).join("");
function placeValueTradeReachable(problem) {
  const seen = /* @__PURE__ */ new Map(), queue = [placeValueTradeStart(problem)];
  while (queue.length) {
    const s = queue.pop(), key = placeValueTradeStateKey(s);
    if (seen.has(key))
      continue;
    seen.set(key, s);
    for (const r of placeValueTradeMoves(s))
      queue.push(r.state);
  }
  return [...seen.values()];
}
var problemKey = (problem) => `${problem.op}${problem.a}:${problem.b}@${problem.columns.join(",")}`;
function placeValueTradeStartFault(state) {
  const finished = state.finished ?? 0;
  if (finished !== 0)
    return `A practice chart starts with no column demonstrated; columns finished is ${finished}`;
  for (const place of state.problem.columns) {
    if (state.status[place] !== 0)
      return `A practice chart starts fresh; the ${PLACE_VALUE_PLACE_ALIASES[place]} column's status is ${state.status[place]}`;
  }
  return void 0;
}
var DEMO_CACHE = /* @__PURE__ */ new Map();
function placeValueTradeDemoSteps(problem) {
  const key = problemKey(problem);
  const cached = DEMO_CACHE.get(key);
  if (cached)
    return cached;
  let state = placeValueTradeStart(problem);
  const steps = [];
  const apply = (result) => {
    if (!result.ok)
      throw new Error(`demo step refused: ${result.reason}`);
    state = result.state;
  };
  for (const place of [...problem.columns].reverse()) {
    const actions = [];
    const states = [];
    const act = (action, result) => {
      states.push(state);
      actions.push(action);
      apply(result());
    };
    if (problem.op === "+") {
      act({ kind: "down", place, carried: carryInto(state, place) }, () => placeValueTradeBringDown(state, place));
      if (cell(state, place).answer >= 10)
        act({ kind: "trade", place }, () => placeValueTradeTradeTen(state, place));
    } else {
      if (holds(state, place) < problem.db[place]) {
        let from = place + 1;
        while (has(state, from) && holds(state, from) === 0)
          from += 1;
        for (let p = from; p > place; p -= 1)
          act({ kind: "break", place: p }, () => placeValueTradeBreakOne(state, p));
      }
      act({ kind: "take", place }, () => placeValueTradeTakeAway(state, place));
    }
    steps.push({ place, actions, states: [...states, state], after: state });
  }
  const demo = { steps, final: state };
  if (DEMO_CACHE.size > 64)
    DEMO_CACHE.clear();
  DEMO_CACHE.set(key, demo);
  return demo;
}
function placeValueTradeDemoState(problem, k) {
  if (!Number.isInteger(k) || k < 0 || k > problem.columns.length)
    throw new Error(`columns finished must be 0..${problem.columns.length}`);
  return k === 0 ? placeValueTradeStart(problem) : placeValueTradeDemoSteps(problem).steps[k - 1].after;
}
function placeValueTradeDemoAt(problem, finished) {
  const steps = placeValueTradeDemoSteps(problem).steps;
  const n = problem.columns.length;
  const v = Number.isFinite(finished) ? Math.min(n, Math.max(0, finished)) : 0;
  const k = Math.min(n, Math.floor(v + 1e-9));
  const before = steps.slice(0, k).reduce((sum, step) => sum + step.actions.length, 0);
  if (k >= n)
    return { k, j: 0, value: k, index: before };
  const m = steps[k].actions.length;
  const j = Math.min(m - 1, Math.max(0, Math.floor((v - k) * m + 1e-6)));
  return { k, j, value: j === 0 ? k : k + j / m, index: before + j };
}
function placeValueTradeDemoValues(problem, from, to) {
  const steps = placeValueTradeDemoSteps(problem).steps;
  const start = placeValueTradeDemoAt(problem, from), end = placeValueTradeDemoAt(problem, to);
  const values = [];
  for (let k = start.k; k < Math.min(end.k + (end.j > 0 ? 1 : 0), steps.length); k += 1) {
    const m = steps[k].actions.length;
    for (let j = k === start.k ? start.j + 1 : 1; j <= m; j += 1) {
      if (k === end.k && j > end.j)
        break;
      values.push(j === m ? k + 1 : k + j / m);
    }
  }
  return values;
}
function placeValueTradeDemoStateAt(problem, at) {
  return at.j === 0 ? placeValueTradeDemoState(problem, at.k) : placeValueTradeDemoSteps(problem).steps[at.k].states[at.j];
}
function record3(value, path, fail) {
  if (!value || typeof value !== "object" || Array.isArray(value))
    fail(path, "Expected an object");
  return value;
}
function wholeNumber3(raw, path, low, high, fail, what) {
  if (typeof raw !== "number" || !Number.isInteger(raw) || raw < low || raw > high)
    fail(path, `${what} is a whole number from ${low} to ${high}`);
  return raw;
}
function placeValueTradeFaultText(fault, operation, a, b) {
  const pair = readable(a) && readable(b) ? `${placeValueNumeral(a)} ${operation === "subtract" ? "\u2212" : "+"} ${placeValueNumeral(b)}` : "This pair";
  switch (fault) {
    case "decimals":
      return `${pair}: a number has more than two decimals (decimals)`;
    case "negative":
      return `${pair} is below zero: the first number is the larger (negative)`;
    case "too_wide": {
      const { top_place, low_place } = placeValueTradeColumnsFor(operation, a, b);
      return `${pair} needs ${top_place - low_place + 1} columns; the card draws at most ${PLACE_VALUE_TRADE_MAX_COLUMNS}, up to the hundred thousands (too_wide)`;
    }
    case "no_trade":
      return `${pair} has no column that ${operation === "subtract" ? "borrows" : "carries"}: this card is for trading (no_trade)`;
    default:
      return "The numbers are whole numbers of thousandths from 0 to 999,999.99 (unreadable)";
  }
}
function validatePlaceValueTradeContent(raw, path, fail, options = {}) {
  const content = record3(raw, path, fail);
  for (const key2 of Object.keys(content)) {
    if (!["language", "operation", "top_place", "low_place", "a", "b", "finished", "places", "bindings"].includes(key2))
      fail(`${path}/${key2}`, `Unknown place-value trade field '${key2}'`);
  }
  if (content.language !== void 0 && !PLACE_VALUE_TRADE_LANGUAGES.includes(content.language)) {
    fail(`${path}/language`, `The card speaks ${PLACE_VALUE_TRADE_LANGUAGES.join(" or ")}`);
  }
  const operation = content.operation;
  if (!PLACE_VALUE_TRADE_OPERATIONS.includes(operation))
    fail(`${path}/operation`, "The operation is 'add' or 'subtract'");
  const pairFault = options.boundValues || !readable(content.a) || !readable(content.b) ? void 0 : placeValueTradeFault(operation, content.a, content.b);
  if (pairFault) {
    fail(`${path}/${pairFault === "negative" || pairFault === "no_trade" ? "b" : pairFault === "decimals" ? content.a % 10 ? "a" : "b" : "a"}`, placeValueTradeFaultText(pairFault, operation, content.a, content.b));
  }
  const top = wholeNumber3(content.top_place, `${path}/top_place`, PLACE_VALUE_TRADE_MIN_PLACE, PLACE_VALUE_TRADE_MAX_PLACE, fail, "The top place");
  const low = wholeNumber3(content.low_place, `${path}/low_place`, PLACE_VALUE_TRADE_MIN_PLACE, 0, fail, "The low place");
  if (top < low)
    fail(`${path}/top_place`, `The top place (${top}) is below the low place (${low})`);
  const columns = placeValueTradeColumns(top, low);
  if (columns.length > PLACE_VALUE_TRADE_MAX_COLUMNS)
    fail(`${path}/top_place`, `The card draws at most ${PLACE_VALUE_TRADE_MAX_COLUMNS} columns; ${top} to ${low} is ${columns.length} (too_wide)`);
  const a = wholeNumber3(content.a, `${path}/a`, 0, PLACE_VALUE_TRADE_MAX_VALUE, fail, "The first number (in thousandths)");
  const b = wholeNumber3(content.b, `${path}/b`, 0, PLACE_VALUE_TRADE_MAX_VALUE, fail, "The second number (in thousandths)");
  for (const [name, value] of [["a", a], ["b", b]]) {
    if (value % 10)
      fail(`${path}/${name}`, `${placeValueNumeral(value)} has more than two decimals (decimals)`);
    if (value > 0 && placeValueTopPlace(value) > top)
      fail(`${path}/${name}`, `${placeValueNumeral(value)} has a place above the card's columns`);
    if (placeValueTradeDecimals(value) > -low)
      fail(`${path}/${name}`, `${placeValueNumeral(value)} has a place below the card's columns`);
  }
  const finished = wholeNumber3(content.finished, `${path}/finished`, 0, columns.length, fail, "The columns finished");
  if (!Array.isArray(content.places) || content.places.length !== columns.length) {
    fail(`${path}/places`, `A card of these columns lists ${columns.length} places, highest first`);
  }
  const statuses = [];
  for (const [i, item] of content.places.entries()) {
    const at = `${path}/places/${i}`;
    const place = record3(item, at, fail);
    for (const key2 of Object.keys(place))
      if (!["as", "place", "status"].includes(key2))
        fail(`${at}/${key2}`, `Unknown place-value trade field '${key2}'`);
    const expected = columns[i];
    if (place.place !== expected)
      fail(`${at}/place`, `Place ${i + 1} is ${expected} (${placeValueColumnName(expected)}): places are listed highest first`);
    if (place.as !== PLACE_VALUE_PLACE_ALIASES[expected])
      fail(`${at}/as`, `Place ${expected} is '${PLACE_VALUE_PLACE_ALIASES[expected]}'`);
    statuses.push(wholeNumber3(place.status, `${at}/status`, 0, placeValueTradeMaxStatus(operation), fail, `The status of the ${placeValueColumnName(expected).toLowerCase()}`));
  }
  if (options.boundValues)
    return;
  const need = placeValueTradeColumnsFor(operation, a, b);
  if (need.top_place !== top || need.low_place !== low) {
    fail(`${path}/top_place`, `${placeValueNumeral(a)} ${operation === "subtract" ? "\u2212" : "+"} ${placeValueNumeral(b)} needs the columns from ${placeValueColumnName(need.top_place).toLowerCase()} to ${placeValueColumnName(need.low_place).toLowerCase()}; the card draws ${placeValueColumnName(top).toLowerCase()} to ${placeValueColumnName(low).toLowerCase()}`);
  }
  if (finished > 0 && statuses.some((status) => status !== 0)) {
    fail(`${path}/finished`, "A demonstration (columns finished) plays on a fresh chart: every column's status is 0");
  }
  const problem = placeValueTradeProblemOn(operation, a, b, columns);
  const key = statuses.join("");
  if (!placeValueTradeReachable(problem).some((state) => placeValueTradeStateKey(state) === key)) {
    fail(`${path}/places`, `No taps make these column statuses (${key}) from the start of ${placeValueTradeProblemText(problem)}`);
  }
}
var placeValueTradeLanguage = (raw) => placeValueLanguage(raw);
function placeValueTradeState(raw) {
  const content = raw ?? {};
  const operation = content.operation === "subtract" ? "subtract" : "add";
  const int = (value, low2, high, fallback = low2) => typeof value === "number" && Number.isFinite(value) ? Math.min(high, Math.max(low2, Math.floor(value + 1e-9))) : fallback;
  const low = int(content.low_place, PLACE_VALUE_TRADE_MIN_PLACE, 0, 0);
  const top = Math.max(low, int(content.top_place, PLACE_VALUE_TRADE_MIN_PLACE, PLACE_VALUE_TRADE_MAX_PLACE, 0));
  const columns = placeValueTradeColumns(top, low).slice(0, PLACE_VALUE_TRADE_MAX_COLUMNS);
  const problem = placeValueTradeProblemOn(operation, Number(content.a), Number(content.b), columns);
  const places = Array.isArray(content.places) ? content.places : [];
  const max = placeValueTradeMaxStatus(operation);
  const status = Object.fromEntries(columns.map((place) => [place, Math.min(max, Math.max(0, Math.round(Number(places.find((item) => item?.place === place)?.status) || 0)))]));
  const asked = typeof content.finished === "number" && Number.isFinite(content.finished) ? Math.min(columns.length, Math.max(0, content.finished)) : 0;
  if (asked > 0) {
    try {
      const at = placeValueTradeDemoAt(problem, asked);
      if (at.value > 0)
        return { ...placeValueTradeDemoStateAt(problem, at), finished: at.value };
    } catch {
    }
  }
  return { problem, status, finished: Math.floor(asked + 1e-9) };
}
function placeValueTradeChanges(before, after) {
  return after.problem.columns.filter((place) => after.status[place] !== before.status[place]).map((place) => ({ place, field: "status", before: before.status[place], after: after.status[place] }));
}
function list(items, zh) {
  if (items.length < 2)
    return items.join("");
  return zh ? `${items.slice(0, -1).join("\u3001")}\u548C${items.at(-1)}` : `${items.slice(0, -1).join(", ")} and ${items.at(-1)}`;
}
