      "\u70B9\u4E00\u4E2A\u65B9\u5757\uFF0C\u628A\u5B83\u653E\u8FDB\u6258\u76D8\uFF1B\u518D\u70B9\u4E00\u4E0B\u5C31\u62FF\u51FA\u6765\u3002\u6258\u76D8\u91CC\u6709\u5341\u4E2A\u65F6\uFF0C\u6309\u300C\u6362\u6210\u4E00\u4E2A\u5341\u300D\u6216\u300C\u6362\u6210\u4E00\u4E2A\u767E\u300D\u3002\u6309\u300C\u62C6\u5F00\u4E00\u4E2A\u5341\u300D\u6216\u300C\u62C6\u5F00\u4E00\u4E2A\u767E\u300D\uFF0C\u628A\u5B83\u62C6\u6210\u5341\u4E2A\u4F4E\u4E00\u4F4D\u7684\u65B9\u5757\u3002\u505A\u597D\u540E\u6309\u300C\u6211\u505A\u5B8C\u4E86\u300D\u3002"
    ]
  }
};
function baseTenHowTo(raw) {
  const words2 = BASE_TEN_WORDS[baseTenLanguage(raw)];
  return words2.howTo[raw?.columns === 3 ? 1 : 0];
}
function baseTenRefusalText(reason, place, language = "en-US") {
  const words2 = BASE_TEN_WORDS[language] ?? BASE_TEN_WORDS["en-US"];
  const sentences = words2.refusal[reason];
  if (!sentences)
    return words2.other;
  return sentences[Math.min(Math.max(0, Number.isInteger(place) ? place : 0), sentences.length - 1)];
}
function baseTenChanges(before, after) {
  const changes = [];
  for (let p = 0; p < after.columns; p += 1) {
    if (after.counts[p] !== before.counts[p])
      changes.push({ place: p, field: "count", before: before.counts[p], after: after.counts[p] });
    if (p < after.trays.length && after.trays[p] !== before.trays[p])
      changes.push({ place: p, field: "tray", before: before.trays[p], after: after.trays[p] });
  }
  return changes;
}
function baseTenFacts(mat) {
  const value = valueOf(mat.counts);
  const noTradeLeft = mat.counts.slice(0, mat.columns - 1).every((count) => count < 10);
  let digits = 1;
  while (digits < mat.columns && value >= 10 ** digits)
    digits += 1;
  const places = Array.from({ length: digits }, (_, i) => digits - 1 - i);
  const parts = places.map((p) => mat.counts[p] * 10 ** p);
  return { value, no_trade_left: noTradeLeft, digits, counts: places.map((p) => mat.counts[p]), parts, equation: `${value} = ${parts.join(" + ")}` };
}

// node_modules/octos-lesson-language/dist/packages/plugin-math/src/place-value-chart.js
var PLACE_VALUE_CHART_KIND = "place_value_chart";
var PLACE_VALUE_CHART_FEATURE = "plugin:math/place-value-chart@1";
var PLACE_VALUE_CHART_PLUGIN_VERSION = "0.8.0";
var PLACE_VALUE_CHART_LANGUAGES = ["en-US", "zh-CN"];
var PLACE_VALUE_CHART_BINDINGS = {
  places: ["count", "pulled"]
};
var PLACE_VALUE_CHART_CARD_BINDINGS = ["target"];
var PLACE_VALUE_MIN_PLACE = -3;
var PLACE_VALUE_MAX_PLACE = 6;
var PLACE_VALUE_MAX_PER_PLACE = 9;
var PLACE_VALUE_MAX_VALUE = 10 ** (PLACE_VALUE_MAX_PLACE + 1) * 1e3 - 1;
var PLACE_VALUE_CHART_MODES = ["build", "apart"];
var PLACE_VALUE_BUILD_GIVENS = ["name", "expanded", "expanded_factors", "place_counts"];
var PLACE_VALUE_PLACE_ALIASES = {
  6: "millions",
  5: "hundred-thousands",
  4: "ten-thousands",
  3: "thousands",
  2: "hundreds",
  1: "tens",
  0: "ones",
  [-1]: "tenths",
  [-2]: "hundredths",
  [-3]: "thousandths"
};
var PLACE_VALUE_TAP_PLACES = Object.freeze(Array.from({ length: PLACE_VALUE_MAX_PLACE - PLACE_VALUE_MIN_PLACE + 1 }, (_, i) => PLACE_VALUE_PLACE_ALIASES[i + PLACE_VALUE_MIN_PLACE]));
var placeValueTapIndex = (place) => place - PLACE_VALUE_MIN_PLACE;
var placeValueTapPlace = (index) => index + PLACE_VALUE_MIN_PLACE;
var SHORT = { "en-US": "en", "zh-CN": "zh" };
var short = (language) => SHORT[language ?? "en-US"] ?? "en";
function placeValueDigitAt(value, place) {
  return Math.floor(value / 10 ** (place + 3)) % 10;
}
function placeValueTopPlace(value) {
  for (let place = PLACE_VALUE_MAX_PLACE; place >= PLACE_VALUE_MIN_PLACE; place -= 1)
    if (placeValueDigitAt(value, place))
      return place;
  return 0;
}
function placeValueHasFraction(value) {
  return value % 1e3 !== 0;
}
var groupThousands = (whole) => String(whole).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
function placeValueNumeral(value, language = "en-US") {
  const whole = Math.floor(value / 1e3);
  const frac = value % 1e3;
  const wholeText = short(language) === "en" ? groupThousands(whole) : String(whole);
  if (!frac)
    return wholeText;
  return `${wholeText}.${String(frac).padStart(3, "0").replace(/0+$/u, "")}`;
}
function placeValueUnitText(place, language = "en-US", { disk = false } = {}) {
  if (place < 0)
    return `0.${"0".repeat(-place - 1)}1`;
  if (disk && short(language) === "zh" && place >= 4)
    return `${10 ** (place - 4)}\u4E07`;
  return short(language) === "en" ? groupThousands(10 ** place) : String(10 ** place);
}
var EN_PLACE = { 6: "Millions", 5: "Hundred thousands", 4: "Ten thousands", 3: "Thousands", 2: "Hundreds", 1: "Tens", 0: "Ones", [-1]: "Tenths", [-2]: "Hundredths", [-3]: "Thousandths" };
var ZH_PLACE = { 6: "\u767E\u4E07\u4F4D", 5: "\u5341\u4E07\u4F4D", 4: "\u4E07\u4F4D", 3: "\u5343\u4F4D", 2: "\u767E\u4F4D", 1: "\u5341\u4F4D", 0: "\u4E2A\u4F4D", [-1]: "\u5341\u5206\u4F4D", [-2]: "\u767E\u5206\u4F4D", [-3]: "\u5343\u5206\u4F4D" };
function placeValueColumnName(place, language = "en-US") {
  return (short(language) === "en" ? EN_PLACE : ZH_PLACE)[place];
}
var periodSize = (language) => short(language) === "en" ? 3 : 4;
function placeValuePeriodTop(place, language = "en-US") {
  const size = periodSize(language);
  return Math.min(PLACE_VALUE_MAX_PLACE, (Math.floor(Math.max(place, 0) / size) + 1) * size - 1);
}
function placeValueColumns(topPlace, decimals) {
  const columns = [];
  for (let place = topPlace; place >= 0; place -= 1)
    columns.push(place);
  if (decimals)
    columns.push(-1, -2, -3);
  return columns;
}
function placeValueParts(value) {
  const list2 = [];
  for (let place = PLACE_VALUE_MAX_PLACE; place >= PLACE_VALUE_MIN_PLACE; place -= 1) {
    const digit = placeValueDigitAt(value, place);
    if (digit)
      list2.push({ place, digit, value: digit * 10 ** (place + 3) });
  }
  return list2;
}
var EN_UNIT = { 6: ["million", "millions"], 5: ["hundred thousand", "hundred thousands"], 4: ["ten thousand", "ten thousands"], 3: ["thousand", "thousands"], 2: ["hundred", "hundreds"], 1: ["ten", "tens"], 0: ["one", "ones"], [-1]: ["tenth", "tenths"], [-2]: ["hundredth", "hundredths"], [-3]: ["thousandth", "thousandths"] };
var ZH_UNIT_NAME = { 6: "\u767E\u4E07", 5: "\u5341\u4E07", 4: "\u4E07", 3: "\u5343", 2: "\u767E", 1: "\u5341", 0: "\u4E00", [-1]: "0.1", [-2]: "0.01", [-3]: "0.001" };
function placeValueUnitName(place, language = "en-US") {
  return short(language) === "en" ? placeValueUnitText(place, "en-US") : ZH_UNIT_NAME[place];
}
function placeValueEnUnitWord(place, plural2) {
  return EN_UNIT[place][plural2 ? 1 : 0];
}
function placeValueTaskFault(value, given) {
  if (!value)
    return "zero";
  const parts = placeValueParts(value);
  if ((given === "expanded" || given === "numeral") && parts.length < 2)
    return "one_place";
  if (given === "expanded_factors" && parts.length === 1 && parts[0].digit === 1)
    return "one_place";
  return void 0;
}
function placeValueAddDisk(chart, place) {
  if (!(place in chart))
    return { ok: false, reason: "no_place" };
  if (chart[place] >= PLACE_VALUE_MAX_PER_PLACE)
    return { ok: false, reason: "full" };
  return { ok: true, chart: { ...chart, [place]: chart[place] + 1 } };
}
function placeValueRemoveDisk(chart, place) {
  if (!(place in chart) || chart[place] === 0)
    return { ok: false, reason: "empty" };
  return { ok: true, chart: { ...chart, [place]: chart[place] - 1 } };
}
function placeValueChartValue(chart) {
  return Object.entries(chart).reduce((sum, [place, count]) => sum + count * 10 ** (Number(place) + 3), 0);
}
function placeValueBuiltRight(chart, target) {
  return placeValueChartValue(chart) === target;
}
function record2(value, path, fail) {
  if (!value || typeof value !== "object" || Array.isArray(value))
    fail(path, "Expected an object");
  return value;
}
function only2(value, allowed, path, fail) {
  for (const key of Object.keys(value))
    if (!allowed.includes(key))
      fail(`${path}/${key}`, `Unknown place-value chart field '${key}'`);
}
function wholeNumber2(raw, path, low, high, fail, what) {
  if (typeof raw !== "number" || !Number.isInteger(raw) || raw < low || raw > high)
    fail(path, `${what} is a whole number from ${low} to ${high}`);
  return raw;
}
function placeValueLanguage(raw) {
  return raw?.language === "zh-CN" ? "zh-CN" : "en-US";
}
function placeValuePeriodTops(language = "en-US") {
  return [...new Set(Array.from({ length: PLACE_VALUE_MAX_PLACE + 1 }, (_, place) => placeValuePeriodTop(place, language)))];
}
function validatePlaceValueChartContent(raw, path, fail, options = {}) {
  const content = record2(raw, path, fail);
  only2(content, ["language", "mode", "given", "top_place", "decimals", "target", "places", "bindings"], path, fail);
  if (content.language !== void 0 && !PLACE_VALUE_CHART_LANGUAGES.includes(content.language)) {
    fail(`${path}/language`, `A chart speaks ${PLACE_VALUE_CHART_LANGUAGES.join(" or ")}`);
  }
  const language = placeValueLanguage(content);
  const mode = content.mode;
  if (!PLACE_VALUE_CHART_MODES.includes(mode))
    fail(`${path}/mode`, "A chart's mode is 'build' or 'apart'");
  const given = content.given;
  if (mode === "build" && !PLACE_VALUE_BUILD_GIVENS.includes(given)) {
    fail(`${path}/given`, `A build task gives ${PLACE_VALUE_BUILD_GIVENS.join(", ")}`);
  }
  if (mode === "apart" && given !== "numeral")
    fail(`${path}/given`, "A pull-apart task gives the numeral");
  const tops = placeValuePeriodTops(language);
  const top = wholeNumber2(content.top_place, `${path}/top_place`, 0, PLACE_VALUE_MAX_PLACE, fail, "The top place");
  if (!tops.includes(top))
    fail(`${path}/top_place`, `A ${language} chart shows whole periods: its top place is ${tops.join(", ")}`);
  if (typeof content.decimals !== "boolean")
    fail(`${path}/decimals`, "decimals is true or false");
  const columns = placeValueColumns(top, content.decimals);
  const target = wholeNumber2(content.target, `${path}/target`, 1, PLACE_VALUE_MAX_VALUE, fail, "The target (in thousandths)");
  if (placeValueTopPlace(target) > top)
    fail(`${path}/target`, `The target ${placeValueNumeral(target)} has a place above the chart's columns`);
  if (placeValueHasFraction(target) && !content.decimals)
    fail(`${path}/target`, `The target ${placeValueNumeral(target)} has a fraction part: the chart needs decimals`);
  if (!Array.isArray(content.places) || content.places.length !== columns.length) {
    fail(`${path}/places`, `A chart of these columns lists ${columns.length} places, highest first`);
  }
  for (const [i, item] of content.places.entries()) {
    const at = `${path}/places/${i}`;
    const place = record2(item, at, fail);
    only2(place, ["as", "place", "count", "pulled"], at, fail);
    const expected = columns[i];
    if (place.place !== expected)
      fail(`${at}/place`, `Place ${i + 1} is ${expected} (${placeValueColumnName(expected)}): places are listed highest first`);
    if (place.as !== PLACE_VALUE_PLACE_ALIASES[expected])
      fail(`${at}/as`, `Place ${expected} is '${PLACE_VALUE_PLACE_ALIASES[expected]}'`);
    const name = placeValueColumnName(expected).toLowerCase();
    const count = wholeNumber2(place.count, `${at}/count`, 0, PLACE_VALUE_MAX_PER_PLACE, fail, `The count of ${name}`);
    if (mode === "build") {
      if (place.pulled !== void 0)
        fail(`${at}/pulled`, "A build task pulls nothing apart");
      continue;
    }
    if (place.pulled === void 0)
      fail(`${at}/pulled`, "A pull-apart task states how many of each place are pulled out");
    const pulled = wholeNumber2(place.pulled, `${at}/pulled`, 0, PLACE_VALUE_MAX_PER_PLACE, fail, `The pulled ${name}`);
    if (!options.boundValues && count + pulled !== placeValueDigitAt(target, expected)) {
      fail(`${at}`, `The ${name} on the chart and pulled out make ${count + pulled}, not the target's digit ${placeValueDigitAt(target, expected)}`);
    }
  }
  if (options.boundValues)
    return;
  if (placeValueTaskFault(target, given) === "one_place") {
    fail(`${path}/target`, `${placeValueNumeral(target)} has one non-zero place: given as ${given === "numeral" ? "a numeral to pull apart" : "an expanded form"}, it shows its own answer`);
  }
  if (mode === "build" && content.places.reduce((sum, item) => sum + item.count * 10 ** (item.place + 3), 0) === target) {
    fail(`${path}/places`, `The chart already holds ${placeValueNumeral(target)}: a build task starts before the number is built`);
  }
}
function placeValueDrawnCount(count) {
  if (typeof count !== "number" || !Number.isFinite(count))
    return 0;
  return Math.min(PLACE_VALUE_MAX_PER_PLACE, Math.max(0, Math.floor(count + 1e-9)));
}
function placeValueChartState(raw) {
  const content = raw ?? {};
  const top = typeof content.top_place === "number" && Number.isInteger(content.top_place) ? Math.min(PLACE_VALUE_MAX_PLACE, Math.max(0, content.top_place)) : 0;
  const columns = placeValueColumns(top, content.decimals === true);
  const places = Array.isArray(content.places) ? content.places : [];
  const find = (place) => places.find((item) => item?.place === place);
  const target = typeof content.target === "number" && Number.isFinite(content.target) ? Math.max(0, Math.round(content.target)) : 0;
  return {
    mode: content.mode === "apart" ? "apart" : "build",
    columns,
    counts: columns.map((place) => placeValueDrawnCount(find(place)?.count)),
    pulled: columns.map((place) => placeValueDrawnCount(find(place)?.pulled)),
    target
  };
}
var disksOf = (state) => Object.fromEntries(state.columns.map((place, i) => [place, state.counts[i]]));
function applyPlaceValueTap(state, tap) {
  const index = state.columns.indexOf(tap.place);
  if (index < 0)
    return { ok: false, reason: "no_place" };
  if (tap.tap === "take_out") {
    if (state.mode !== "apart")
      return { ok: false, reason: "wrong_mode" };
    if (state.counts[index] === 0)
      return { ok: false, reason: "empty" };
    return {
      ok: true,
      state: { ...state, counts: state.counts.map((count, i) => i === index ? 0 : count), pulled: state.pulled.map((pulled, i) => i === index ? pulled + state.counts[index] : pulled) }
    };
  }
  if (tap.tap !== "add" && tap.tap !== "remove")
    return { ok: false, reason: "wrong_mode" };
  if (state.mode !== "build")
    return { ok: false, reason: "wrong_mode" };
  const result = tap.tap === "add" ? placeValueAddDisk(disksOf(state), tap.place) : placeValueRemoveDisk(disksOf(state), tap.place);
  if (!result.ok)
    return { ok: false, reason: result.reason };
  return { ok: true, state: { ...state, counts: state.columns.map((place) => result.chart[place]) } };
}
function placeValueChanges(before, after) {
  const changes = [];
  after.columns.forEach((place, index) => {
    if (after.counts[index] !== before.counts[index])
      changes.push({ index, place, field: "count", before: before.counts[index], after: after.counts[index] });
    if (after.pulled[index] !== before.pulled[index])
      changes.push({ index, place, field: "pulled", before: before.pulled[index], after: after.pulled[index] });
  });
  return changes;
}
function placeValueFacts(state) {
  const value = placeValueChartValue(disksOf(state));
  return {
    value,
    built: state.mode === "build" && placeValueBuiltRight(disksOf(state), state.target),
    pulled_all: state.mode === "apart" && state.counts.every((count) => count === 0)
  };
}
