function selectionThinkingOverride(input, client) {
  if (process.env.OLL_SELECTION_THINKING_LEVEL?.trim() || process.env.OLL_THINKING_LEVEL?.trim()) return void 0;
  return client.provider === "vertex" && client.model === "gemini-3.6-flash" && input.capabilities?.includes("board_writing") && ["custom-question", "check-and-suggest"].includes(input.tool_id) ? "MINIMAL" : void 0;
}
function selectionOutputPath(input) {
  const workDirectory = resolve2(process.env.OCTOS_WORK_DIR?.trim() || process.cwd());
  const path = resolve2(
    workDirectory,
    "study",
    "selections",
    `${input.turn_id}.octos-selection-enhancement.json`
  );
  if (!path.startsWith(`${workDirectory}${sep}`) || !isAbsolute(path)) {
    throw new Error("Resolved selection output path escapes OCTOS_WORK_DIR");
  }
  return path;
}
async function workspaceImageMedia(relativePath, fieldName) {
  if (!relativePath) return void 0;
  const sessionWorkspace = resolve2(
    process.env.OCTOS_SESSION_WORKSPACE?.trim() || process.env.OCTOS_WORK_DIR?.trim() || process.cwd()
  );
  const candidate = resolve2(sessionWorkspace, relativePath);
  if (candidate !== sessionWorkspace && !candidate.startsWith(`${sessionWorkspace}${sep}`) || !isAbsolute(candidate)) {
    throw new Error(`${fieldName} escapes OCTOS_SESSION_WORKSPACE`);
  }
  const [canonicalWorkspace, canonicalPath] = await Promise.all([
    realpath(sessionWorkspace),
    realpath(candidate)
  ]);
  if (canonicalPath !== canonicalWorkspace && !canonicalPath.startsWith(`${canonicalWorkspace}${sep}`)) {
    throw new Error(`${fieldName} escapes OCTOS_SESSION_WORKSPACE`);
  }
  const data = await readFile(canonicalPath);
  if (data.byteLength === 0 || data.byteLength > 10 * 1024 * 1024) {
    throw new Error(`${fieldName} must be between 1 byte and 10 MB`);
  }
  const mimeType = data[0] === 137 && data[1] === 80 && data[2] === 78 && data[3] === 71 ? "image/png" : data[0] === 255 && data[1] === 216 ? "image/jpeg" : data.subarray(0, 4).toString("ascii") === "RIFF" && data.subarray(8, 12).toString("ascii") === "WEBP" ? "image/webp" : void 0;
  if (!mimeType) throw new Error(`${fieldName} must be PNG, JPEG, or WebP`);
  return { mimeType, data: data.toString("base64") };
}
async function selectionModelMedia(input) {
  return workspaceImageMedia(input.selection_media, "selection_media");
}
function selectionPaddedRange(values, fallback) {
  const finite = values.filter((value) => Number.isFinite(value) && Math.abs(value) <= 1e12).sort((a, b) => a - b);
  if (finite.length === 0) return fallback;
  const low = finite[Math.floor((finite.length - 1) * 0.02)];
  const high = finite[Math.ceil((finite.length - 1) * 0.98)];
  const span = high - low;
  const padding = span > 1e-9 ? span * 0.12 : Math.max(0.5, Math.abs(low) * 0.2);
  return { min: low - padding, max: high + padding };
}
function selectionExplicitViewport(expression) {
  const evaluate = compileMathExpression(expression, ["x"]);
  const candidates = [
    { min: -4, max: 4 },
    { min: 0.05, max: 8 },
    { min: -10, max: 10 }
  ];
  let best;
  for (const xRange of candidates) {
    const values = [];
    for (let index = 0; index <= 160; index += 1) {
      const x = xRange.min + (xRange.max - xRange.min) * index / 160;
      try {
        const y = evaluate({ x });
        if (Number.isFinite(y) && Math.abs(y) <= 1e12) values.push(y);
      } catch {
      }
    }
    const ratio = values.length / 161;
    if (!best || ratio > best.ratio) best = { x: xRange, values, ratio };
    if (ratio >= 0.75) {
      best = { x: xRange, values, ratio };
      break;
    }
  }
  if (!best || best.values.length < 8) throw new Error("Plot expression has no stable finite viewport");
  return { x: best.x, y: selectionPaddedRange(best.values, { min: -1, max: 1 }) };
}
function selectionSurfaceDomain(expression) {
  const evaluate = compileMathExpression(expression, ["x", "y"]);
  const candidates = [
    { x: { min: -2, max: 2 }, y: { min: -2, max: 2 } },
    { x: { min: 0.05, max: 4 }, y: { min: 0.05, max: 4 } },
    { x: { min: -5, max: 5 }, y: { min: -5, max: 5 } }
  ];
  for (const candidate of candidates) {
    let finite = 0;
    for (let xIndex = 0; xIndex <= 12; xIndex += 1) {
      const x = candidate.x.min + (candidate.x.max - candidate.x.min) * xIndex / 12;
      for (let yIndex = 0; yIndex <= 12; yIndex += 1) {
        const y = candidate.y.min + (candidate.y.max - candidate.y.min) * yIndex / 12;
        try {
          const z = evaluate({ x, y });
          if (Number.isFinite(z) && Math.abs(z) <= 1e12) finite += 1;
        } catch {
        }
      }
    }
    if (finite / (13 * 13) >= 0.75) return candidate;
  }
  throw new Error("3D surface has no stable finite viewport");
}
function parseSelectionModelResponse(raw, input) {
  let value;
  try {
    value = JSON.parse(raw);
  } catch (error) {
    throw new Error(`Selection enhancement is not JSON: ${error.message}`);
  }
  if (!value || typeof value !== "object" || Array.isArray(value)) {
    throw new Error("Selection enhancement must be an object");
  }
  const output = value;
  const nonEmpty = (name) => requireNonEmptyString(output[name], name);
  const reusableRecognition = hasReusableSelectionRecognition(input);
  const kind = reusableRecognition ? input.content_hint : nonEmpty("interpretation_kind");
  if (!["text", "math", "geometry", "data", "unknown"].includes(kind)) {
    throw new Error("interpretation_kind is invalid");
  }
  const confidence = reusableRecognition ? input.recognition_confidence : nonEmpty("interpretation_confidence");
  if (!["high", "medium", "low"].includes(confidence)) {
    throw new Error("interpretation_confidence is invalid");
  }
  const title = nonEmpty("title");
  const text3 = nonEmpty("text");
  const interpretationContent = reusableRecognition ? requireNonEmptyString(input.recognized_content, "recognized_content") : nonEmpty("interpretation_content");
  const items = Array.isArray(output.items) ? output.items.map((item, index) => requireNonEmptyString(item, `items[${index}]`)) : [];
  let response;
  const visualizationRequested = input.tool_id === "generate-plot" || input.tool_id === "custom-question";
  const alternatives = Array.isArray(output.alternatives) ? output.alternatives.map((item, index) => requireNonEmptyString(item, `alternatives[${index}]`)).slice(0, 4) : [];
  const unsupported = (reasonCode, reason, fallbackAlternatives) => ({
    kind: "unsupported",
    title: "\u5F53\u524D\u65E0\u6CD5\u751F\u6210\u8FD9\u4E2A\u51FD\u6570\u56FE\u50CF",
    text: reason,
    reason_code: reasonCode,
    alternatives: alternatives.length > 0 ? alternatives : [...fallbackAlternatives ?? ["\u786E\u8BA4\u6846\u9009\u8303\u56F4\u53EA\u5305\u542B\u4E00\u4E2A\u5B8C\u6574\u516C\u5F0F", "\u4F7F\u7528\u201C\u95EE\u5C0F\u7AE0\u9C7C\u201D\u8BA9\u5B83\u89E3\u91CA\u6216\u6539\u5199\u4E3A\u53EF\u7ED8\u5236\u5F62\u5F0F"]]
  });
  const failureAlternatives = {
    unreadable_expression: [
      "\u91CD\u65B0\u6846\u9009\u4E00\u4E2A\u6E05\u6670\u3001\u5B8C\u6574\u7684\u516C\u5F0F\u540E\u91CD\u8BD5",
      "\u4F7F\u7528\u201C\u95EE\u5C0F\u7AE0\u9C7C\u201D\u8BA9\u5B83\u5148\u8BC6\u522B\u5E76\u8F6C\u5199\u516C\u5F0F"
    ],
    unsupported_variables: [
      "\u8868\u8FBE\u5F0F\u53EA\u652F\u6301 x\u3001y\u3001z \u4E09\u4E2A\u53D8\u91CF\uFF0C\u8BF7\u628A\u5176\u4ED6\u53D8\u91CF\u66FF\u6362\u4E3A\u5177\u4F53\u6570\u503C",
      "\u591A\u4F59\u53D8\u91CF\u53EF\u56FA\u5B9A\u53D6\u503C\u540E\u6539\u5199\u4E3A F(x,y,z)=0 \u7684\u9690\u5F0F\u5F62\u5F0F"
    ],
    unsupported_representation: [
      "\u53EF\u6539\u5199\u4E3A y=f(x)\u3001z=f(x,y) \u6216 F(x,y,z)=0 \u7684\u9690\u5F0F\u5F62\u5F0F\u540E\u91CD\u8BD5",
      "\u786E\u8BA4\u6846\u9009\u8303\u56F4\u53EA\u5305\u542B\u4E00\u4E2A\u5B8C\u6574\u516C\u5F0F"
    ],
    unsafe_complexity: [
      "\u5C1D\u8BD5\u7B80\u5316\u8868\u8FBE\u5F0F\u3001\u51CF\u5C11\u5D4C\u5957\u5C42\u7EA7\u540E\u91CD\u8BD5",
      "\u6846\u9009\u8868\u8FBE\u5F0F\u4E2D\u8F83\u7B80\u5355\u7684\u90E8\u5206\u5206\u522B\u7ED8\u5236"
    ]
  };
  const failureReasonCode = (error) => {
    if (confidence === "low") return "unreadable_expression";
    const message = error instanceof Error ? error.message : String(error);
    if (/too complex/iu.test(message)) return "unsafe_complexity";
    if (/Unknown variable or function '[a-z]'/u.test(message)) {
      return "unsupported_variables";
    }
    return "unsupported_representation";
  };
  const boardWriting = input.capabilities?.includes("board_writing") === true;
  const responseKind = input.tool_id === "explain" || input.tool_id === "check-and-suggest" && !boardWriting ? "explanation" : output.response_kind;
  if (input.tool_id === "check-and-suggest" && boardWriting && responseKind !== "board_writing") {
    throw new Error("Checking with board writing capability requires board_writing");
  }
  if (input.delivery_mode === "board-writing" && responseKind !== "board_writing") {
    throw new Error("delivery_mode=board-writing requires board_writing");
  }
  if (input.delivery_mode === "card" && responseKind === "board_writing") {
    throw new Error("delivery_mode=card forbids board_writing");
  }
  const modelExpression = typeof output.expression === "string" && output.expression.trim() ? output.expression.trim() : void 0;
  const buildRoutedVisualization = () => {
    const route = routeSelectionPlot([interpretationContent, modelExpression]);
    if (route.kind === "unsupported") {
      return unsupported(route.reasonCode, route.reason, route.alternatives);
    }
    if (route.kind === "plot") {
      const viewport = selectionExplicitViewport(route.expression);
      return {
        kind: "plot",
        plot_kind: "explicit",
        title,
        text: text3,
        expression: route.expression,
        x_range: viewport.x,
        y_range: viewport.y
      };
    }
    if (route.kind === "implicit_plot") {
      const viewport = implicitSurfaceDomain(route.expression, ["x", "y"], route.level);
      return {
        kind: "plot",
        plot_kind: "implicit",
        title,
        text: text3,
        expression: route.expression,
        level: route.level,
        samples: 80,
        x_range: viewport.x,
        y_range: viewport.y
      };
    }
    const samples = 12;
    const object2 = route.kind === "surface" ? (() => {
      const viewport = selectionSurfaceDomain(route.expression);
      return {
        as: "selected-function",
        kind: "surface",
        expression: route.expression,
        x_range: viewport.x,
        y_range: viewport.y,
        samples,
        color: "teal"
      };
    })() : buildImplicitSurfaceObject({
      as: "selected-function",
      expression: route.expression,
      level: route.level,
      samples,
      color: "teal"
    });
    return {
      kind: "scene3d",
      title,
      text: text3,
      content: {
        title,
        fallback: text3,
        axes: true,
        camera: { yaw: 0.65, pitch: 0.45, zoom: 1 },
        objects: [object2]
      }
    };
  };
  try {
    if (responseKind === "board_writing") {
      if (!boardWriting || !["check-and-suggest", "custom-question"].includes(input.tool_id)) {
        throw new Error("Client does not support board writing");
      }
      const lines = text3.split(/\r?\n/u).map((line) => line.trim()).filter(Boolean);
      if (!lines.length || lines.length > 8 || text3.length > 500 || lines.some((line) => line.length > 160 || /[\u0000-\u0008\u000b-\u001f\u007f]/u.test(line))) {
        throw new Error("Board writing exceeds text budget");
      }
      response = { kind: "board_writing", title, text: text3, lines };
    } else if (responseKind === "plot" || responseKind === "implicit_plot") {
      if (!visualizationRequested) {
        throw new Error(`${input.tool_id} cannot return a plot response`);
      }
      response = buildRoutedVisualization();
    } else if (responseKind === "scene3d") {
      if (!visualizationRequested) {
        throw new Error(`${input.tool_id} cannot return a 3D response`);
      }
      response = buildRoutedVisualization();
    } else if (responseKind === "unsupported") {
      const corrected = visualizationRequested ? buildRoutedVisualization() : void 0;
      if (corrected && corrected.kind !== "unsupported") {
        response = corrected;
      } else {
        const reasonCode = nonEmpty("reason_code");
        if (!["unreadable_expression", "unsupported_variables", "unsupported_representation", "unsafe_complexity"].includes(reasonCode)) {
          throw new Error("reason_code is invalid");
        }
        response = corrected && alternatives.length === 0 ? corrected : unsupported(reasonCode, text3, failureAlternatives[reasonCode]);
      }
    } else if (responseKind === "explanation") {
      const explanationFailure = confidence === "low" ? "unreadable_expression" : "unsupported_representation";
      response = visualizationRequested && input.tool_id === "generate-plot" ? unsupported(explanationFailure, text3, failureAlternatives[explanationFailure]) : {
        kind: "explanation",
        title,
        text: text3,
        ...items.length > 0 ? { items } : {}
      };
    } else {
      throw new Error("response_kind is invalid");
    }
  } catch (error) {
    if (!visualizationRequested || responseKind === "board_writing") throw error;
    const reasonCode = failureReasonCode(error);
    response = unsupported(
      reasonCode,
      `\u5DF2\u7ECF\u8BC6\u522B\u5230\u201C${interpretationContent}\u201D\uFF0C\u4F46\u5F53\u524D\u65E0\u6CD5\u5B89\u5168\u5730\u751F\u6210\u5B83\u7684\u56FE\u50CF\u3002`,
      failureAlternatives[reasonCode]
    );
  }
  return {
    profile: "octos.selection-enhancement",
    version: response.kind === "board_writing" ? "0.3" : "0.2",
    turn_id: input.turn_id,
    created_at: (/* @__PURE__ */ new Date()).toISOString(),
    source: structuredClone(input.source),
    board: structuredClone(input.board),
    tool_id: input.tool_id,
    interpretation: {
      kind,
      content: interpretationContent,
      confidence
    },
    response
  };
}
async function generateSelectionEnhancement(client, input) {
  const media = input.tool_id === "generate-plot" && hasReusableSelectionRecognition(input) ? void 0 : await selectionModelMedia(input);
  const raw = await callStructuredModel(client, {
    label: "selection-enhancement",
    turnId: input.turn_id,
    maxTokens: Math.min(client.maxTokens, 4096),
    responseSchema: selectionResponseSchema(input),
    media,
    systemPrompt: selectionRequestSystemPrompt(input),
    thinkingLevel: selectionThinkingOverride(input, client),
    prompt: JSON.stringify({
      learner_request: input.learner_request,
      tool_id: input.tool_id,
      selected_recognition: {
        kind: input.content_hint,
        content: input.recognized_content ?? null,
        confidence: input.recognition_confidence ?? null
      },
      attached_selection_image: Boolean(media),
      lesson_title: input.lesson_title ?? null,
      board_summary: input.board_summary ?? null,
      selected_board_context: input.board.targets.map((target) => ({
        kind: target.kind,
        label: target.label,
        value: target.value
      }))
    })
  });
  return parseSelectionModelResponse(raw, input);
}
function parseSelectionClassificationResponse(raw) {
  let value;
  try {
    value = JSON.parse(raw);
  } catch (error) {
    throw new Error(`Selection classification is not JSON: ${error.message}`);
  }
  if (!isRecord2(value)) throw new Error("Selection classification must be an object");
  const kind = value.kind;
  if (kind !== "text" && kind !== "math" && kind !== "geometry" && kind !== "data" && kind !== "unknown") {
    throw new Error("Selection classification kind is invalid");
  }
  const confidence = value.confidence;
  if (confidence !== "high" && confidence !== "medium" && confidence !== "low") {
    throw new Error("Selection classification confidence is invalid");
  }
  const content = typeof value.content === "string" ? value.content.trim() : "";
  if (kind !== "unknown" && confidence !== "low" && !content) {
    throw new Error("Confident selection classification requires recognized content");
  }
  return { kind, content, confidence };
}
async function classifySelection(client, input) {
  const media = await selectionModelMedia(input);
  if (!media) throw new Error("Selection classification requires an image");
  const raw = await callStructuredModel(client, {
    label: "selection-classification",
    turnId: input.turn_id,
    maxTokens: Math.min(client.maxTokens, 512),
    responseSchema: SELECTION_CLASSIFICATION_RESPONSE_SCHEMA,
    media,
    systemPrompt: `\u4F60\u53EA\u5206\u7C7B\u5B66\u751F\u660E\u786E\u9009\u4E2D\u7684\u539F\u59CB\u7B14\u8FF9\uFF0C\u4E0D\u56DE\u7B54\u95EE\u9898\uFF0C\u4E0D\u751F\u6210\u8BFE\u7A0B\u6216\u767D\u677F\u5185\u5BB9\u3002kind \u53EA\u80FD\u662F text\u3001math\u3001geometry\u3001data\u3001unknown\u3002\u53EA\u6709\u56FE\u7247\u4E2D\u80FD\u76F4\u63A5\u8BFB\u5230\u6570\u5B66\u8868\u8FBE\u5F0F\u3001\u65B9\u7A0B\u6216\u51FD\u6570\u65F6\u624D\u8FD4\u56DE math\uFF1B\u5706\u5708\u3001\u4E0B\u5212\u7EBF\u3001\u7BAD\u5934\u3001\u5957\u7D22\u6216\u666E\u901A\u66F2\u7EBF\u6807\u8BB0\u4E0D\u662F\u6570\u5B66\u8868\u8FBE\u5F0F\u3002content \u53EA\u6284\u5F55\u56FE\u7247\u4E2D\u53EF\u8FA8\u8BA4\u7684\u5185\u5BB9\uFF0C\u4E0D\u5229\u7528\u8BFE\u7A0B\u80CC\u666F\u8865\u5168\u3002\u65E0\u6CD5\u53EF\u9760\u8FA8\u8BA4\u65F6\u8FD4\u56DE unknown \u6216 low confidence\u3002\u4F60\u770B\u4E0D\u5230\u4E5F\u4E0D\u5F97\u731C\u6D4B\u7B14\u8FF9\u4E0B\u65B9\u7684\u8BFE\u7A0B\u5185\u5BB9\u3002`,
    prompt: JSON.stringify({
      source_id: input.source.source_id,
      selected_ink_image: "authoritative"
    })
  });
  return parseSelectionClassificationResponse(raw);
}
function outputPath(input) {
  const workDirectory = resolve2(process.env.OCTOS_WORK_DIR?.trim() || process.cwd());
  const path = resolve2(workDirectory, "study", "oll", `${input.turn_id}.octos-lesson.json`);
  if (!path.startsWith(`${workDirectory}${sep}`) || !isAbsolute(path)) {
    throw new Error("Resolved OLL output path escapes OCTOS_WORK_DIR");
  }
  return path;
}
function partialOutputPath(input, part) {
  const workDirectory = resolve2(process.env.OCTOS_WORK_DIR?.trim() || process.cwd());
  const suffix = String(part).padStart(3, "0");
  const path = resolve2(
    workDirectory,
    "study",
    "oll",
    `${input.turn_id}.part-${suffix}.octos-lesson.json`
  );
  if (!path.startsWith(`${workDirectory}${sep}`) || !isAbsolute(path)) {
    throw new Error("Resolved partial OLL output path escapes OCTOS_WORK_DIR");
  }
  return path;
}
function safeError(error) {
  if (error instanceof Error) {
    const cause = error.cause && typeof error.cause === "object" ? error.cause : void 0;
    const causeMessage = typeof cause?.message === "string" ? cause.message : void 0;
    const causeCode = typeof cause?.code === "string" ? cause.code : void 0;
    return [
      error.message,
      causeCode ? `cause=${causeCode}` : "",
      causeMessage && causeMessage !== error.message ? causeMessage : ""
    ].filter(Boolean).join(": ").slice(0, MAX_ERROR_BODY_LENGTH);
  }
  return String(error).slice(0, MAX_ERROR_BODY_LENGTH);
}
function emit(payload) {
  process.stdout.write(`${JSON.stringify(payload)}
`);
}
function emitArtifactProgress(path, kind, message) {
  process.stderr.write(`${JSON.stringify({ type: "artifact", path, kind, message })}
`);
}
async function runTopicAnalysis(rawInput, startedAt) {
  const input = parseTopicAnalysisInput(rawInput);
  const asciiDetail = (error) => safeError(error).replace(/[^\x20-\x7e]/g, "?").slice(0, 200) || void 0;
  let submitted;
  try {
    const client = await createStructuredModelClient(resolveLessonModelRoute());
    const result = await analyzeTopics(input.input, loadTopicCatalog(), (request) => callStructuredModel(client, {
      ...request,
      turnId: `topics-${input.job_id.slice(0, 16)}`,
      maxTokens: Math.min(client.maxTokens, 8192)
    }));
    submitted = await submitTopicAnalysis(input, { result });
  } catch (error) {
    const failure = error instanceof TopicAnalysisError ? error.failure : "analysis-turn-failed";
    stageLog({ stage: "topic-analysis", status: "failed", failure, elapsed_ms: Date.now() - startedAt });
    submitted = await submitTopicAnalysis(input, { failure, detail: asciiDetail(error) });
    emit({ success: false, output: `Topic analysis failed (${failure}); the history service ${submitted.recorded ? "recorded it" : `did not record it (${submitted.status})`}.` });
    process.exitCode = 1;
    return;
  }
  stageLog({ stage: "topic-analysis", status: submitted.recorded ? "completed" : "rejected", http_status: submitted.status, elapsed_ms: Date.now() - startedAt });
  emit({ success: submitted.recorded, output: submitted.recorded ? "Topic analysis submitted to the history service." : `The history service did not accept the analysis (${submitted.status}${submitted.error ? `: ${submitted.error}` : ""}).` });
  if (!submitted.recorded) process.exitCode = 1;
}
var TEACH_TOOLS = [TEACH_OCTO_QUESTION_TOOL, TEACH_INK_TO_MATH_TOOL, TEACH_REVIEW_TOOL];
async function runTeachTool(client, tool, rawInput) {
  if (tool === TEACH_OCTO_QUESTION_TOOL) {
    const input2 = parseOctoQuestionInput(rawInput);
    const raw2 = await callStructuredModel(client, {
      label: "teach-octo-question",
      turnId: input2.turn_id,
      maxTokens: Math.min(client.maxTokens, 512),
      responseSchema: OCTO_QUESTION_SCHEMA,
      ...octoQuestionPrompts(input2)
    });
    return { label: "teach-octo-question", metadata: { teach_octo_question: parseOctoQuestion(raw2) } };
  }
  if (tool === TEACH_INK_TO_MATH_TOOL) {
    const input2 = parseInkToMathInput(rawInput);
    const media = await workspaceImageMedia(input2.ink_media, "ink_media");
    if (!media) throw new Error("Ink to math requires an image");
    const raw2 = await callStructuredModel(client, {
      label: "teach-ink-to-math",
      turnId: input2.turn_id,
      maxTokens: Math.min(client.maxTokens, 512),
      responseSchema: INK_TO_MATH_SCHEMA,
      media,
      ...inkToMathPrompts(input2)
    });
    return { label: "teach-ink-to-math", metadata: { teach_ink_to_math: parseInkToMath(raw2) } };
  }
  const input = parseReviewInput(rawInput);
  const raw = await callStructuredModel(client, {
    label: "teach-review",
    turnId: input.turn_id,
    maxTokens: Math.min(client.maxTokens, 2048),
    responseSchema: REVIEW_SCHEMA,
    ...reviewPrompts(input)
  });
  return { label: "teach-review", metadata: { teach_review: parseReview(raw, input) } };
}
async function main() {
  const startedAt = Date.now();
  const invokedTool = process.argv[2];
  try {
    const tools = [TOOL_NAME, SELECTION_TOOL_NAME, SELECTION_CLASSIFICATION_TOOL_NAME, TOPIC_ANALYSIS_TOOL_NAME, ...TEACH_TOOLS];
    if (!invokedTool || !tools.includes(invokedTool)) {
      throw new Error(`Unknown tool '${invokedTool ?? ""}'. Expected one of: ${tools.join(", ")}`);
    }
    const chunks = [];
    for await (const chunk of process.stdin) chunks.push(Buffer.from(chunk));
    const rawInput = Buffer.concat(chunks).toString("utf8");
    if (invokedTool === TOPIC_ANALYSIS_TOOL_NAME) {
      await runTopicAnalysis(rawInput, startedAt);
      return;
    }
    const traceTurnId = traceTurnIdFromRawInput(rawInput);
    if (traceTurnId) beginStageTrace(traceTurnId, invokedTool, startedAt);
    const route = resolveLessonModelRoute();
    if (TEACH_TOOLS.includes(invokedTool)) {
      const client = await createStructuredModelClient(route);
      const { label, metadata } = await runTeachTool(client, invokedTool, rawInput);
      stageLog({ stage: label, turn_id: traceTurnId, status: "completed", elapsed_ms: Date.now() - startedAt });
      emit({ success: true, output: "Learner teaching help generated.", structured_metadata: metadata });
      return;
    }
    if (invokedTool === SELECTION_CLASSIFICATION_TOOL_NAME) {
      const input2 = parseSelectionClassificationInput(rawInput);
      const client = await createStructuredModelClient(route);
      const classification = await classifySelection(client, input2);
      stageLog({
        stage: "selection-classification",
        turn_id: input2.turn_id,
        status: "completed",
        elapsed_ms: Date.now() - startedAt
      });
      emit({
        success: true,
        output: "Selection classified without modifying source ink.",
        structured_metadata: { selection_classification: classification }
      });
      return;
    }
    if (invokedTool === SELECTION_TOOL_NAME) {
      const input2 = parseSelectionToolInput(rawInput);
      const client = await createStructuredModelClient(route);
      const artifact = await generateSelectionEnhancement(client, input2);
      const artifactPath = selectionOutputPath(input2);
      await mkdir(dirname2(artifactPath), { recursive: true });
      await writeFile(artifactPath, `${JSON.stringify(artifact, null, 2)}
`, "utf8");
      stageLog({
        stage: "selection-enhancement",
        turn_id: input2.turn_id,
        status: "completed",
        elapsed_ms: Date.now() - startedAt
      });
      emit({
        success: true,
        output: "Selection enhancement generated without modifying the source ink.",
        files_to_send: [artifactPath]
      });
      return;
    }
    const input = parseCompleteLessonInput(rawInput);
    if (input.client_timing) {
      stageLog({
        stage: "lesson-client-timing",
        turn_id: input.turn_id,
        status: "received",
        client_timing: input.client_timing,
        skill_process_started_at_epoch_ms: startedAt
      });
    }
    const modelRouter = await createStructuredModelRouter(route);
    const lessonImageMedia = input.request_source === "current_image" ? await workspaceImageMedia(input.camera_media, "camera_media") : input.request_source === "ink_selection" ? await workspaceImageMedia(input.selection_media, "selection_media") : void 0;
    if (input.request_source === "current_image" && !lessonImageMedia) {
      throw new ToolExecutionError(
        "LESSON_CAMERA_IMAGE_REQUIRED",
        "Camera lesson generation requires one camera image"
      );
    }
    if (input.request_source === "ink_selection" && !lessonImageMedia) {
      throw new ToolExecutionError(
        "LESSON_SELECTION_IMAGE_REQUIRED",
        "Selection lesson generation requires one selection image"
      );
    }
    let publishedParts = 0;
    const publishPrefix = async (prefix, part) => {
      const artifactPath = partialOutputPath(input, part);
      await mkdir(dirname2(artifactPath), { recursive: true });
      await writeFile(artifactPath, `${JSON.stringify(prefix, null, 2)}
`, "utf8");
      publishedParts += 1;
      emitArtifactProgress(
        artifactPath,
        "oll_lesson_part",
        `part=${part} elapsed_ms=${Date.now() - startedAt}`
      );
      stageLog({
        stage: "lesson-prefix-published",
        turn_id: input.turn_id,
        status: "completed",
        completed_sections: part,
        elapsed_ms: Date.now() - startedAt
      });
    };
    {
      const { generateLessonPlanWithModel, INSTALLED_PLUGINS } = await import("./lesson-plan.js");
      let pluginSignal;
      try {
        pluginSignal = checkPluginIds(input.plugin_signal, INSTALLED_PLUGINS);
      } catch (error) {
        if (error instanceof PluginSignalError) throw new ToolExecutionError(error.code, error.message);
        throw error;
      }
      const subjectScope = shadowScope(pluginSignal, INSTALLED_PLUGINS);
      stageLog({
        stage: "lesson-plan-generation",
        turn_id: input.turn_id,
        status: "started",
        mode: "lesson_plan",
        plugin_signal: subjectScope
      });
      const generatedLessonPlan = await generateLessonPlanWithModel(
        (request) => modelRouter.call({
          label: request.label,
          turnId: request.turn_id,
          systemPrompt: request.system_prompt,
          prompt: request.prompt,
          responseSchema: request.response_schema,
          lessonPlanPart: request.part,
          lessonPlanSection: request.section,
          lessonPlanAttempt: request.attempt,
          ...request.include_camera_media ? { media: lessonImageMedia } : {}
        }),
        {
          turn_id: input.turn_id,
          learner_request: input.learner_request,
          language: input.language,
          learner_context: input.learner_context,
          tutor_context: input.tutor_context,
          teacher_profile: input.teacher_profile,
          learner_background: input.learner_background,
          current_lesson: input.current_lesson,
          teacher_experiences: input.teacher_experiences,
          input_modality: input.input_modality,
          camera_input: input.request_source === "current_image",
          selection_input: input.request_source === "ink_selection"
        },
        {
          compile: { language: input.language },
          on_outline_ready: (event) => stageLog({
            stage: "lesson-plan-outline-ready",
            turn_id: input.turn_id,
            status: "completed",
            ...event,
            elapsed_ms: Date.now() - startedAt
          }),
          on_rejected_part: (event) => {
            modelRouter.rejectLastResponse();
            stageLog({
              stage: "lesson-plan-local-rejection",
              turn_id: input.turn_id,
              ...event
            });
          },
          on_program_adjustment: (event) => stageLog({
            stage: "lesson-plan-program-adjustment",
            turn_id: input.turn_id,
            status: "applied",
            ...event
          }),
          on_playable_prefix: async ({ completed_sections, compiled }) => {
            await publishPrefix(compiled.lesson, completed_sections);
          }
        }
      );
      if ("disposition" in generatedLessonPlan) {
        stageLog({
          stage: "lesson-plan-generation",
          turn_id: input.turn_id,
          status: "completed",
          mode: "lesson_plan",
          disposition: generatedLessonPlan.disposition,
          model_calls: generatedLessonPlan.model_calls,
          elapsed_ms: Date.now() - startedAt
        });
        emit({
          success: true,
          output: generatedLessonPlan.learner_response,
          structured_metadata: {
            lesson_disposition: generatedLessonPlan.disposition,
            learner_response: generatedLessonPlan.learner_response
          },
          authoring_strategy: "lesson_plan",
          lesson_plan_model_calls: generatedLessonPlan.model_calls,
          published_parts: 0,
          ...input.request_source === "self_contained" ? {} : { request_source: input.request_source }
        });
        return;
      }
      const artifactPath = outputPath(input);
      await mkdir(dirname2(artifactPath), { recursive: true });
      await writeFile(artifactPath, `${JSON.stringify(generatedLessonPlan.lesson, null, 2)}
`, "utf8");
      stageLog({
        stage: "lesson-plan-generation",
        turn_id: input.turn_id,
        status: "completed",
        mode: "lesson_plan",
        sections: generatedLessonPlan.lesson.steps.length,
        model_calls: generatedLessonPlan.model_calls,
        plugins: generatedLessonPlan.plugins,
        plugin_source: subjectScope.plugin_source,
        plugins_outside_scope: pluginsOutsideScope(subjectScope, generatedLessonPlan.plugins),
        elapsed_ms: Date.now() - startedAt
      });
      emit({
        success: true,
        output: `Validated OLL lesson generated through the Lesson Plan path with ${route.model}.`,
        files_to_send: [artifactPath],
        authoring_strategy: "lesson_plan",
        lesson_plan_model_calls: generatedLessonPlan.model_calls,
        lesson_plan_sections: generatedLessonPlan.lesson.steps.length,
        lesson_plan_plugins: generatedLessonPlan.plugins,
        structured_metadata: { lesson_plan_plugins: generatedLessonPlan.plugins },
        published_parts: publishedParts,
        ...generatedLessonPlan.camera_observation ? input.request_source === "ink_selection" ? { selection_observation: generatedLessonPlan.camera_observation } : { camera_observation: generatedLessonPlan.camera_observation } : {},
        ...input.request_source === "self_contained" ? {} : { request_source: input.request_source }
      });
      return;
    }
  } catch (error) {
    const message = safeError(error);
    stageLog({
      stage: "lesson-generation",
      status: "failed",
      elapsed_ms: Date.now() - startedAt,
      error_code: error instanceof ToolExecutionError ? error.code : invokedTool === SELECTION_CLASSIFICATION_TOOL_NAME ? "SELECTION_CLASSIFICATION_FAILED" : invokedTool === SELECTION_TOOL_NAME ? "SELECTION_ENHANCEMENT_FAILED" : "LESSON_GENERATION_FAILED"
    });
    process.stderr.write(`learning-coach: ${message}
`);
    const terminalForTurn = invokedTool === TOOL_NAME;
    const errorCode = error instanceof ToolExecutionError ? error.code : invokedTool === SELECTION_CLASSIFICATION_TOOL_NAME ? "SELECTION_CLASSIFICATION_FAILED" : invokedTool === SELECTION_TOOL_NAME ? "SELECTION_ENHANCEMENT_FAILED" : "LESSON_GENERATION_FAILED";
    emit({
      success: false,
      error_code: errorCode,
      output: terminalForTurn ? "\u8FD9\u6B21\u8BFE\u7A0B\u6CA1\u6709\u751F\u6210\u6210\u529F\uFF0C\u8BF7\u7A0D\u540E\u91CD\u8BD5\u3002" : message,
      structured_metadata: {
        error_code: errorCode,
        ...terminalForTurn ? { retryable: false, do_not_retry_same_turn: true } : {}
      },
      ...terminalForTurn ? { retryable: false, do_not_retry_same_turn: true } : {}
    });
    process.exitCode = 1;
  }
}
if (process.argv[1] && import.meta.url === pathToFileURL(realpathSync(process.argv[1])).href) {
  void main();
}
