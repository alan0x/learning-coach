function bindingCapabilitiesForNodeKind(kind) {
  if (Object.hasOwn(OLL_BINDING_CAPABILITIES, kind)) {
    return OLL_BINDING_CAPABILITIES[kind];
  }
  return EMPTY_BINDING_COLLECTIONS;
