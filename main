      brkFirst: (step, k, empties, hi, lo) => `${step}: not enough to take away ${k}. ` + (empties.length ? `The ${list(empties.map((n) => n.toLowerCase()), false)} ${empties.length > 1 ? "are" : "is"} empty, so break one ${hi} into ten ${lo}s.` : `Break one ${hi} into ten ${lo}s.`),
      brkNext: (hi, lo) => `Break one ${hi} into ten ${lo}s.`,
      take: (step, k) => `${step}: take away ${k}.`,
      nothing: (step) => `${step}: nothing to take away.`
    }
  },
  "zh-CN": {
