var SELECTION_CUSTOM_QUESTION_SYSTEM_PROMPT = `\u9ED8\u8BA4 response_kind=explanation\uFF0C\u76F4\u63A5\u5B8C\u6210 learner_request\u3002\u6539\u5199\u3001\u7EA0\u9519\u3001\u8F6C\u5199\u6216\u201C\u6539\u6210\u53EF\u4EE5\u7ED8\u56FE\u7684\u5F62\u5F0F\u201D\u53EA\u7ED9\u7B80\u77ED\u8BF4\u660E\u4E0E\u516C\u5F0F\uFF0C\u4E0D\u4E3B\u52A8\u7ED8\u56FE\uFF1B\u7B49\u4EF7\u6574\u7406\u4E0D\u662F\u7EA0\u9519\uFF0C\u539F\u5F0F\u6B63\u786E\u5C31\u5982\u5B9E\u8BF4\u660E\uFF0C\u4E0D\u4E3A\u4F5C\u56FE\u6539\u53D8\u6570\u5B66\u542B\u4E49\u3002
