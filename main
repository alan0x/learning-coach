var PLACE_VALUE_TIMES_TEN_CARD = Object.freeze({
  kind: PLACE_VALUE_TIMES_TEN_KIND,
  taps: PLACE_VALUE_TIMES_TEN_TAPS,
  places: PLACE_VALUE_TIMES_TEN_TAP_PLACES,
  cardFields: PLACE_VALUE_TIMES_TEN_CARD_BINDINGS,
  practiceFields: PLACE_VALUE_TIMES_TEN_PROBLEM_FIELDS,
  demonstration: PLACE_VALUE_TIMES_TEN_DEMONSTRATION,
  fieldsAtOnce: true,
  validateContent: (raw, path, fail, options) => {
    validatePlaceValueTimesTenContent(raw, path, fail);
    const rows = raw;
    if (options?.start && (rows.moved_once || rows.moved_twice))
      fail(`${path}/${rows.moved_once ? "moved_once" : "moved_twice"}`, "A card opens fresh: no row moved (moved_once and moved_twice are 0)");
  },
  state: placeValueTimesTenState,
  apply: (state, tap) => {
    const result = applyPlaceValueTimesTenTap(state, { tap: tap.kind, row: tap.place });
    return result.ok ? { ok: true, state: result.state } : { ok: false, reason: result.reason };
  },
  refusalText(reason, place, language, state) {
    const lang = language === "zh-CN" ? "zh-CN" : "en-US";
    const tap = TIMES_TEN_TAP_OF_REASON[reason];
    if (state && tap) {
      const text3 = placeValueTimesTenRefusalText(state, { tap, row: place }, lang);
      if (text3)
        return text3;
    }
    const words2 = PLACE_VALUE_TIMES_TEN_WORDS[lang];
    return reason === "demonstrating" ? words2.refusal.demonstrating : words2.other;
  },
  language: placeValueTimesTenLanguage,
  // A row set is a card-level field: its change is named by the field, at the card's first place.
  changes: (before, after) => placeValueTimesTenChanges(before, after).map(({ field, before: from, after: to }) => ({ place: 0, field, before: from, after: to })),
  tapFields(content) {
    const apart = content?.apart === 2 ? 2 : 1;
    return placeValueTimesTenRowFields(apart).map((field) => ({ place: 0, field, min: 0, max: PLACE_VALUE_TIMES_TEN_MAX_ROWS }));
  },
  fieldTarget: (_content, _place, field) => field,
  contentAt: timesTenContentAt,
  /** A practice chart starts fresh: counted in at its own start unit, no row moved. */
  validateStart(state, fail) {
    const fault = placeValueTimesTenStateStartFault(state);
    if (fault)
      fail(fault);
  },
  answers(state, language) {
    const p = state.problem;
    if (!p.n)
      return void 0;
    const lang = language === "zh-CN" ? "zh-CN" : "en-US";
    const values = placeValueTimesTenAnswerParts(p, lang).flatMap((part) => "blank" in part ? [part.blank.answer] : []);
    return { values, text: placeValueTimesTenDoneText(p, lang).replace(/^✓ /u, "") };
  },
  facts: Object.freeze({
    /**
     * Every row has reached the target: the chart holds the amount in the target unit (a times pair: ten whole
     * copies). Judged on each tap, so the task ends on the tap that completes the chart; the typed answer is a
     * task of its own after it.
     */
    complete: {
      keys: [],
      judgedOnTap: true,
      read: (_completion, state) => {
        const actual = placeValueTimesTenComplete(state) ? 1 : 0;
        return { actual, target: 1, succeeded: actual === 1 };
      },
      /**
       * The one finished chart of the task's own problem (every tap order ends on it), computed, never read from a
       * logged pile: the task's numbers, "counted in" at the task's own start unit, every row moved.
       */
      donePile({ content, startValue }) {
        const bound = boundTargets(content);
        const number = (field) => bound.has(field) ? startValue(bound.get(field)) : Number(content[field]);
        const own = { ...content, amount: number("amount"), target: number("target") };
        const problem = placeValueTimesTenContentProblem(own);
        if ("fault" in problem)
          return void 0;
        const rows = 2 ** problem.n - 1;
        const result = {};
        for (const [target, alias] of bound) {
          if (target === "amount" || target === "target")
            result[alias] = number(target);
          else if (target === "counted_in")
            result[alias] = problem.start;
          else if (target === "moved_once" || target === "moved_twice")
            result[alias] = rows;
        }
        return result;
      }
    }
  })
});
var compareContentAt = (content, value) => {
  const at = structuredClone(content);
  delete at.bindings;
  for (const field of PLACE_VALUE_COMPARE_BINDINGS) {
    const v = value(field);
    if (v !== void 0)
      at[field] = v;
  }
  return at;
};
var comparePair = (content) => {
  const pair = placeValueCompareContentPair(content);
  return "fault" in pair ? void 0 : pair;
};
var COMPARE_NO_PAIR = `is a ${PLACE_VALUE_COMPARE_KIND} card's demonstration, but the card's numbers are not a pair it takes`;
var COMPARE_FORWARD = wholeForwardDemonstration({
  field: PLACE_VALUE_COMPARE_DEMONSTRATION_FIELD,
  counts: `counts the columns a ${PLACE_VALUE_COMPARE_KIND} card's demonstration has judged from the left, then one more for the sign`,
  tapState: "the learner's judgements or sign",
  shows: "(compared: the columns judged from the left, then one more for the sign), and the program judges each column and chooses the sign",
  fresh: "chart",
  opensAtStart: true,
  start: () => 0,
  range: (content) => {
    const pair = comparePair(content);
    return { min: 0, max: pair ? placeValueCompareDemoEnd(pair) : PLACE_VALUE_COMPARE_MAX_COLUMNS + 1 };
  },
  next(content, value) {
    const pair = comparePair(content);
    return pair ? placeValueCompareComparedNext(pair, value) : COMPARE_NO_PAIR;
  }
});
var PLACE_VALUE_COMPARE_DEMONSTRATION = Object.freeze({
  ...COMPARE_FORWARD,
  refuseStep(content, from, to) {
    const pair = comparePair(content);
    if (!pair)
      return COMPARE_NO_PAIR;
    const refusal = COMPARE_FORWARD.refuseStep(content, from, to);
    if (refusal !== void 0)
      return refusal;
    const end = placeValueCompareDemoEnd(pair);
    return to > end ? `${placeValueCompareComparedMeaning(pair)}, not ${to}; ${placeValueCompareComparedNext(pair, from)}` : void 0;
  },
  refuseReplay(content, value) {
    const pair = comparePair(content);
    if (!pair)
      return COMPARE_NO_PAIR;
    const refusal = COMPARE_FORWARD.refuseReplay(content, value);
    if (refusal !== void 0)
      return refusal;
    return value < 0 || value > placeValueCompareDemoEnd(pair) ? `${placeValueCompareComparedMeaning(pair)}, not ${value}` : void 0;
  },
  outside(content, value) {
    const pair = comparePair(content);
    return pair ? `${placeValueCompareComparedMeaning(pair)}, not ${value}` : COMPARE_NO_PAIR;
  }
});
var PLACE_VALUE_COMPARE_CARD = Object.freeze({
  kind: PLACE_VALUE_COMPARE_KIND,
  taps: PLACE_VALUE_COMPARE_TAPS,
  places: PLACE_VALUE_COMPARE_TAP_PLACES,
  cardFields: PLACE_VALUE_COMPARE_CARD_BINDINGS,
  practiceFields: PLACE_VALUE_COMPARE_PROBLEM_FIELDS,
  demonstration: PLACE_VALUE_COMPARE_DEMONSTRATION,
  fieldsAtOnce: true,
  validateContent: (raw, path, fail, options) => validatePlaceValueCompareContent(raw, path, fail, options?.start ? { start: true } : {}),
  state: placeValueCompareState,
  apply: (state, tap) => {
    const result = applyPlaceValueCompareTap(state, { tap: tap.kind, place: tap.place });
    return result.ok ? { ok: true, state: result.state } : { ok: false, reason: result.reason };
  },
  refusalText(reason, place, language, state) {
    const lang = language === "zh-CN" ? "zh-CN" : "en-US";
    const words2 = PLACE_VALUE_COMPARE_WORDS[lang];
    if (reason === "demonstrating")
      return words2.refusal.demonstrating;
    if (!state)
      return reason === "not_decided" ? words2.lock : words2.other;
    const tap = place >= 10 ? "sign" : reason === "not_same" ? "same" : reason === "no_judgement" ? "column" : "different";
    return placeValueCompareRefusalText(state, { tap, place }, lang) || words2.other;
  },
  language: placeValueCompareLanguage,
  // The learner's fields are card-level: a change is named by the field, at the card's first place.
  changes: (before, after) => placeValueCompareChanges(before, after).map(({ field, before: from, after: to }) => ({ place: 0, field, before: from, after: to })),
  tapFields: () => [{ place: 0, field: "marked", min: 0, max: PLACE_VALUE_COMPARE_MAX_COLUMNS }, { place: 0, field: "signed", min: 0, max: 1 }],
  fieldTarget: (_content, _place, field) => field,
  contentAt: compareContentAt,
  /** A practice chart starts fresh: a pair the card takes, nothing compared, judged or signed. */
  validateStart(state, fail) {
    const fault = placeValueCompareStartFault(state);
    if (fault)
      fail(fault);
  },
  facts: Object.freeze({
    /**
     * The true sign is chosen (the chart decided first). Judged on each tap, so the task ends on the tap that
     * chooses it; there is no "done".
     */
    complete: {
      keys: [],
      judgedOnTap: true,
      read: (_completion, state) => {
        const actual = placeValueCompareComplete(state) ? 1 : 0;
        return { actual, target: 1, succeeded: actual === 1 };
      },
      /**
       * The one finished card of the task's own pair (every tap order ends on it), computed, never read from a
       * logged pile: the task's numbers, nothing demonstrated, every column to the deciding one judged, the sign chosen.
       */
      donePile({ content, startValue }) {
        const bound = boundTargets(content);
        const number = (field) => bound.has(field) ? startValue(bound.get(field)) : content[field];
        const own = { ...content };
        for (const field of PLACE_VALUE_COMPARE_CARD_BINDINGS) {
          const v = number(field);
          if (v === void 0)
            delete own[field];
          else
            own[field] = v;
        }
        const pair = comparePair(own);
        if (!pair)
          return void 0;
        const final = placeValueCompareDemoSteps(pair).final;
        const result = {};
        for (const [target, alias] of bound) {
          if (target === "compared")
            result[alias] = 0;
          else if (target === "marked")
            result[alias] = final.marked;
          else if (target === "signed")
            result[alias] = 1;
          else
            result[alias] = number(target);
        }
        return result;
      }
    }
  })
});
