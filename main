var FRACTION_MODEL_PLUGIN_VERSION = "0.4.0";
var FRACTION_MODEL_BINDINGS = {
  fractions: ["numerator"]
};

// node_modules/octos-lesson-language/dist/packages/plugin-math/src/base-ten-trade.js
var BASE_TEN_TRADE_KIND = "base_ten_trade";
var BASE_TEN_TRADE_FEATURE = "plugin:math/base-ten-trade@1";
var BASE_TEN_TRADE_PLUGIN_VERSION = "0.5.0";
var BASE_TEN_TRADE_LANGUAGE_FEATURE = "plugin:math/base-ten-trade-language@1";
var BASE_TEN_TRADE_LANGUAGE_VERSION = "0.6.0";
var BASE_TEN_TRADE_SLIDER_FEATURE = "plugin:math/base-ten-trade-slider@1";
var BASE_TEN_TRADE_SLIDER_VERSION = "0.7.0";
var BASE_TEN_TRADE_LANGUAGES = ["en-US", "zh-CN"];
var BASE_TEN_TRADE_BINDINGS = {
  places: ["count", "tray"]
};
var BASE_TEN_TRADE_PLACES = ["ones", "tens", "hundreds"];
var BASE_TEN_TRADE_LIMITS = {
  /** The most of each place the mat draws (tens: 29 after a break, plus five trades from 59 ones). */
  drawn: [59, 34, 9],
  /** The most of each place a pile may start with. */
  start: [59, 19, 9],
  /** A break is refused if the place below would then hold more than this. */
  room: [59, 29],
  /** A tray holds exactly ten: the size of one unit of the next place (owner, 2026-11-22). */
  tray: 10
};
function record(value, path, fail) {
  if (!value || typeof value !== "object" || Array.isArray(value))
    fail(path, "Expected an object");
  return value;
}
function only(value, allowed, path, fail) {
  for (const key of Object.keys(value))
    if (!allowed.includes(key))
      fail(`${path}/${key}`, `Unknown base-ten trade field '${key}'`);
}
function text(raw, path, fail, max = 120) {
  if (raw !== void 0 && (typeof raw !== "string" || raw.length > max))
    fail(path, `Expected text of at most ${max} characters`);
}
function wholeNumber(raw, path, low, high, fail, what) {
  if (typeof raw !== "number" || !Number.isInteger(raw) || raw < low || raw > high)
    fail(path, `${what} is a whole number from ${low} to ${high}`);
  return raw;
}
var hasTray = (columns, p) => p >= 0 && p < columns - 1;
var valueOf = (counts) => counts.reduce((sum, count, p) => sum + count * 10 ** p, 0);
function validateBaseTenTradeContent(raw, path, fail, options = {}) {
  const content = record(raw, path, fail);
  only(content, ["title", "caption", "columns", "places", "bindings", "language"], path, fail);
  if (content.language !== void 0 && !BASE_TEN_TRADE_LANGUAGES.includes(content.language)) {
    fail(`${path}/language`, `A mat speaks ${BASE_TEN_TRADE_LANGUAGES.join(" or ")}`);
  }
  text(content.title, `${path}/title`, fail);
  text(content.caption, `${path}/caption`, fail, 480);
  const columns = content.columns;
  if (columns !== 2 && columns !== 3)
    fail(`${path}/columns`, "A mat has 2 columns (tens and ones) or 3 (hundreds, tens and ones)");
  if (!Array.isArray(content.places) || content.places.length !== columns) {
    fail(`${path}/places`, `A mat of ${columns} columns lists ${columns} places, ones first`);
  }
  const counts = [];
  const trays = [];
  for (const [p, item] of content.places.entries()) {
    const at = `${path}/places/${p}`;
    const place = record(item, at, fail);
    only(place, ["as", "count", "tray"], at, fail);
    if (place.as !== BASE_TEN_TRADE_PLACES[p])
      fail(`${at}/as`, `Place ${p + 1} is '${BASE_TEN_TRADE_PLACES[p]}' (places are listed ones first)`);
    const most2 = columns === 2 && p === 1 ? 9 : (options.boundValues ? BASE_TEN_TRADE_LIMITS.drawn : BASE_TEN_TRADE_LIMITS.start)[p];
    counts.push(wholeNumber(place.count, `${at}/count`, 0, most2, fail, `The count of ${place.as}`));
    if (hasTray(columns, p)) {
      trays.push(place.tray === void 0 ? 0 : wholeNumber(place.tray, `${at}/tray`, 0, BASE_TEN_TRADE_LIMITS.tray, fail, `The ${place.as} tray`));
    } else if (place.tray !== void 0) {
      fail(`${at}/tray`, `The ${place.as} have no tray: there is no column above them`);
    }
  }
  if (options.boundValues)
    return;
  for (const [p, tray] of trays.entries()) {
    if (tray > counts[p])
      fail(`${path}/places/${p}/tray`, `The ${BASE_TEN_TRADE_PLACES[p]} tray holds more than there are ${BASE_TEN_TRADE_PLACES[p]}`);
  }
  const most = columns === 2 ? 99 : 999;
  if (valueOf(counts) > most) {
    fail(`${path}/places`, columns === 2 ? "This pile makes a hundred or more: use 3 columns" : "This pile makes more than 9 hundreds after trading");
  }
}
function baseTenMat(raw) {
  const content = raw;
  const columns = content.columns === 3 ? 3 : 2;
  const whole = (value) => typeof value === "number" && Number.isFinite(value) ? Math.max(0, Math.round(value)) : 0;
  const places = Array.isArray(content.places) ? content.places : [];
  const counts = Array.from({ length: columns }, (_, p) => Math.min(whole(places[p]?.count), columns === 2 && p === 1 ? 9 : BASE_TEN_TRADE_LIMITS.drawn[p]));
  const trays = Array.from({ length: columns - 1 }, (_, p) => Math.min(whole(places[p]?.tray), counts[p], BASE_TEN_TRADE_LIMITS.tray));
  return { columns, counts, trays };
}
var set = (values, index, value) => values.map((x, i) => i === index ? value : x);
var loose = (mat, p) => mat.counts[p] - (hasTray(mat.columns, p) ? mat.trays[p] : 0);
function applyBaseTenTap(mat, tap) {
  const p = tap.place;
  if (!Number.isInteger(p) || p < 0 || p >= mat.columns)
    return { ok: false, reason: "no_tray" };
  if (tap.kind === "gather") {
    if (!hasTray(mat.columns, p))
      return { ok: false, reason: "no_tray" };
    if (mat.trays[p] >= BASE_TEN_TRADE_LIMITS.tray)
      return { ok: false, reason: "tray_full" };
    if (loose(mat, p) <= 0)
      return { ok: false, reason: "none_loose" };
    return { ok: true, mat: { ...mat, trays: set(mat.trays, p, mat.trays[p] + 1) } };
  }
  if (tap.kind === "ungather") {
    if (!hasTray(mat.columns, p))
      return { ok: false, reason: "no_tray" };
    if (mat.trays[p] <= 0)
      return { ok: false, reason: "tray_empty" };
    return { ok: true, mat: { ...mat, trays: set(mat.trays, p, mat.trays[p] - 1) } };
  }
  if (tap.kind === "make") {
    if (!hasTray(mat.columns, p))
      return { ok: false, reason: "no_tray" };
    if (mat.trays[p] === 0)
      return { ok: false, reason: "tray_empty" };
    if (mat.trays[p] !== BASE_TEN_TRADE_LIMITS.tray)
      return { ok: false, reason: "tray_not_ten" };
    const counts2 = set(set(mat.counts, p, mat.counts[p] - 10), p + 1, mat.counts[p + 1] + 1);
    return { ok: true, mat: { ...mat, counts: counts2, trays: set(mat.trays, p, 0) } };
  }
  if (p < 1)
    return { ok: false, reason: "no_tray" };
  if (loose(mat, p) <= 0)
    return { ok: false, reason: "none_loose" };
  if (mat.trays[p - 1] !== 0)
    return { ok: false, reason: "tray_not_empty" };
  if (mat.counts[p - 1] + 10 > BASE_TEN_TRADE_LIMITS.room[p - 1])
    return { ok: false, reason: "no_room" };
  const counts = set(set(mat.counts, p, mat.counts[p] - 1), p - 1, mat.counts[p - 1] + 10);
  return { ok: true, mat: { ...mat, counts, trays: set(mat.trays, p - 1, 10) } };
}
function baseTenTapReachable(mat) {
  const key = (state) => `${state.counts.join(",")}/${state.trays.join(",")}`;
  const seen = /* @__PURE__ */ new Set([key(mat)]);
  const found = [mat];
  const kinds = ["gather", "ungather", "make", "break"];
  for (let i = 0; i < found.length; i += 1) {
    for (let place = 0; place < mat.columns; place += 1) {
      for (const kind of kinds) {
        const result = applyBaseTenTap(found[i], { kind, place });
        if (!result.ok || seen.has(key(result.mat)))
          continue;
        seen.add(key(result.mat));
        found.push(result.mat);
      }
    }
  }
  return found;
}
function baseTenBoundField(raw, alias) {
  const content = raw;
  const places = Array.isArray(content?.places) ? content.places : [];
  for (const binding of Array.isArray(content?.bindings) ? content.bindings : []) {
    if (typeof binding?.target !== "string" || typeof binding.expression !== "string" || binding.expression.trim() !== alias)
      continue;
    const separator = binding.target.lastIndexOf(".");
    const name = binding.target.slice(0, separator);
    const field = binding.target.slice(separator + 1);
    const place = places.findIndex((item) => (item?.id ?? item?.as) === name);
    if (place >= 0 && (field === "count" || field === "tray"))
      return { place, field };
  }
  return void 0;
}
function baseTenSliderPlace(raw, alias) {
  const bound = baseTenBoundField(raw, alias);
  const columns = raw?.columns === 3 ? 3 : 2;
  return bound && bound.field === "count" && hasTray(columns, bound.place) ? bound.place : void 0;
}
function baseTenLanguage(raw) {
  return raw?.language === "zh-CN" ? "zh-CN" : "en-US";
}
