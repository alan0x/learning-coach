{
  "name": "learning-coach-skill",
  "version": "0.12.8",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/oll-contract.mjs check && esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --external:./lesson-plan-experimental.js --banner:js='#!/usr/bin/env node' --outfile=main && esbuild src/lesson-plan-api.ts --bundle --platform=node --format=esm --target=node20 --outfile=lesson-plan-experimental.js && chmod +x main",
    "oll:check": "node scripts/oll-contract.mjs check",
    "oll:sync": "node scripts/oll-contract.mjs sync",
    "test": "npm run build && node --test test/*.test.mjs",
    "contract:vertex": "npm run build && node scripts/check-vertex-schema-contract.mjs",
    "contract:lesson-plan-vertex": "node scripts/check-lesson-plan-vertex-schema.mjs",
    "eval:visual": "npm run build && node scripts/eval-visual-generation.mjs",
    "eval:lesson-plan": "node scripts/eval-lesson-plan-generation.mjs",
    "eval:lesson-paths": "npm run build && node scripts/compare-lesson-generation-paths.mjs"
  },
  "dependencies": {
    "octos-lesson-language": "git+https://github.com/alan0x/octos-lesson-language.git#4f8c1f0e28dbf1f41f456954462b167dd2844518"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
