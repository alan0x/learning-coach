{
  "note": "Fraction model judge cases (OLL decision 0021 §5 step 2: judge before recipe). Written for the probe, never taken from the question set: the fractions and wording are new. Each case's expectation is fixed before any run. `fractions` lists what the lesson's fraction card must show (numerator over denominator, in order unless `anyOrder`); `wholes`, `split`, `highlight`, `relation` and `smallestPart` (the denominator times the split: what each smallest piece is a part of the whole) are checked when given; `models` lists the models a teacher would accept. Near misses (`nearMiss`) are out of 0021's scope: the lesson must not draw a fraction card for them (`forbid`).",
  "cases": [
    {
      "id": "FM-01",
      "language": "en",
      "prompt": "My recipe says to use 2/5 of a bag of flour. Can you show me what 2/5 of the bag looks like?",
      "covers": "one fraction, bar",
      "expect": {
        "models": [
          "bar",
          "circle"
        ],
        "fractions": [
          {
            "numerator": 2,
            "denominator": 5
          }
        ]
      }
    },
    {
      "id": "FM-02",
      "language": "en",
      "prompt": "A pie is cut into 6 equal slices and we ate 5. Draw the pie and show the fraction we ate.",
      "covers": "one fraction, circle",
      "expect": {
        "models": [
          "circle"
        ],
        "fractions": [
          {
            "numerator": 5,
            "denominator": 6
          }
        ]
      }
    },
