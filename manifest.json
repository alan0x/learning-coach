{
  "name": "learning-coach",
  "version": "0.12.7",
  "author": "alan0x",
  "description": "Generate validated OLL whiteboard lessons for learning sessions",
  "timeout_secs": 300,
  "requires_network": true,
  "tools": [
    {
      "name": "oll_generate_lesson",
      "description": "After resolving the learner request to exactly one authoritative source, generate, validate, save, and deliver the OLL lesson. Use self_contained for a complete standalone request, current_image for a request grounded in the current frame, and explicit_board_follow_up only when the learner explicitly continues prior board work. Never use board history to fill an incomplete request.",
      "concurrency_class": "exclusive",
      "env": [
        "VERTEX_SA_JSON",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "VERTEX_BASE_URL",
        "OLL_MODEL",
        "OLL_TIMEOUT_MS",
        "OLL_TOTAL_TIMEOUT_MS",
        "OLL_MAX_TOKENS",
        "VERTEX_REQUEST_ATTEMPTS",
        "OLL_PLANNING_ATTEMPTS",
        "OLL_VERIFICATION_ATTEMPTS",
        "OLL_GENERATION_ATTEMPTS",
        "OLL_AUTHORING_STRATEGY",
        "OLL_DEBUG_GENERATION",
        "OCTOS_WORK_DIR",
        "OCTOS_SESSION_WORKSPACE"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turn_id": {
            "type": "string",
            "description": "Exact turn_id supplied by [[LEARNING_CONTEXT]]."
          },
          "learner_request": {
            "type": "string",
            "description": "The learner's complete substantive request for this turn."
          },
          "request_source": {
            "type": "string",
            "enum": ["self_contained", "current_image", "explicit_board_follow_up"],
            "description": "The single authoritative source resolved for this request. self_contained uses only learner_request; current_image requires source_observation; explicit_board_follow_up requires an explicit learner reference to prior board work and board_summary. If no source can be resolved safely, do not call the tool—ask the learner to clarify."
          },
          "language": {
            "type": "string",
            "description": "Lesson language, normally zh-CN."
          },
          "tutor_context": {
            "type": "string",
            "description": "Concise teaching-persona or strategy context known for this turn."
          },
          "learner_context": {
            "type": "string",
            "description": "Tentative learner background relevant to the requested explanation."
          },
          "session_context": {
            "type": "object",
            "description": "Controlled OLL resource context, including only assets and regions supplied by the host."
          },
          "board_summary": {
            "type": "string",
            "description": "Summary of the existing board. It is exposed to lesson generation only for explicit_board_follow_up and must never fill missing content in another request source."
          },
          "last_applied_action": {
            "type": "string",
            "description": "Last committed board action supplied by the host."
          },
          "base_revision": {
            "type": "integer",
            "minimum": 0,
            "description": "Existing board revision when supplied by the host."
          },
          "board_context": {
            "type": "object",
            "additionalProperties": false,
            "description": "Stable, read-only board references explicitly attached by the learner. Only valid for explicit_board_follow_up.",
            "properties": {
              "board_id": { "type": "string" },
              "revision": { "type": "integer", "minimum": 0 },
              "references": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "as": { "type": "string" },
                    "type": { "type": "string", "enum": ["node", "group", "connection"] },
                    "target_id": { "type": "string" },
                    "label": { "type": "string" },
                    "fragments": {
                      "type": "array",
                      "maxItems": 24,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "as": { "type": "string" },
                          "target_id": { "type": "string" }
                        },
                        "required": ["as", "target_id"]
                      }
                    }
                  },
                  "required": ["as", "type", "target_id", "fragments"]
                }
              }
            },
            "required": ["board_id", "revision", "references"]
          },
          "source_observation": {
            "type": "object",
            "additionalProperties": false,
            "description": "Authoritative problem transcribed from the current image after visual grounding. Omit when the request is not image-dependent.",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["live_camera", "uploaded_image"]
              },
              "recognized_problem": {
                "type": "string",
                "description": "Exact readable problem statement, givens, and learner target from the current image."
              },
              "confidence": {
                "type": "string",
                "enum": ["high", "medium"]
              }
            },
            "required": ["kind", "recognized_problem", "confidence"]
          }
        },
        "required": ["turn_id", "learner_request", "request_source"]
      }
    },
    {
      "name": "oll_classify_selection",
      "description": "Classify only the immutable student-ink selection as text, math, geometry, data, or unknown. Never create tools, execute an enhancement, or modify the source ink.",
      "concurrency_class": "exclusive",
      "env": [
        "VERTEX_SA_JSON",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "VERTEX_BASE_URL",
        "OLL_MODEL",
        "OLL_TIMEOUT_MS",
        "OLL_TOTAL_TIMEOUT_MS",
        "VERTEX_REQUEST_ATTEMPTS",
        "OLL_SELECTION_CLASSIFICATION_THINKING_LEVEL",
        "OCTOS_WORK_DIR",
        "OCTOS_SESSION_WORKSPACE"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turn_id": { "type": "string" },
          "source": { "type": "object" },
          "board": { "type": "object" },
          "selection_media": {
            "type": "string",
            "description": "Workspace-local image path injected by the trusted skill action binding."
          }
        },
        "required": ["turn_id", "source", "board", "selection_media"]
      }
    },
    {
      "name": "oll_enhance_selection",
      "description": "Create a separate explanation, annotation, or safe 2D function plot beside an immutable student-ink selection. Use only when [[LEARNING_SELECTION]] requires this exact tool. Copy the source identity fields exactly, describe only the selected image, and never rewrite or replace the source ink.",
      "concurrency_class": "exclusive",
      "env": [
        "VERTEX_SA_JSON",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "VERTEX_BASE_URL",
        "OLL_MODEL",
        "OLL_TIMEOUT_MS",
        "OLL_TOTAL_TIMEOUT_MS",
        "OLL_MAX_TOKENS",
        "VERTEX_REQUEST_ATTEMPTS",
        "OCTOS_WORK_DIR",
        "OCTOS_SESSION_WORKSPACE"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turn_id": { "type": "string" },
          "learner_request": { "type": "string" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": { "type": "string" },
              "document_id": { "type": "string" },
              "document_version": { "type": "integer", "minimum": 0 },
              "bounds": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "width": { "type": "number", "minimum": 0 },
                  "height": { "type": "number", "minimum": 0 }
                },
                "required": ["x", "y", "width", "height"]
              },
              "checksum": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "algorithm": { "type": "string", "enum": ["sha-256"] },
                  "value": { "type": "string" }
                },
                "required": ["algorithm", "value"]
              }
            },
            "required": [
              "source_id",
              "document_id",
              "document_version",
              "bounds",
              "checksum"
            ]
          },
          "content_hint": {
            "type": "string",
            "enum": ["text", "math", "geometry", "data", "unknown"]
          },
          "tool_id": {
            "type": "string",
            "enum": ["explain", "check-and-suggest", "generate-plot", "custom-question"]
          },
          "board": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "board_id": { "type": "string" },
              "revision": { "type": "integer", "minimum": 0 },
              "targets": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "target_id": { "type": "string" },
                    "node_id": { "type": "string" },
                    "element_id": { "type": "string" },
                    "kind": { "type": "string" },
                    "label": { "type": "string" },
                    "value_json": {
                      "type": "string",
                      "description": "Optional compact JSON value supplied by the Runtime for the exact target."
                    },
                    "world_bounds": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "x": { "type": "number" },
                        "y": { "type": "number" },
                        "width": { "type": "number", "minimum": 0 },
                        "height": { "type": "number", "minimum": 0 }
                      },
                      "required": ["x", "y", "width", "height"]
                    },
                    "overlap": { "type": "number", "minimum": 0, "maximum": 1 },
                    "distance": { "type": "number", "minimum": 0 },
                    "z_index": { "type": "integer" }
                  },
                  "required": [
                    "target_id",
                    "node_id",
                    "kind",
                    "world_bounds",
                    "overlap",
                    "distance",
                    "z_index"
                  ]
                }
              }
            },
            "required": ["board_id", "revision", "targets"]
          },
          "recognized_content": {
            "type": "string",
            "description": "Only what is visible in the selected image; do not use the rest of the board. State uncertainty in recognition_confidence."
          },
          "recognition_confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "lesson_title": { "type": "string" },
          "board_summary": { "type": "string" },
          "selection_media": {
            "type": "string",
            "description": "Workspace-local image path injected by the trusted skill action binding."
          }
        },
        "required": [
          "turn_id",
          "learner_request",
          "source",
          "content_hint",
          "tool_id",
          "board"
        ]
      }
    }
  ],
  "actions": [
    {
      "id": "learning.selection.classify",
      "label": "识别白板选区",
      "description": "把学生选中的原始笔迹分类为文字、数学表达式、几何草图、数据或无法确定。",
      "tags": ["learning", "selection", "classification"],
      "surfaces": ["learning.selection"],
      "execution": "sync",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string" }
          },
          "turn_id": { "type": "string" },
          "source": { "type": "object" },
          "board": { "type": "object" }
        },
        "required": ["paths", "turn_id", "source", "board"]
      },
      "binding": {
        "type": "tool",
        "tool": "oll_classify_selection",
        "input_mode": "file_each",
        "file_argument": "selection_media",
        "file_materialization": "workspace_relative"
      }
    },
    {
      "id": "learning.selection.enhance",
      "label": "解释白板选区",
      "description": "根据学生保留不变的笔迹选区生成旁侧解释或函数图。",
      "tags": ["learning", "selection"],
      "surfaces": ["learning.selection"],
      "execution": "sync",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string" }
          },
          "turn_id": { "type": "string" },
          "learner_request": { "type": "string" },
          "source": { "type": "object" },
          "content_hint": {
            "type": "string",
            "enum": ["text", "math", "geometry", "data", "unknown"]
          },
          "tool_id": {
            "type": "string",
            "enum": ["explain", "check-and-suggest", "generate-plot", "custom-question"]
          },
          "board": { "type": "object" },
          "lesson_title": { "type": "string" },
          "board_summary": { "type": "string" }
        },
        "required": [
          "paths",
          "turn_id",
          "learner_request",
          "source",
          "content_hint",
          "tool_id",
          "board"
        ]
      },
      "binding": {
        "type": "tool",
        "tool": "oll_enhance_selection",
        "input_mode": "file_each",
        "file_argument": "selection_media",
        "file_materialization": "workspace_relative"
      }
    }
  ]
}
