{
  "name": "learning-coach",
  "version": "0.14.0",
  "author": "alan0x",
  "description": "Generate validated OLL whiteboard lessons for learning sessions",
  "timeout_secs": 300,
  "requires_network": true,
  "tools": [
    {
      "name": "oll_generate_lesson",
      "description": "Generate, validate, save, and deliver one complete OLL lesson from a standalone learner request, optionally grounded in one current camera frame supplied by the dedicated camera action. Existing-board selection assistance is handled by separate selection tools. This tool performs its own generation and repair attempts; call it at most once per learner turn.",
      "concurrency_class": "exclusive",
      "env": [
        "OLL_PROVIDER",
        "OLL_FALLBACK_PROVIDER",
        "OLL_HEDGE_DELAY_MS",
        "VERTEX_SA_JSON",
        "VERTEX_ACCESS_TOKEN",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "VERTEX_BASE_URL",
        "GEMINI_API_KEY",
        "GEMINI_BASE_URL",
        "ARK_API_KEY",
        "ARK_BASE_URL",
        "ARK_THINKING_TYPE",
        "OLL_MODEL",
        "OLL_TIMEOUT_MS",
        "OLL_TOTAL_TIMEOUT_MS",
        "OLL_MAX_TOKENS",
        "OLL_MODEL_REQUEST_ATTEMPTS",
        "OLL_THINKING_LEVEL",
        "VERTEX_REQUEST_ATTEMPTS",
        "OLL_DEBUG_GENERATION",
        "OCTOS_WORK_DIR",
        "OCTOS_SESSION_WORKSPACE"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turn_id": {
            "type": "string",
            "description": "Exact turn_id supplied by [[LEARNING_CONTEXT]]."
          },
          "learner_request": {
            "type": "string",
            "description": "The learner's complete substantive request for this turn."
          },
          "request_source": {
            "type": "string",
            "enum": ["self_contained", "current_image"],
            "description": "Whether the lesson uses only the request or also one current camera frame."
          },
          "language": {
            "type": "string",
            "description": "Lesson language, normally zh-CN."
          },
          "tutor_context": {
            "type": "string",
            "description": "Concise teaching-persona or strategy context known for this turn."
          },
          "learner_context": {
            "type": "string",
            "description": "Tentative learner background relevant to the requested explanation."
          },
          "input_modality": {
            "type": "string",
            "enum": ["text", "voice"],
            "description": "How this standalone request entered /learn. Voice requests may need clarification before a course is generated."
          },
          "camera_media": {
            "type": "string",
            "description": "Workspace-relative image path materialized by the camera action."
          },
          "client_timing": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional client-side timestamps and upload sizes used only for latency diagnostics.",
            "properties": {
              "submitted_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "camera_capture_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "camera_capture_completed_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "audio_upload_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "audio_upload_completed_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "media_upload_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "media_upload_completed_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "voice_admission_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "voice_admission_completed_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "skill_invocation_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "camera_media_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "required": ["turn_id", "learner_request", "request_source"]
      }
    },
    {
      "name": "oll_classify_selection",
      "description": "Classify only the immutable student-ink selection as text, math, geometry, data, or unknown. Never create tools, execute an enhancement, or modify the source ink.",
      "concurrency_class": "exclusive",
      "env": [
        "OLL_PROVIDER",
        "VERTEX_SA_JSON",
        "VERTEX_ACCESS_TOKEN",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "VERTEX_BASE_URL",
        "GEMINI_API_KEY",
        "GEMINI_BASE_URL",
        "ARK_API_KEY",
        "ARK_BASE_URL",
        "ARK_THINKING_TYPE",
        "OLL_MODEL",
        "OLL_TIMEOUT_MS",
        "OLL_TOTAL_TIMEOUT_MS",
        "OLL_MODEL_REQUEST_ATTEMPTS",
        "OLL_THINKING_LEVEL",
        "VERTEX_REQUEST_ATTEMPTS",
        "OLL_SELECTION_CLASSIFICATION_THINKING_LEVEL",
        "OCTOS_WORK_DIR",
        "OCTOS_SESSION_WORKSPACE"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turn_id": { "type": "string" },
          "source": { "type": "object" },
          "board": { "type": "object" },
          "selection_media": {
            "type": "string",
            "description": "Workspace-local image path injected by the trusted skill action binding."
          }
        },
        "required": ["turn_id", "source", "board", "selection_media"]
      }
    },
    {
      "name": "oll_enhance_selection",
      "description": "Create a separate explanation or validated 2D/3D function visualization beside an immutable student-ink selection. Return an explicit unsupported result when the selected expression cannot be rendered safely. Use only when [[LEARNING_SELECTION]] requires this exact tool. Copy the source identity fields exactly, describe only the selected image, and never rewrite or replace the source ink.",
      "concurrency_class": "exclusive",
      "env": [
        "OLL_PROVIDER",
        "VERTEX_SA_JSON",
        "VERTEX_ACCESS_TOKEN",
        "GOOGLE_CLOUD_PROJECT",
        "GOOGLE_CLOUD_LOCATION",
        "VERTEX_BASE_URL",
        "GEMINI_API_KEY",
        "GEMINI_BASE_URL",
        "ARK_API_KEY",
        "ARK_BASE_URL",
        "ARK_THINKING_TYPE",
        "OLL_MODEL",
        "OLL_TIMEOUT_MS",
        "OLL_TOTAL_TIMEOUT_MS",
        "OLL_MAX_TOKENS",
        "OLL_MODEL_REQUEST_ATTEMPTS",
        "OLL_THINKING_LEVEL",
        "VERTEX_REQUEST_ATTEMPTS",
        "OCTOS_WORK_DIR",
        "OCTOS_SESSION_WORKSPACE"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turn_id": { "type": "string" },
          "learner_request": { "type": "string" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": { "type": "string" },
              "document_id": { "type": "string" },
              "document_version": { "type": "integer", "minimum": 0 },
              "bounds": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "width": { "type": "number", "minimum": 0 },
                  "height": { "type": "number", "minimum": 0 }
                },
                "required": ["x", "y", "width", "height"]
              },
              "checksum": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "algorithm": { "type": "string", "enum": ["sha-256"] },
                  "value": { "type": "string" }
                },
                "required": ["algorithm", "value"]
              }
            },
            "required": [
              "source_id",
              "document_id",
              "document_version",
              "bounds",
              "checksum"
            ]
          },
          "content_hint": {
            "type": "string",
            "enum": ["text", "math", "geometry", "data", "unknown"]
          },
          "tool_id": {
            "type": "string",
            "enum": ["explain", "check-and-suggest", "generate-plot", "custom-question"]
          },
          "board": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "board_id": { "type": "string" },
              "revision": { "type": "integer", "minimum": 0 },
              "targets": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "target_id": { "type": "string" },
                    "node_id": { "type": "string" },
                    "element_id": { "type": "string" },
                    "kind": { "type": "string" },
                    "label": { "type": "string" },
                    "value_json": {
                      "type": "string",
                      "description": "Optional compact JSON value supplied by the Runtime for the exact target."
                    },
                    "world_bounds": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "x": { "type": "number" },
                        "y": { "type": "number" },
                        "width": { "type": "number", "minimum": 0 },
                        "height": { "type": "number", "minimum": 0 }
                      },
                      "required": ["x", "y", "width", "height"]
                    },
                    "overlap": { "type": "number", "minimum": 0, "maximum": 1 },
                    "distance": { "type": "number", "minimum": 0 },
                    "z_index": { "type": "integer" }
                  },
                  "required": [
                    "target_id",
                    "node_id",
                    "kind",
                    "world_bounds",
                    "overlap",
                    "distance",
                    "z_index"
                  ]
                }
              }
            },
            "required": ["board_id", "revision", "targets"]
          },
          "recognized_content": {
            "type": "string",
            "description": "Only what is visible in the selected image; do not use the rest of the board. State uncertainty in recognition_confidence."
          },
          "recognition_confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "lesson_title": { "type": "string" },
          "board_summary": { "type": "string" },
          "selection_media": {
            "type": "string",
            "description": "Workspace-local image path injected by the trusted skill action binding."
          }
        },
        "required": [
          "turn_id",
          "learner_request",
          "source",
          "content_hint",
          "tool_id",
          "board"
        ]
      }
    }
  ],
  "actions": [
    {
      "id": "learning.lesson.generate",
      "label": "生成白板课程",
      "description": "把 /learn 底部输入的完整学习问题直接交给课程生成器，不经过通用对话模型的工具选择。",
      "tags": ["learning", "lesson", "generation"],
      "surfaces": ["learning.composer"],
      "execution": "background",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turn_id": { "type": "string" },
          "learner_request": { "type": "string" },
          "request_source": {
            "type": "string",
            "enum": ["self_contained"]
          },
          "language": { "type": "string" },
          "input_modality": {
            "type": "string",
            "enum": ["text", "voice"]
          },
          "client_timing": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "submitted_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "camera_capture_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "camera_capture_completed_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "audio_upload_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "audio_upload_completed_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "media_upload_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "media_upload_completed_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "voice_admission_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "voice_admission_completed_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "skill_invocation_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "camera_media_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "required": ["turn_id", "learner_request", "request_source"]
      },
      "binding": {
        "type": "tool",
        "tool": "oll_generate_lesson",
        "input_mode": "single"
      }
    },
    {
      "id": "learning.lesson.generate-from-camera",
      "label": "根据摄像头画面生成白板课程",
      "description": "把 /learn 当前提交的文字或语音与一张即时摄像头画面直接交给课程生成器，不经过通用对话模型的工具选择。",
      "tags": ["learning", "lesson", "generation", "camera"],
      "surfaces": ["learning.composer"],
      "execution": "background",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string" }
          },
          "turn_id": { "type": "string" },
          "learner_request": { "type": "string" },
          "request_source": {
            "type": "string",
            "enum": ["current_image"]
          },
          "language": { "type": "string" },
          "input_modality": {
            "type": "string",
            "enum": ["text", "voice"]
          },
          "client_timing": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "submitted_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "camera_capture_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "camera_capture_completed_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "audio_upload_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "audio_upload_completed_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "media_upload_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "media_upload_completed_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "voice_admission_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "voice_admission_completed_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "skill_invocation_started_at_epoch_ms": { "type": "integer", "minimum": 0 },
              "camera_media_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "required": ["paths", "turn_id", "learner_request", "request_source"]
      },
      "binding": {
        "type": "tool",
        "tool": "oll_generate_lesson",
        "input_mode": "file_each",
        "file_argument": "camera_media",
        "file_materialization": "workspace_relative"
      }
    },
    {
      "id": "learning.selection.classify",
      "label": "识别白板选区",
      "description": "把学生选中的原始笔迹分类为文字、数学表达式、几何草图、数据或无法确定。",
      "tags": ["learning", "selection", "classification"],
      "surfaces": ["learning.selection"],
      "execution": "sync",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string" }
          },
          "turn_id": { "type": "string" },
          "source": { "type": "object" },
          "board": { "type": "object" }
        },
        "required": ["paths", "turn_id", "source", "board"]
      },
      "binding": {
        "type": "tool",
        "tool": "oll_classify_selection",
        "input_mode": "file_each",
        "file_argument": "selection_media",
        "file_materialization": "workspace_relative"
      }
    },
    {
      "id": "learning.selection.enhance",
      "label": "解释白板选区",
      "description": "根据学生保留不变的笔迹选区生成旁侧解释、二维函数图或三维函数图；无法安全绘制时返回明确原因。",
      "tags": ["learning", "selection"],
      "surfaces": ["learning.selection"],
      "execution": "sync",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string" }
          },
          "turn_id": { "type": "string" },
          "learner_request": { "type": "string" },
          "source": { "type": "object" },
          "content_hint": {
            "type": "string",
            "enum": ["text", "math", "geometry", "data", "unknown"]
          },
          "tool_id": {
            "type": "string",
            "enum": ["explain", "check-and-suggest", "generate-plot", "custom-question"]
          },
          "board": { "type": "object" },
          "recognized_content": { "type": "string" },
          "recognition_confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "lesson_title": { "type": "string" },
          "board_summary": { "type": "string" }
        },
        "required": [
          "paths",
          "turn_id",
          "learner_request",
          "source",
          "content_hint",
          "tool_id",
          "board"
        ]
      },
      "binding": {
        "type": "tool",
        "tool": "oll_enhance_selection",
        "input_mode": "file_each",
        "file_argument": "selection_media",
        "file_materialization": "workspace_relative"
      }
    }
  ]
}
