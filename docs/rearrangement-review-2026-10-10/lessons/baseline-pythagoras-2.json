              {
                "do": "write",
                "as": "section-02-moment-02-item-01",
                "kind": "math",
                "role": "derivation",
                "content": {
                  "latex": "c = \\sqrt{3^2 + 4^2} = \\sqrt{9 + 16} = 5"
                },
                "place": {
