                "content": {
                  "title": "数值验证：以 a=3, b=2 为例",
                  "items": [
                    "总边长：a + b = 3 + 2 = 5",
                    "总面积：5² = 25",
                    "拆分面积：3² + 2×(3×2) + 2² = 9 + 12 + 4 = 25"
                  ]
                },
                "place": {
                  "relation": "below",
                  "anchor": "section-01-moment-01-item-01"
                },
                "when": "after_speech"
              }
            ]
          },
          {
            "key": "moment-02",
            "say": "设 a 等于 3，b 等于 2。整体看，这是一个边长为 5 的大正方形，面积是 5 的平方，即 25。而拆开看，它由一个 3 乘 3 的正方形、两个 3 乘 2 的长方形，以及一个 2 乘 2 的正方形组成。",
            "delivery": "careful",
            "actions": [
              {
                "do": "write",
                "as": "section-02-moment-02-item-01",
                "kind": "math",
                "role": "derivation",
                "content": {
                  "latex": "(3 + 2)^2 = 3^2 + 2 \\times (3 \\times 2) + 2^2 = 9 + 12 + 4 = 25"
                },
                "place": {
                  "relation": "below",
                  "anchor": "section-02-moment-01-item-01"
                },
                "when": "after_speech"
              },
              {
                "do": "point",
                "target": "section-01-moment-01-item-01",
                "when": "during_speech"
              }
            ]
          },
